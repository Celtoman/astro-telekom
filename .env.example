DATABASE_URL=postgresql://provider:provider@localhost:5432/provider_platform
REDIS_URL=redis://localhost:6379
TRUST_PROXY=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_PUBLIC_WRITE_MAX=10
RATE_LIMIT_DEFAULT_MAX=300
PII_RETENTION_DAYS=
PII_RETENTION_BATCH_SIZE=500
PII_RETENTION_CRON=0 3 * * *
# Localhost разрешен только для pnpm dev:web и сборки с явным ALLOW_DEMO_DATA=true; production требует https://PUBLIC_DOMAIN.
PUBLIC_SITE_URL=http://localhost:4321
PUBLIC_SITE_SLUG=domru-kazan
API_URL=http://localhost:3000
# Server-only source of the public catalog during Astro build; production Docker builds require a builder-reachable URL.
# Falls back to PUBLIC_API_URL when omitted outside the official production Compose wiring.
SITE_DATA_API_URL=http://localhost:3000/api/v1
# Browser endpoint embedded into the public address/lead form; production requires HTTPS and exact /api/v1 path.
PUBLIC_API_URL=http://localhost:3000/api/v1
PUBLIC_PROVIDER_ID=
PUBLIC_SITE_ID=
PUBLIC_YANDEX_METRIKA_ID=
PUBLIC_SUPPORT_PHONE=8 (800) 000-00-00
ADMIN_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:4321,http://localhost:3001
# Required for a production lead flow; /api/v1/admin/readiness stays blocked while values are missing.
REBUILD_PROVIDER=webhook
REBUILD_WEBHOOK_URL=
# Required instead of REBUILD_WEBHOOK_URL when REBUILD_PROVIDER=coolify.
COOLIFY_API_URL=
COOLIFY_API_TOKEN=
COOLIFY_RESOURCE_UUID=
COOLIFY_POLL_INTERVAL_MS=5000
COOLIFY_DEPLOY_TIMEOUT_MS=900000
DOMRU_COVERAGE_API_URL=
DOMRU_COVERAGE_API_KEY=
DOMRU_CONTRACT_API_URL=
DOMRU_CONTRACT_API_KEY=
MAIL_FROM=no-reply@example.com
LEADS_EMAIL=leads@example.com
LEADS_EMAIL_WEBHOOK_URL=
ALTERNATIVES_PARTNER_URL=https://tarifnik.ru/
RESEND_API_KEY=
LEADS_EMAIL_FROM=leads@example.com
TARIFNIK_API_URL=https://dealers-api.tarifnik.ru/api/v3.0/appeal/create
TARIFNIK_API_KEY=
SUBSCRIBER_COOKIE_SECRET=replace-with-a-long-random-token
ADMIN_API_TOKEN=replace-with-a-long-random-token
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-password
POSTGRES_DB=provider_platform
POSTGRES_USER=provider
POSTGRES_PASSWORD=replace-with-a-strong-password
PUBLIC_DOMAIN=example.com
ADMIN_DOMAIN=admin.example.com
API_DOMAIN=api.example.com
# Coolify bootstrap: true только для первого seed, затем обязательно false.
RUN_BOOTSTRAP_SEED=false
# Coolify Compose Basic Auth в формате username:bcrypt-hash; Literal + Buildtime + Runtime, label escaping выключен.
# Здесь оставлять пустым: открытый пароль и готовый verifier не коммитить.
TEST_BASIC_AUTH_USERS=
