:80 {
	encode gzip zstd
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
	@assets path *.css *.js *.woff2 *.webp *.avif *.svg
	header @assets Cache-Control "public, max-age=31536000, immutable"

	handle /api/* {
		reverse_proxy {$API_UPSTREAM:api:3000}
	}

	handle {
		root * /publication/current
		import /publication/current/redirects.caddy
		try_files {path} {path}/index.html /404.html
		file_server
	}
}
