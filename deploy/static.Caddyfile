{
	servers {
		trusted_proxies static private_ranges
		trusted_proxies_strict
	}
}

:80 {
	encode gzip zstd
	header {
		>Strict-Transport-Security "max-age=31536000"
		>X-Content-Type-Options "nosniff"
		>Referrer-Policy "strict-origin-when-cross-origin"
		>Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), usb=()"
		>Content-Security-Policy "frame-ancestors 'none';"
		>X-Frame-Options "DENY"
		>X-Robots-Tag "noindex, nofollow, noarchive"
	}
	@assets path *.css *.js *.woff2 *.webp *.avif *.svg
	header @assets Cache-Control "public, max-age=31536000, immutable"
	header /workspace-version.json Cache-Control "no-store"

	handle /api/* {
		reverse_proxy {$API_UPSTREAM:api:3000} {
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle {
		root * /srv
		route {
			@html_trailing_slash {
				path_regexp html_trailing_slash ^(/[^.]+)/$
				not path /api/* /_astro/* /assets/*
			}
			redir @html_trailing_slash {re.html_trailing_slash.1}{?query} 301
			try_files {path}/index.html {path} =404
			file_server
		}
	}

	handle_errors 404 {
		@html_not_found not path /api/* /_astro/* /assets/*
		handle @html_not_found {
			rewrite * /404.html
			file_server
		}
		respond "Not Found" 404
	}
}
