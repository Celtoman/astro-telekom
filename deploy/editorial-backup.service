[Unit]
Description=Astro editorial PostgreSQL/media backup and isolated restore verification
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
UMask=0077
EnvironmentFile=/etc/astro-editorial-backup.env
ExecStart=/usr/bin/python3 /opt/astro-telekom-retention/editorial-backup.py --api-origin ${ASTRO_EDITORIAL_API_ORIGIN}
Nice=19
IOSchedulingClass=idle
TimeoutStartSec=30min
TimeoutStopSec=120
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/data/coolify/backups/publication-retention /var/lib/astro-editorial-backup /run
