{
  "name": "provider-platform",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "devDependencies": {
    "@prisma/client": "7.10.0",
    "prisma": "7.10.0"
  },
  "scripts": {
    "dev:web": "pnpm --filter @provider/web dev",
    "dev:api": "pnpm --filter @provider/api dev",
    "dev:worker": "pnpm --filter @provider/worker start",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "db:generate": "pnpm --filter @provider/database generate",
    "db:validate": "pnpm --filter @provider/database validate"
  }
}
