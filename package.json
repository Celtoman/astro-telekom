{
  "name": "provider-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "devDependencies": {
    "@prisma/client": "7.10.0",
    "cross-env": "^10.1.0",
    "prisma": "7.10.0"
  },
  "scripts": {
    "dev:web": "pnpm --filter @provider/web dev",
    "dev:api": "pnpm --filter @provider/api dev",
    "dev:worker": "pnpm --filter @provider/worker start",
    "build": "pnpm -r build",
    "build:ci": "cross-env ALLOW_DEMO_DATA=true pnpm build",
    "lint": "pnpm -r lint",
    "db:generate": "pnpm --filter @provider/database generate",
    "db:validate": "pnpm --filter @provider/database validate",
    "test": "node --test tests/*.test.cjs tests/*.test.mjs",
    "test:build": "pnpm --filter @provider/api run build && pnpm test",
    "check": "pnpm lint && pnpm db:validate && pnpm run build:ci && pnpm test"
  }
}
