---
import { createHash } from 'node:crypto';
import '../styles/public-fonts.css';
import geistLatin from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import geistCyrillic from '@fontsource-variable/geist/files/geist-cyrillic-wght-normal.woff2?url';
import { publicShellBootstrap, prepareHeaderScript, prepareFooterScript } from '../lib/public-shell-state.mjs';
import { collectionBootstrap, prepareCollectionScript } from '../lib/tariff-collection-prepaint.mjs';
import type { CityView, PageView, SiteView } from '../data/site';
import { defaultSiteImagePath, loadSiteData } from '../data/site';
import { publicAsset } from '../data/public-asset';
import GeneralHomeHeader from '../components/general-home/GeneralHomeHeader.astro';
import GeneralHomeFooter from '../components/general-home/GeneralHomeFooter.astro';
import CallbackDialog from '../components/CallbackDialog.astro';
import LegalDocuments from '../components/LegalDocuments.astro';
import '../styles/public-ui.css';
import { normalizePublicHtmlPath } from '../data/public-url';

interface Props {
  title: string;
  description: string;
  city?: CityView;
  site: SiteView;
  pages?: PageView[];
  indexable?: boolean;
  structuredData?: Record<string, unknown>;
  ogType?: "website" | "article";
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogImageAlt?: string;
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  firstScreenImage?: unknown;
  imageOrigins?: string[];
  homeShell?: { cities: CityView[]; addressDialogId: string | null };
}

const { title, description, city, site, indexable = true, ogTitle = title, ogDescription = description, ogImage = defaultSiteImagePath } = Astro.props as Props;
const homeShell = (Astro.props as Props).homeShell;
const catalog = await loadSiteData();
const currentRoute = catalog.routes.find(route => route.path === normalizePublicHtmlPath(Astro.url.pathname));
const addressPageSlug = catalog.routes.some(route => route.kind === 'CITY_ADDRESS_CHECK') ? 'proverka-podklyucheniya-k-domru-po-adresu' : undefined;
const citySwitchPath = currentRoute?.kind === 'CITY_ADDRESS_CHECK' ? addressPageSlug : currentRoute?.kind === 'CITY_SUPPORT' ? 'tehpodderzhka' : undefined;
const supportPageSlug = catalog.routes.some(route => route.kind === 'CITY_SUPPORT') ? 'tehpodderzhka' : undefined;
const cityComposition = city?.pages.find(page => page.type === 'HOME' && page.slug === '')?.content?.homeCompositionVersion;
const localSections = homeShell ? ['faq', 'movix', 'address-check']
  : currentRoute?.kind === 'CITY_HOME' ? ['tariffs', 'address-check', ...(cityComposition === '3.0.0' ? ['comparison', 'faq', 'movix', 'contacts'] : [])]
    : currentRoute?.kind === 'CITY_TARIFF_DETAIL' ? ['faq'] : [];
const imageOrigins = new Set<string>((Astro.props as Props).imageOrigins ?? []);
if (typeof Astro.props.firstScreenImage === 'string' && /^https:\/\//i.test(Astro.props.firstScreenImage)) imageOrigins.add(new URL(Astro.props.firstScreenImage).origin);
for (const origin of imageOrigins) {
  const url = new URL(origin);
  if (url.protocol !== 'https:' || url.origin !== origin || url.username || url.password) throw new Error('Некорректный origin изображения.');
}
if (imageOrigins.size) Astro.csp.insertDirective(`img-src ${[...imageOrigins].sort().join(' ')}`);
const metrikaId = String(import.meta.env.PUBLIC_YANDEX_METRIKA_ID || '').match(/^\d+$/)?.[0];
const canonicalUrl = new URL(normalizePublicHtmlPath(Astro.url.pathname), Astro.site);
const socialImageUrl = new URL(publicAsset(ogImage), Astro.site);
const jsonLd = JSON.stringify(Astro.props.structuredData ?? {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  url: canonicalUrl.href,
  inLanguage: 'ru-RU',
}).replace(/</g, '\\u003c');
const metrikaBootstrap = metrikaId
  ? `window.__YANDEX_METRIKA_ID__=${metrikaId};(function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};m[i].l=1*new Date();k=e.createElement(t);a=e.getElementsByTagName(t)[0];k.async=1;k.src=r;a.parentNode.insertBefore(k,a)})(window,document,'script','https://mc.yandex.ru/metrika/tag.js','ym');ym(${metrikaId},'init',{clickmap:true,trackLinks:true,accurateTrackBounce:true,webvisor:true});`
  : undefined;
const scriptHash = (source: string) => `sha256-${createHash('sha256').update(source).digest('base64')}` as const;
const shellBootstrap = publicShellBootstrap(catalog.cities, site.slug);
for (const source of [shellBootstrap, prepareHeaderScript, prepareFooterScript, collectionBootstrap, prepareCollectionScript]) Astro.csp.insertScriptHash(scriptHash(source));
Astro.csp.insertScriptHash(scriptHash(jsonLd));
if (metrikaBootstrap) Astro.csp.insertScriptHash(scriptHash(metrikaBootstrap));
---

<!doctype html>
<html lang="ru" class="full-general-home">
  <head>
    <meta charset="UTF-8" />
    <link rel="preload" href={geistLatin} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={geistCyrillic} as="font" type="font/woff2" crossorigin="anonymous" />
    <script is:inline set:html={shellBootstrap}></script>
    <script is:inline set:html={collectionBootstrap}></script>
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/vnd.microsoft.icon" sizes="16x16 32x32 48x48" href={publicAsset('/favicon.ico')} />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="apple-touch-icon" type="image/png" sizes="180x180" href={publicAsset('/apple-touch-icon.png')} />
    <link rel="manifest" href="/site.webmanifest" crossorigin="use-credentials" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content={Astro.props.ogType ?? "website"} />
    <meta property="og:locale" content="ru_RU" />
    {Astro.props.ogImageWidth && <meta property="og:image:width" content={Astro.props.ogImageWidth} />}
    {Astro.props.ogImageHeight && <meta property="og:image:height" content={Astro.props.ogImageHeight} />}
    {Astro.props.ogImageAlt !== undefined && <meta property="og:image:alt" content={Astro.props.ogImageAlt} />}
    {Astro.props.articlePublishedTime && <meta property="article:published_time" content={Astro.props.articlePublishedTime} />}
    {Astro.props.articleModifiedTime && <meta property="article:modified_time" content={Astro.props.articleModifiedTime} />}
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:image" content={socialImageUrl.href} />
    {indexable ? <link rel="canonical" href={canonicalUrl} /> : <meta name="robots" content="noindex, follow" />}
    {indexable && <script is:inline type="application/ld+json" set:html={jsonLd}></script>}
    {metrikaBootstrap && <script is:inline set:html={metrikaBootstrap}></script>}
  </head>
  <body class:list={["general-home-page", { "city-home-page": currentRoute?.kind === "CITY_HOME" && cityComposition === "3.0.0" }]}>
    <GeneralHomeHeader {site} {city} cities={catalog.cities} {localSections} {addressPageSlug} {supportPageSlug} {citySwitchPath} addressDialogId={homeShell?.addressDialogId} />
    <main>
      <slot />
    </main>
    <GeneralHomeFooter {site} {city} cities={catalog.cities} {localSections} {addressPageSlug} {supportPageSlug} footerRoutes={catalog.routes} />
    <CallbackDialog {site} {city} requireConfirmedCity={!city} />
    <LegalDocuments />
    <script>
      import { SUBSCRIBER_MODE_EVENT } from '../lib/subscriber-mode.mjs';
      import { applySubscriberPhone } from '../lib/public-shell-state.mjs';
      import { recordSessionPage } from '../lib/session-attribution.mjs';

      type MetrikaWindow = Window & {
        __YANDEX_METRIKA_ID__?: number;
        ym?: (...args: unknown[]) => void;
      };
      const metrikaWindow = window as MetrikaWindow;
      try { recordSessionPage(sessionStorage, location.href, document.referrer); } catch { /* Storage may be unavailable. */ }
      window.addEventListener(SUBSCRIBER_MODE_EVENT, () => applySubscriberPhone(document));
      document.addEventListener('click', (event) => {
        const target = event.target instanceof Element ? event.target.closest('a[href^="tel:"]') : null;
        if (target && typeof metrikaWindow.ym === 'function') metrikaWindow.ym(metrikaWindow.__YANDEX_METRIKA_ID__, 'reachGoal', 'phone_click');
      });
      document.addEventListener('submit', () => {
        if (typeof metrikaWindow.ym === 'function') metrikaWindow.ym(metrikaWindow.__YANDEX_METRIKA_ID__, 'reachGoal', 'lead_form_submit');
      });
    </script>
  </body>
</html>

<style is:global>
  :root { font-family: 'Geist Variable', ui-sans-serif, system-ui, sans-serif; color: #18202a; background: #f6f7f9; font-synthesis: none; }
  :root.full-general-home { background: #fff; }
  .general-home-page { background: #fff; padding: 0 0 24px; }
  html[data-public-shell-pending] [data-site-header] { visibility: hidden; }
  html[data-public-shell-fonts-pending] :is([data-site-header], [data-general-home-footer]) { visibility: hidden; }
  html[data-public-shell-fonts-enabled] :is([data-site-header], [data-general-home-footer]) { font-family: 'Geist Shell', ui-sans-serif, system-ui, sans-serif; }
  html[data-public-shell-fonts-fallback] :is([data-site-header], [data-general-home-footer]) { font-family: ui-sans-serif, system-ui, sans-serif; }
  .general-home-page > main { padding: 24px 0; }
  * { box-sizing: border-box; }
  body { margin: 0; }
  a { color: inherit; }
  .container { width: min(1200px, calc(100% - 32px)); margin: 0 auto; }
  .footer-inner { min-height: 72px; display: flex; align-items: center; gap: 24px; }
  .footer-inner { flex-wrap: wrap; }
  .footer-inner span { margin-right: auto; }
  .footer-inner a { text-decoration: none; }
  .footer-inner a:hover { text-decoration: underline; }
  .phone { font-weight: 700; text-decoration: none; white-space: nowrap; }
  .hero { padding: 72px 0 56px; background: linear-gradient(135deg, #e8f4ff, #f6f7f9); }
  .eyebrow { color: #1769aa; font-weight: 700; }
  h1 { overflow-wrap: anywhere; font-size: clamp(36px, 6vw, 64px); line-height: 1.02; max-width: 780px; margin: 16px 0; letter-spacing: -0.04em; }
  h2 { font-size: 32px; margin: 0 0 24px; letter-spacing: -0.03em; }
  .lead { font-size: 20px; line-height: 1.5; max-width: 680px; color: #526071; }
  .section { padding: 56px 0; }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .card { background: #fff; border: 1px solid #e3e8ef; border-radius: 18px; padding: 24px; box-shadow: 0 8px 24px rgb(21 40 66 / 5%); }
  .card h3 { margin: 0 0 10px; font-size: 20px; }
  .card p { color: #526071; line-height: 1.5; }
  .card-link { display: inline-block; margin-top: 12px; color: #1769aa; font-weight: 700; text-decoration: none; }
  .tariff-price { font-size: 24px; font-weight: 800; margin-top: 20px; }
  .tariff-connection { margin: 8px 0 0; color: #334155; font-weight: 650; }
  .button { display: inline-flex; min-height: 48px; align-items: center; justify-content: center; background: #c91f5c; color: #fff; border-radius: 14px; padding: 12px 22px; text-decoration: none; font-weight: 800; }
  .button:hover { background: #ad174d; }
  a:focus-visible, button:focus-visible, input:focus-visible, summary:focus-visible { outline: 3px solid #1769aa; outline-offset: 3px; }
  .site-footer { background: #18202a; color: #fff; }
  @media (max-width: 800px) { .grid { grid-template-columns: 1fr; } .hero { padding: 48px 0; } }
</style>
