---
import { createHash } from 'node:crypto';
import '@fontsource-variable/geist';
import type { CityView, PageView, SiteView } from '../data/site';
import { defaultSiteImagePath } from '../data/site';
import { publicAsset } from '../data/public-asset';
import SiteHeader from '../components/SiteHeader.astro';
import { normalizePublicHtmlPath } from '../data/public-url';

interface Props {
  title: string;
  description: string;
  city?: CityView;
  site: SiteView;
  pages?: PageView[];
  indexable?: boolean;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  firstScreenImage?: unknown;
}

const { title, description, city, site, indexable = true, ogTitle = title, ogDescription = description, ogImage = defaultSiteImagePath } = Astro.props as Props;
if (typeof Astro.props.firstScreenImage === 'string' && Astro.props.firstScreenImage.startsWith('https://')) {
  const imageUrl = new URL(Astro.props.firstScreenImage);
  Astro.csp.insertDirective(`img-src ${imageUrl.origin}`);
}
const metrikaId = String(import.meta.env.PUBLIC_YANDEX_METRIKA_ID || '').match(/^\d+$/)?.[0];
const canonicalUrl = new URL(normalizePublicHtmlPath(Astro.url.pathname), Astro.site);
const socialImageUrl = new URL(publicAsset(ogImage), Astro.site);
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  url: canonicalUrl.href,
  inLanguage: 'ru-RU',
});
const metrikaBootstrap = metrikaId
  ? `window.__YANDEX_METRIKA_ID__=${metrikaId};(function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};m[i].l=1*new Date();k=e.createElement(t);a=e.getElementsByTagName(t)[0];k.async=1;k.src=r;a.parentNode.insertBefore(k,a)})(window,document,'script','https://mc.yandex.ru/metrika/tag.js','ym');ym(${metrikaId},'init',{clickmap:true,trackLinks:true,accurateTrackBounce:true,webvisor:true});`
  : undefined;
const scriptHash = (source: string) => `sha256-${createHash('sha256').update(source).digest('base64')}` as const;
Astro.csp.insertScriptHash(scriptHash(jsonLd));
if (metrikaBootstrap) Astro.csp.insertScriptHash(scriptHash(metrikaBootstrap));
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href={publicAsset('/favicon.ico')} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:image" content={socialImageUrl.href} />
    {indexable ? <link rel="canonical" href={canonicalUrl} /> : <meta name="robots" content="noindex, follow" />}
    {indexable && <script is:inline type="application/ld+json" set:html={jsonLd}></script>}
    {metrikaBootstrap && <script is:inline set:html={metrikaBootstrap}></script>}
  </head>
  <body>
    <SiteHeader {city} {site} />
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <span>{city ? `Подключение домашнего интернета в ${city.nameIn}` : 'Подключение домашнего интернета'}</span>
        <a href="/goroda-obsluzhivaniya">Города обслуживания</a>
        <a href="/politika-konfidencialnosti">Политика конфиденциальности</a>
        <a href="/soglasie-na-obrabotku-personalnyh-dannyh">Согласие на обработку данных</a>
        <a href="/politika-obrabotki-faylov-kuki">Политика cookie</a>
      </div>
    </footer>
    <script>
      import {
        SUBSCRIBER_MODE_EVENT,
        SUBSCRIBER_MODE_STORAGE_KEY,
        isSubscriberModeActive,
      } from '../lib/subscriber-mode.mjs';
      import { recordSessionPage } from '../lib/session-attribution.mjs';

      type MetrikaWindow = Window & {
        __YANDEX_METRIKA_ID__?: number;
        ym?: (...args: unknown[]) => void;
      };
      const metrikaWindow = window as MetrikaWindow;
      try { recordSessionPage(sessionStorage, location.href, document.referrer); } catch { /* Storage may be unavailable. */ }
      const applySubscriberMode = () => {
        document.querySelectorAll('.subscriber-phone').forEach((node) => {
          const support = node.getAttribute('data-support-phone') || 'Официальная поддержка';
          const supportHref = node.getAttribute('data-support-phone-href');
          const value = node.querySelector('[data-phone-value]');
          const caption = node.querySelector('[data-phone-caption]');
          if (value) value.textContent = support;
          else node.textContent = support;
          if (caption) caption.textContent = 'Техподдержка';
          if (supportHref && node instanceof HTMLAnchorElement) node.href = supportHref;
          node.setAttribute('aria-label', `Техническая поддержка: ${support}`);
        });
      };
      window.addEventListener(SUBSCRIBER_MODE_EVENT, applySubscriberMode);
      try {
        const expiresAt = localStorage.getItem(SUBSCRIBER_MODE_STORAGE_KEY);
        if (isSubscriberModeActive(expiresAt)) applySubscriberMode();
        else if (expiresAt !== null) localStorage.removeItem(SUBSCRIBER_MODE_STORAGE_KEY);
      } catch { /* private browsing can disable localStorage */ }
      document.addEventListener('click', (event) => {
        const target = event.target instanceof Element ? event.target.closest('a[href^="tel:"]') : null;
        if (target && typeof metrikaWindow.ym === 'function') metrikaWindow.ym(metrikaWindow.__YANDEX_METRIKA_ID__, 'reachGoal', 'phone_click');
      });
      document.addEventListener('submit', () => {
        if (typeof metrikaWindow.ym === 'function') metrikaWindow.ym(metrikaWindow.__YANDEX_METRIKA_ID__, 'reachGoal', 'lead_form_submit');
      });
    </script>
  </body>
</html>

<style is:global>
  :root { font-family: 'Geist Variable', ui-sans-serif, system-ui, sans-serif; color: #18202a; background: #f6f7f9; font-synthesis: none; }
  * { box-sizing: border-box; }
  body { margin: 0; }
  a { color: inherit; }
  .container { width: min(1200px, calc(100% - 32px)); margin: 0 auto; }
  .footer-inner { min-height: 72px; display: flex; align-items: center; gap: 24px; }
  .footer-inner { flex-wrap: wrap; }
  .footer-inner span { margin-right: auto; }
  .footer-inner a { text-decoration: none; }
  .footer-inner a:hover { text-decoration: underline; }
  .phone { font-weight: 700; text-decoration: none; white-space: nowrap; }
  .hero { padding: 72px 0 56px; background: linear-gradient(135deg, #e8f4ff, #f6f7f9); }
  .eyebrow { color: #1769aa; font-weight: 700; }
  h1 { font-size: clamp(36px, 6vw, 64px); line-height: 1.02; max-width: 780px; margin: 16px 0; letter-spacing: -0.04em; }
  h2 { font-size: 32px; margin: 0 0 24px; letter-spacing: -0.03em; }
  .lead { font-size: 20px; line-height: 1.5; max-width: 680px; color: #526071; }
  .section { padding: 56px 0; }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .card { background: #fff; border: 1px solid #e3e8ef; border-radius: 18px; padding: 24px; box-shadow: 0 8px 24px rgb(21 40 66 / 5%); }
  .card h3 { margin: 0 0 10px; font-size: 20px; }
  .card p { color: #526071; line-height: 1.5; }
  .card-link { display: inline-block; margin-top: 12px; color: #1769aa; font-weight: 700; text-decoration: none; }
  .tariff-price { font-size: 24px; font-weight: 800; margin-top: 20px; }
  .tariff-connection { margin: 8px 0 0; color: #334155; font-weight: 650; }
  .button { display: inline-flex; min-height: 48px; align-items: center; justify-content: center; background: #c91f5c; color: #fff; border-radius: 14px; padding: 12px 22px; text-decoration: none; font-weight: 800; }
  .button:hover { background: #ad174d; }
  a:focus-visible, button:focus-visible, input:focus-visible, summary:focus-visible { outline: 3px solid #1769aa; outline-offset: 3px; }
  .site-footer { background: #18202a; color: #fff; }
  @media (max-width: 800px) { .grid { grid-template-columns: 1fr; } .hero { padding: 48px 0; } }
</style>
