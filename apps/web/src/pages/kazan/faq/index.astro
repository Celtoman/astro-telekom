---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { loadKazanData, pageMeta } from '../../../data/kazan';
import BlockRenderer from '../../../components/BlockRenderer.astro';
const { city, pages } = await loadKazanData();
const page = pages.find((item: any) => item.slug === 'faq');
const meta = pageMeta(pages, 'faq', `Вопросы и ответы — ${city.name}`, `Ответы на частые вопросы о подключении интернета и телевидения в ${city.nameIn}.`);
const questions = [
  ['Как узнать, доступно ли подключение?', 'Введите адрес на странице проверки. Если автоматический ответ недоступен, заявку проверит оператор.'],
  ['Сколько занимает подключение?', 'Срок и дата зависят от технической возможности и согласуются после проверки адреса.'],
  ['Можно ли выбрать другой тариф?', 'Да, оператор предложит доступные варианты для вашего адреса.'],
];
---
<BaseLayout title={meta.title} description={meta.description}>
  {page?.blocks?.length ? <BlockRenderer blocks={page.blocks} tariffs={[]} /> : <><section class="hero"><div class="container"><span class="eyebrow">Поддержка · {city.name}</span><h1>Вопросы и ответы</h1><p class="lead">Короткие ответы о проверке адреса, тарифах и подключении.</p></div></section>
  <section class="section container"><div class="grid">{questions.map(([question, answer]) => <article class="card"><h2>{question}</h2><p>{answer}</p></article>)}</div></section></>}
</BaseLayout>
