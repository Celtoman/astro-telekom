---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadKazanData, pageMeta } from '../../data/kazan';
import BlockRenderer from '../../components/BlockRenderer.astro';
const { city, tariffs, pages } = await loadKazanData();
const homePage = pages.find((page: any) => page.type === 'HOME');
const meta = pageMeta(pages, '', `Домашний интернет в ${city.nameIn}`, `Тарифы домашнего интернета, телевидения и подключения в ${city.nameIn}.`);
---

<BaseLayout title={meta.title} description={meta.description}>
  {homePage?.blocks?.length ? <BlockRenderer blocks={homePage.blocks} tariffs={tariffs} /> : <section class="hero">
    <div class="container">
      <span class="eyebrow">Дом.ру в {city.nameIn}</span>
      <h1>Домашний интернет и телевидение в {city.nameIn}</h1>
      <p class="lead">Подберите подходящую услугу, проверьте возможность подключения по адресу и оставьте заявку на консультацию.</p>
      <a class="button" href="/kazan/proverka-adresa/">Проверить адрес</a>
    </div>
  </section>}
  <section class="section container">
    <h2>Услуги для дома</h2>
    <div class="grid">
      <article class="card"><h3>Домашний интернет</h3><p>Тарифы с разной скоростью подключения для квартиры или дома.</p><a class="card-link" href="/kazan/internet/">Смотреть тарифы →</a></article>
      <article class="card"><h3>Интернет + ТВ</h3><p>Домашний интернет и телевидение в одном подключении.</p><a class="card-link" href="/kazan/internet-tv/">Смотреть тарифы →</a></article>
      <article class="card"><h3>Телевидение</h3><p>Телевизионные услуги и дополнительные возможности для дома.</p><a class="card-link" href="/kazan/tv/">Подробнее →</a></article>
    </div>
  </section>
  <section class="section container">
    <h2>Популярные тарифы</h2>
    <div class="grid">
      {tariffs.map((tariff) => <article class="card"><h3>{tariff.name}</h3><p>{tariff.service}. {tariff.speed}</p><div class="tariff-price">{tariff.price}</div><a class="card-link" href={`/kazan/${tariff.slug}/`}>О тарифе →</a></article>)}
    </div>
  </section>
</BaseLayout>
