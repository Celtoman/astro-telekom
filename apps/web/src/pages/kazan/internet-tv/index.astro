---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { loadKazanData, pageMeta } from '../../../data/kazan';
import BlockRenderer from '../../../components/BlockRenderer.astro';
const { city, tariffs, pages } = await loadKazanData();
const bundleTariffs = tariffs.filter((tariff) => tariff.service === 'Интернет и телевидение');
const page = pages.find((item: any) => item.slug === 'internet-tv');
const meta = pageMeta(pages, 'internet-tv', `Интернет и ТВ в ${city.nameIn}`, `Тарифы интернета и телевидения в ${city.nameIn}.`);
---
<BaseLayout title={meta.title} description={meta.description}>
  {page?.blocks?.length ? <BlockRenderer blocks={page.blocks} tariffs={bundleTariffs} /> : <><section class="hero"><div class="container"><span class="eyebrow">{city.name}</span><h1>Интернет и телевидение</h1><p class="lead">Комплексные тарифы для дома с одной заявкой на подключение.</p><a class="button" href="/kazan/proverka-adresa/">Проверить адрес</a></div></section>
  <section class="section container"><h2>Тарифы интернет + ТВ</h2><div class="grid">{bundleTariffs.map((tariff) => <article class="card"><h3>{tariff.name}</h3><p>{tariff.speed}</p><div class="tariff-price">{tariff.price}</div><a class="card-link" href={`/kazan/${tariff.slug}/`}>Подробнее →</a></article>)}</div></section></>}
</BaseLayout>
