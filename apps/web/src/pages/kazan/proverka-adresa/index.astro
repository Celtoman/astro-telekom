---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { loadKazanData, pageMeta } from '../../../data/kazan';
const { city, pages } = await loadKazanData();
const meta = pageMeta(pages, 'proverka-adresa', `Проверка адреса в ${city.nameIn}`, `Проверьте возможность подключения интернета и телевидения в ${city.nameIn}.`);
const apiUrl = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000/api/v1';
---
<BaseLayout title={meta.title} description={meta.description}>
  <section class="hero"><div class="container"><span class="eyebrow">{city.name}</span><h1>Проверьте возможность подключения</h1><p class="lead">Укажите адрес объекта. Если автоматическая проверка будет недоступна, мы передадим заявку оператору.</p></div></section>
  <section class="section container"><form class="card" id="addressForm"><label for="name">Имя</label><input id="name" name="name" placeholder="Как к вам обращаться" /><label for="serviceType">Что подключить</label><select id="serviceType" name="serviceType"><option value="INTERNET">Домашний интернет</option><option value="INTERNET_TV">Интернет + ТВ</option><option value="TV">Телевидение</option></select><label for="address">Адрес</label><input id="address" name="address" required placeholder="Улица, дом, квартира" /><label for="phone">Телефон</label><input id="phone" name="phone" required placeholder="+7 ___ ___-__-__" /><button class="button" type="submit">Проверить адрес</button><p>Нажимая кнопку, вы соглашаетесь на обработку заявки оператором.</p><p id="formResult" role="status"></p><div id="alternatives" class="alternatives" aria-live="polite"></div></form></section>
</BaseLayout>

<script is:inline define:vars={{ apiUrl, citySlug: city.slug }}>
  const form = document.querySelector('#addressForm');
  const result = document.querySelector('#formResult');
  const alternatives = document.querySelector('#alternatives');
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const data = Object.fromEntries(new FormData(form).entries());
    result.textContent = 'Проверяем адрес…';
    try {
      const checkResponse = await fetch(`${apiUrl}/address-checks`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ siteSlug: 'domru-kazan', citySlug, pageSlug: 'proverka-adresa', address: data.address, objectType: 'apartment' }) });
      const check = await checkResponse.json();
      alternatives.replaceChildren();
      if (check.status === 'UNAVAILABLE' && Array.isArray(check.alternatives) && check.alternatives.length) {
        const heading = document.createElement('strong');
        heading.textContent = 'По адресу доступны другие варианты:';
        alternatives.append(heading);
        for (const alternative of check.alternatives) {
          const url = typeof alternative.url === 'string' && /^https?:\/\//i.test(alternative.url) ? alternative.url : null;
          const item = document.createElement(url ? 'a' : 'span');
          item.textContent = String(alternative.name || alternative.provider || 'Альтернативный провайдер');
          if (url) { item.href = url; item.target = '_blank'; item.rel = 'noopener noreferrer sponsored'; }
          alternatives.append(item);
        }
      }
      let viewedPages = [];
      try { viewedPages = JSON.parse(sessionStorage.getItem('provider_visited_pages') || '[]'); } catch { /* ignore unavailable storage */ }
      const leadResponse = await fetch(`${apiUrl}/leads`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ siteSlug: 'domru-kazan', citySlug, pageSlug: 'proverka-adresa', formName: 'address-check', name: data.name, phone: data.phone, address: data.address, serviceType: data.serviceType, addressCheckId: check.id, referrer: document.referrer, pageUrl: location.href, timeOnSiteSeconds: Math.max(0, Math.round((Date.now() - performance.timeOrigin) / 1000)), deviceType: /Mobi|Android/i.test(navigator.userAgent) ? 'mobile' : 'desktop', viewedPages }) });
      if (!leadResponse.ok) throw new Error('Не удалось сохранить заявку');
      const lead = await leadResponse.json();
      if (lead.subscriberMode && lead.subscriberCookie) document.cookie = `domru_subscriber=${encodeURIComponent(lead.subscriberCookie)}; Max-Age=2592000; Path=/; SameSite=Lax${location.protocol === 'https:' ? '; Secure' : ''}`;
      const checkMessage = check.status === 'AVAILABLE'
        ? 'По предварительной проверке сеть доступна.'
        : check.status === 'UNAVAILABLE'
          ? 'Автоматическая проверка не нашла сеть по адресу.'
          : 'Автоматическая проверка сейчас недоступна.';
      result.textContent = `${checkMessage} Заявка принята, оператор уточнит возможность подключения.`;
      form.reset();
    } catch (error) {
      result.textContent = error instanceof Error ? error.message : 'Произошла ошибка. Попробуйте еще раз.';
    }
  });
</script>

<style>
  form { max-width: 560px; display: grid; gap: 12px; }
  label { font-weight: 700; }
  input { border: 1px solid #d6dde6; border-radius: 10px; padding: 14px; font: inherit; margin-bottom: 8px; }
  button { border: 0; cursor: pointer; font: inherit; width: fit-content; }
  .alternatives { display: grid; gap: 8px; color: #526071; }
  .alternatives a { color: #1769aa; font-weight: 700; }
</style>
