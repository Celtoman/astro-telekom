---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlockRenderer from '../../components/BlockRenderer.astro';
import CityHomeFirstScreen from '../../components/CityHomeFirstScreen.astro';
import CityHomeComposition from '../../components/city-home/CityHomeComposition.astro';
import { cityHomeImageOrigins } from '../../data/general-home';
import { loadSiteData, pageMeta, seoMeta, publicSiteSlug, type CityView, type SiteView } from '../../data/site';

interface Props { city: CityView; site: SiteView }

export async function getStaticPaths() {
  const { cities, site } = await loadSiteData();
  return cities.map((city) => ({ params: { city: city.slug }, props: { city, site } }));
}

const { city, site } = Astro.props as Props;
const homePage = city.pages.find((page) => page.type === 'HOME' && page.slug === '');
if (!homePage) throw new Error(`Не опубликована HOME города «${city.name}»`);
const meta = seoMeta(await loadSiteData(), `/${city.slug}`, pageMeta(`Домашний интернет в ${city.nameIn}`, `Тарифы домашнего интернета, телевидения и подключения в ${city.nameIn}.`));
const heroBlock = homePage?.blocks?.find((block) => block.blockType === 'hero');
if (!heroBlock) throw new Error(`HOME города «${city.name}» не содержит hero канонического шаблона`);
const contentBlocks = homePage?.blocks?.filter((block) => block.blockType !== 'hero') || [];
const apiUrl = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000/api/v1';
const imageOrigins = cityHomeImageOrigins(homePage.blocks ?? []);
---

<BaseLayout title={meta.title} description={meta.description} ogTitle={meta.ogTitle} ogDescription={meta.ogDescription} ogImage={meta.ogImage} firstScreenImage={heroBlock.data.image} {imageOrigins} indexable={meta.indexState !== 'NOINDEX'} city={city} pages={city.pages} {site}>
  {homePage.content?.homeCompositionVersion === '3.0.0' ? <CityHomeComposition page={homePage} {city} {site} {apiUrl} cities={(await loadSiteData()).cities} /> : <>
  <CityHomeFirstScreen block={heroBlock} {city} {site} tariffs={city.tariffs} {apiUrl} siteSlug={publicSiteSlug} pageSlug={homePage.slug} />
  <BlockRenderer
    blocks={contentBlocks}
    tariffs={city.tariffs}
    citySlug={city.slug}
    pages={city.pages}
    {city}
    {site}
    {apiUrl}
    siteSlug={publicSiteSlug}
    pageSlug={homePage.slug}
  />
  </>}
</BaseLayout>
