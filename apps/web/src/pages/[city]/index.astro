---
import FaqPage from "../../components/faq/FaqPage.astro";
import type { FaqPageContent } from "../../../../api/src/faq-page-model";
import { faqStructuredData } from "../../lib/faq-render";
import OfficialSitePage from '../../components/official-site/OfficialSitePage.astro';
import type {OfficialSitePageContent} from '../../../../api/src/official-site-page-model';
import AccountPage from '../../components/account/AccountPage.astro';
import type { AccountPageContent } from '../../../../api/src/account-page-model';
import SpeedTestPage from '../../components/speed-test/SpeedTestPage.astro';
import type { SpeedTestPageContent } from '../../../../api/src/speed-test-page-model';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlockRenderer from '../../components/BlockRenderer.astro';
import CityHomeFirstScreen from '../../components/CityHomeFirstScreen.astro';
import CityHomeComposition from '../../components/city-home/CityHomeComposition.astro';
import { cityHomeImageOrigins } from '../../data/general-home';
import { loadSiteData, pageMeta, seoMeta, publicSiteSlug, type CityView, type SiteView, type PageView } from '../../data/site';

interface Props { city?: CityView; site: SiteView; account?: PageView; official?: PageView; speedTest?: PageView; faq?: PageView }

export async function getStaticPaths() {
  const { cities, site, globalPages } = await loadSiteData();
  const paths: Array<{ params: { city: string }; props: Props }> = cities.map((city) => ({ params: { city: city.slug }, props: { city, site } }));
  const account = globalPages.find(page => page.type === 'ACCOUNT');
  if (account) paths.push({ params: { city: account.slug }, props: { account, site } });
  const official=globalPages.find(page=>page.type==='OFFICIAL_SITE');
  if(official) paths.push({params:{city:official.slug},props:{official,site}});
  const speedTest = globalPages.find(page => page.type === 'SPEED_TEST');
  if (speedTest) paths.push({ params: { city: speedTest.slug }, props: { speedTest, site } });
  const faq = globalPages.find(page => page.type === 'FAQ');
  if (faq) paths.push({ params: { city: faq.slug }, props: { faq, site } });
  return paths;
}

const { city, site, account, official, speedTest, faq } = Astro.props as Props;
if (speedTest) Astro.csp.insertDirective('frame-src https://openspeedtest.com');
const homePage = city?.pages.find((page) => page.type === 'HOME' && page.slug === '');
if (!faq && !official && !account && !speedTest && !homePage) throw new Error(`Не опубликована HOME города «${city?.name}»`);
const meta = seoMeta(await loadSiteData(), faq ? "/faq" : speedTest ? `/${speedTest.slug}` : official ? `/${official.slug}` : account ? `/${account.slug}` : `/${city!.slug}`, pageMeta(faq?.title || speedTest?.title || official?.title || account?.title || `Домашний интернет в ${city?.nameIn}`, speedTest ? 'Проверка скорости интернета и рекомендации по замеру.' : account ? 'Вход и инструкции личного кабинета Дом.ру.' : `Тарифы домашнего интернета, телевидения и подключения в ${city?.nameIn}.`));
const faqContent = faq?.content as unknown as FaqPageContent | undefined;
const heroBlock = homePage?.blocks?.find((block) => block.blockType === 'hero');
if (!faq && !official && !account && !speedTest && !heroBlock) throw new Error(`HOME города «${city?.name}» не содержит hero канонического шаблона`);
const contentBlocks = homePage?.blocks?.filter((block) => block.blockType !== 'hero') || [];
const apiUrl = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000/api/v1';
const imageOrigins = cityHomeImageOrigins(homePage?.blocks ?? []);
---

<BaseLayout structuredData={faqContent ? faqStructuredData(faqContent, Astro.site!) : undefined} title={meta.title} description={meta.description} ogTitle={meta.ogTitle} ogDescription={meta.ogDescription} ogImage={meta.ogImage} firstScreenImage={official ? (official.content as unknown as OfficialSitePageContent).images.hero.src : account ? (account.content as unknown as AccountPageContent).images.heroLogin.src : heroBlock?.data.image} {imageOrigins} indexable={meta.indexState !== 'NOINDEX'} city={city} pages={city?.pages} {site}>
  {faqContent ? <FaqPage content={faqContent} {site} /> : speedTest ? <SpeedTestPage content={speedTest.content as unknown as SpeedTestPageContent} {site} {apiUrl} /> : official ? <OfficialSitePage content={official.content as unknown as OfficialSitePageContent} {site} {apiUrl}/> : account ? <AccountPage content={account.content as unknown as AccountPageContent} {site} {apiUrl} /> : city && homePage && heroBlock ? <>
  {homePage.content?.homeCompositionVersion === '3.0.0' ? <CityHomeComposition page={homePage} {city} {site} {apiUrl} cities={(await loadSiteData()).cities} /> : <>
  <CityHomeFirstScreen block={heroBlock} {city} {site} tariffs={city.tariffs} {apiUrl} siteSlug={publicSiteSlug} pageSlug={homePage.slug} />
  <BlockRenderer
    blocks={contentBlocks}
    tariffs={city.tariffs}
    citySlug={city.slug}
    pages={city?.pages}
    {city}
    {site}
    {apiUrl}
    siteSlug={publicSiteSlug}
    pageSlug={homePage.slug}
  />
  </>}
  </> : null}
</BaseLayout>
