---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AddressForm from '../../components/AddressForm.astro';
import BlockRenderer from '../../components/BlockRenderer.astro';
import { loadSiteData, pageMeta, publicSiteSlug, type CityView, type PageView } from '../../data/site';
import type { TariffView } from '../../data/tariff-view';
import { publicHtmlPath } from '../../data/public-url';

type Resource = { kind: 'page'; page: PageView } | { kind: 'tariff'; tariff: TariffView };
interface Props { city: CityView; resource: Resource }

export async function getStaticPaths() {
  const { cities } = await loadSiteData();
  return cities.flatMap((city) => [
    ...city.pages
      .filter((page) => page.type !== 'HOME' && page.type !== 'TARIFF' && page.slug)
      .map((page) => ({ params: { city: city.slug, slug: page.slug }, props: { city, resource: { kind: 'page', page } } })),
    ...city.tariffs.map((tariff) => ({ params: { city: city.slug, slug: tariff.slug }, props: { city, resource: { kind: 'tariff', tariff } } })),
  ]);
}

const { city, resource } = Astro.props as Props;
const page = resource.kind === 'page' ? resource.page : undefined;
const tariff = resource.kind === 'tariff' ? resource.tariff : undefined;
const addressPage = city.pages.find((item) => item.type === 'ADDRESS_CHECK');
const addressHref = addressPage?.slug ? publicHtmlPath(city.slug, addressPage.slug) : publicHtmlPath(city.slug);
const apiUrl = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000/api/v1';
const pageDefaults: Record<string, { title: string; description: string; heading: string; lead: string; service?: string }> = {
  INTERNET: { title: `Домашний интернет в ${city.nameIn}`, description: `Тарифы домашнего интернета в ${city.nameIn}.`, heading: 'Домашний интернет', lead: 'Выберите скорость подключения и проверьте доступность по вашему адресу.', service: 'Домашний интернет' },
  INTERNET_TV: { title: `Интернет и ТВ в ${city.nameIn}`, description: `Тарифы интернета и телевидения в ${city.nameIn}.`, heading: 'Интернет и телевидение', lead: 'Комплексные тарифы для дома с одной заявкой на подключение.', service: 'Интернет и телевидение' },
  TV: { title: `Телевидение в ${city.nameIn}`, description: `Телевидение для дома в ${city.nameIn}.`, heading: 'Телевидение для дома', lead: 'Расскажите, что вам нужно подключить, и оператор уточнит доступные варианты.', service: 'Телевидение' },
  FAQ: { title: `Вопросы и ответы — ${city.name}`, description: `Ответы на частые вопросы о подключении интернета и телевидения в ${city.nameIn}.`, heading: 'Вопросы и ответы', lead: 'Короткие ответы о проверке адреса, тарифах и подключении.' },
  ADDRESS_CHECK: { title: `Проверка адреса в ${city.nameIn}`, description: `Проверьте возможность подключения интернета и телевидения в ${city.nameIn}.`, heading: 'Проверка адреса', lead: 'Укажите адрес объекта, чтобы проверить возможность подключения.' },
};
const defaults = page ? (pageDefaults[page.type] || { title: page.title || city.name, description: `${page.title || 'Услуги'} в ${city.nameIn}.`, heading: page.title || 'Услуги', lead: `Информация об услуге в ${city.nameIn}.` }) : undefined;
const meta = tariff
  ? (() => {
      const seo = tariff.seo && typeof tariff.seo === 'object' ? tariff.seo : {};
      return {
        title: typeof seo.title === 'string' && seo.title ? seo.title : `${tariff.name} в ${city.nameIn}`,
        description: typeof seo.description === 'string' && seo.description ? seo.description : `${tariff.name}: условия подключения в ${city.nameIn}.`,
      };
    })()
  : pageMeta(city.pages, page?.slug || '', defaults!.title, defaults!.description);
const pageTariffs = defaults?.service ? city.tariffs.filter((item) => item.service === defaults.service) : [];
const questions = [
  ['Как узнать, доступно ли подключение?', 'Введите адрес на странице проверки. Если автоматический ответ недоступен, заявку проверит оператор.'],
  ['Сколько занимает подключение?', 'Срок и дата зависят от технической возможности и согласуются после проверки адреса.'],
  ['Можно ли выбрать другой тариф?', 'Да, оператор предложит доступные варианты для вашего адреса.'],
];
const leadPageTypes = ['INTERNET', 'INTERNET_TV', 'TV'] as const;
const pageServiceType = page && leadPageTypes.includes(page.type as typeof leadPageTypes[number])
  ? page.type as typeof leadPageTypes[number]
  : undefined;
---

<BaseLayout title={meta.title} description={meta.description} city={city} pages={city.pages}>
  {tariff ? <>
    <section class="hero"><div class="container"><span class="eyebrow">{tariff.service} · {city.name}</span><h1>{tariff.name}</h1><p class="lead">{tariff.speed}. Возможность подключения необходимо подтвердить по адресу.</p><div class="tariff-price">{tariff.price}</div>{tariff.connection && <p class="tariff-connection">{tariff.connection}</p>}<a class="button" href={addressHref}>Проверить адрес</a></div></section>
    <section class="section container"><h2>Подключение тарифа</h2><div class="grid"><article class="card"><h3>Проверка доступности</h3><p>Система проверит, доступна ли сеть по вашему адресу.</p></article><article class="card"><h3>Консультация</h3><p>Оператор уточнит условия и ответит на вопросы.</p></article><article class="card"><h3>Заявка</h3><p>Оставьте номер телефона, чтобы согласовать подключение.</p></article></div></section>
    <AddressForm apiUrl={apiUrl} siteSlug={publicSiteSlug} pageSlug={tariff.slug} city={city} mode="lead" serviceType={tariff.serviceType} tariffSlug={tariff.slug} />
  </> : page?.type === 'ADDRESS_CHECK' ? <AddressForm apiUrl={apiUrl} siteSlug={publicSiteSlug} pageSlug={page.slug} city={city} mode="visible" /> : page?.blocks?.length ? <>
    <BlockRenderer blocks={page.blocks} tariffs={pageTariffs} citySlug={city.slug} />
    {pageServiceType && <AddressForm apiUrl={apiUrl} siteSlug={publicSiteSlug} pageSlug={page.slug} city={city} mode="lead" serviceType={pageServiceType} />}
  </> : page?.type === 'FAQ' ? <>
    <section class="hero"><div class="container"><span class="eyebrow">Поддержка · {city.name}</span><h1>{defaults!.heading}</h1><p class="lead">{defaults!.lead}</p></div></section>
    <section class="section container"><div class="grid">{questions.map(([question, answer]) => <article class="card"><h2>{question}</h2><p>{answer}</p></article>)}</div></section>
  </> : <>
    <section class="hero"><div class="container"><span class="eyebrow">{city.name}</span><h1>{defaults!.heading}</h1><p class="lead">{defaults!.lead}</p><a class="button" href={addressHref}>{page?.type === 'TV' ? 'Оставить заявку' : 'Проверить адрес'}</a></div></section>
    {pageTariffs.length > 0 && <section class="section container"><h2>Тарифы</h2><div class="grid">{pageTariffs.map((item) => <article class="card"><h3>{item.name}</h3><p>{item.speed}</p><div class="tariff-price">{item.price}</div>{item.connection && <p class="tariff-connection">{item.connection}</p>}<a class="card-link" href={publicHtmlPath(city.slug, item.slug)}>Подробнее →</a></article>)}</div></section>}
    {pageServiceType && <AddressForm apiUrl={apiUrl} siteSlug={publicSiteSlug} pageSlug={page!.slug} city={city} mode="lead" serviceType={pageServiceType} />}
  </>}
</BaseLayout>
