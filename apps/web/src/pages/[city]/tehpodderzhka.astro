---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SupportPage from '../../components/support/SupportPage.astro';
import { loadSiteData, seoMeta, type CityView, type SiteView, type PageView } from '../../data/site';
import { assertSupportPage } from '../../data/support-page';
import { SUPPORT_IMAGE_PATHS, supportValue } from '../../../../api/src/support-image-model';
interface Props { city: CityView; site: SiteView; page: PageView }
export async function getStaticPaths() {
  const catalog=await loadSiteData();
  return catalog.routes.filter(route=>route.kind==='CITY_SUPPORT').map(route=>{
    const city=catalog.cities.find(city=>city.slug===route.citySlug);
    const page=city?.pages.find(page=>page.type==='CITY_SUPPORT' && route.path==='/'+city.slug+'/'+page.slug);
    if(!city||!page) throw new Error('Маршрут поддержки не соответствует каталогу: '+route.path);
    return {params:{city:city.slug},props:{city,site:catalog.site,page}};
  });
}
const {city,site,page}=Astro.props as Props;
assertSupportPage(page.content);
const catalog=await loadSiteData();
const meta=seoMeta(catalog,'/'+city.slug+'/'+page.slug,{title:page.title??'',description:''});
const apiUrl=import.meta.env.PUBLIC_API_URL||'http://localhost:3000/api/v1';
const imageOrigins=[...new Set(Object.values(SUPPORT_IMAGE_PATHS).map(path=>(supportValue(page.content,path) as {src:string}).src).filter(src=>src.startsWith('https:')).map(src=>new URL(src).origin))];
---
<BaseLayout title={meta.title} description={meta.description} ogTitle={meta.ogTitle} ogDescription={meta.ogDescription} ogImage={meta.ogImage} indexable={meta.indexState!=='NOINDEX'} {imageOrigins} {city} {site} pages={city.pages}>
  <SupportPage content={page.content} {site} {city} {apiUrl} media={catalog.supportMedia}/>
</BaseLayout>
