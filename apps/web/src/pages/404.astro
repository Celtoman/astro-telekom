---
import NotFoundContent from '../components/NotFoundContent.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadSiteData } from '../data/site';
const { site, editorial } = await loadSiteData();
---
<BaseLayout title={editorial?.notFound?.title ?? "Страница не найдена"} description={editorial?.notFound?.description ?? "Запрошенная страница не найдена."} indexable={false} {site}>
  {editorial?.notFound ? <NotFoundContent content={editorial.notFound as unknown as import("../../../api/src/news-types").NotFoundContent} /> : <section class="hero"><div class="container"><span class="eyebrow">Ошибка 404</span><h1>Страница не найдена</h1><p class="lead">Проверьте адрес или выберите город на главной странице.</p><a class="button" href="/">На главную</a></div></section>}
</BaseLayout>
