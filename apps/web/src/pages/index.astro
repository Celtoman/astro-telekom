---
import BaseLayout from '../layouts/BaseLayout.astro';
const title = 'Домашний интернет и телевидение Дом.ру';
const description = 'Выберите город, чтобы посмотреть тарифы домашнего интернета и телевидения.';
---

<BaseLayout title={title} description={description}>
  <section class="hero"><div class="container"><span class="eyebrow">Дом.ру</span><h1>{title}</h1><p class="lead">Тарифы, проверка адреса и консультация по подключению в Казани.</p><a class="button" href="/kazan/">Перейти в Казань</a></div></section>
  <section class="section container"><h2>Города</h2><div class="grid"><article class="card"><h3>Казань</h3><p>Домашний интернет, телевидение и актуальные предложения.</p><a class="card-link" href="/kazan/">Открыть страницу города →</a></article></div></section>
</BaseLayout>
