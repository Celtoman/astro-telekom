---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/HomeHero.astro';
import GeneralHomeHero from '../components/GeneralHomeHero.astro';
import GeneralHomeComposition from '../components/general-home/GeneralHomeComposition.astro';
import { generalHomeImageOrigins } from '../data/general-home';
import { loadSiteData, seoMeta, publicSiteSlug } from '../data/site';
import { publishedMoscow } from '../lib/city-context.mjs';
const catalog = await loadSiteData();
const { site, cities } = catalog;
const title = `Домашний интернет и телевидение ${site.name}`;
const description = 'Выберите город, чтобы посмотреть тарифы домашнего интернета и телевидения.';
const meta = seoMeta(catalog, '/', { title, description });
const defaultCity = publishedMoscow(cities) ?? undefined;
const hero = catalog.homeHero;
const homeShell = catalog.generalHome ? { cities, addressDialogId: defaultCity ? 'general-home-address-entry' : null } : undefined;
---

<BaseLayout title={meta.title} description={meta.description} ogTitle={meta.ogTitle} ogDescription={meta.ogDescription} ogImage={meta.ogImage} firstScreenImage={hero?.image} imageOrigins={generalHomeImageOrigins(catalog.generalHome)} {homeShell} indexable={meta.indexState !== 'NOINDEX'} {site}>
  {catalog.generalHome ? <GeneralHomeComposition home={catalog.generalHome} {site} {cities} apiUrl={import.meta.env.PUBLIC_API_URL || 'http://localhost:3000/api/v1'} addressDialogId="general-home-address-entry" /> : catalog.homeHeroVersion === '2.0.0' && hero ? <GeneralHomeHero content={hero} {cities} /> : <HomeHero variant="general" title={hero ? String(hero.title) : `Подключение домашнего интернета и телевидения ${site.name}`} text={hero ? String(hero.text) : 'Укажите адрес, чтобы проверить возможность подключения Дом.ру в вашем доме и узнать о доступных услугах.'} content={hero} city={defaultCity} {site} siteSlug={publicSiteSlug} apiUrl={import.meta.env.PUBLIC_API_URL || 'http://localhost:3000/api/v1'} />}
</BaseLayout>
