---
import AddressForm from './AddressForm.astro';
import type { CityView } from '../data/site';
import type { TariffView } from '../data/tariff-view';

interface Props {
  block: { blockType: string; data: Record<string, unknown> };
  city: CityView;
  tariffs: TariffView[];
  apiUrl: string;
  siteSlug: string;
  pageSlug: string;
}

const { block, city, tariffs, apiUrl, siteSlug, pageSlug } = Astro.props as Props;
const title = typeof block.data.title === 'string' ? block.data.title : `Домашний интернет и телевидение в ${city.nameIn}`;
const text = typeof block.data.text === 'string' ? block.data.text : 'Сравните опубликованные тарифы и проверьте возможность подключения по вашему адресу.';
const eyebrow = typeof block.data.eyebrow === 'string' ? block.data.eyebrow : `Дом.ру в ${city.nameIn}`;
const publishedSpeeds = tariffs.map((tariff) => tariff.speedMbps).filter((value): value is number => value !== null);
const publishedPrices = tariffs.map((tariff) => tariff.priceAmount).filter((value): value is number => value !== null);
const maximumSpeed = publishedSpeeds.length > 0 ? Math.max(...publishedSpeeds) : null;
const minimumPrice = publishedPrices.length > 0 ? Math.min(...publishedPrices) : null;
const tariffWord = (count: number) => {
  const mod100 = count % 100;
  const mod10 = count % 10;
  if (mod100 >= 11 && mod100 <= 14) return 'тарифов';
  if (mod10 === 1) return 'тариф';
  if (mod10 >= 2 && mod10 <= 4) return 'тарифа';
  return 'тарифов';
};
const priceLabel = minimumPrice === null
  ? 'Условия уточнит оператор'
  : `от ${new Intl.NumberFormat('ru-RU', { maximumFractionDigits: 2 }).format(minimumPrice).replace(/[\u00a0\u202f]/g, ' ')} ₽/мес.`;
const phoneHref = `tel:${city.phone.replace(/[^+\d]/g, '')}`;
---

<section class="city-first-screen" data-block-type="hero" data-city-first-screen>
  <div class="container first-screen-stack">
    <div class="city-hero-card">
      <div class="city-hero-copy">
        <span class="eyebrow">{eyebrow}</span>
        <h1>{title}</h1>
        <p class="lead">{text}</p>
        <dl class="proof-grid" aria-label="Ключевые параметры опубликованных тарифов">
          <div><dt>Опубликовано</dt><dd>{tariffs.length} {tariffWord(tariffs.length)}</dd></div>
          <div><dt>Скорость</dt><dd>{maximumSpeed === null ? 'Уточняется' : `до ${maximumSpeed} Мбит/с`}</dd></div>
          <div><dt>Стоимость</dt><dd>{priceLabel}</dd></div>
        </dl>
      </div>
      <figure class="city-hero-visual">
        <img src="/images/home-connection-equipment.webp" width="1280" height="720" alt="Wi-Fi-роутер, ТВ-приставка и пульт для домашнего подключения" loading="eager" decoding="async" fetchpriority="high" />
      </figure>
    </div>

    <div class="first-screen-actions">
      <article class="address-panel">
        <span class="panel-kicker">Проверка доступности</span>
        <h2>Проверим возможность подключения по вашему адресу</h2>
        <p>Введите город, улицу и дом. После точного выбора адреса система проверит техническую доступность, а при успехе предложит оставить телефон.</p>
        <AddressForm {apiUrl} {siteSlug} {pageSlug} {city} mode="visible" embedded />
      </article>
      <aside class="contact-panel" aria-labelledby="consultation-title">
        <span class="panel-kicker">Помощь с выбором</span>
        <h2 id="consultation-title">Получить консультацию</h2>
        <p>Оператор уточнит условия опубликованных тарифов и ответит на вопросы о подключении.</p>
        <div class="phone-label">Отдел подключений</div>
        <a class="consultation-phone subscriber-phone" href={phoneHref} data-support-phone={city.phone}>{city.phone}</a>
      </aside>
    </div>
  </div>
</section>

<style>
  .city-first-screen { padding: 18px 0 30px; background: #f6f7f9; }
  .container { width: min(1200px, calc(100% - 32px)); margin: 0 auto; }
  .first-screen-stack { display: grid; gap: 14px; }
  .city-hero-card { display: grid; grid-template-columns: minmax(0, 1.08fr) minmax(340px, .92fr); min-height: 430px; overflow: hidden; border: 1px solid #dcecf7; border-radius: 30px; background: #eaf7ff; box-shadow: 0 18px 50px rgb(21 40 66 / 8%); }
  .city-hero-copy { z-index: 1; align-self: center; padding: clamp(28px, 3.2vw, 44px); padding-right: 16px; }
  .eyebrow, .panel-kicker { color: #c91f5c; font-size: 13px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  h1 { max-width: 690px; margin: 14px 0 16px; font-size: clamp(38px, 4.2vw, 56px); line-height: .98; letter-spacing: -.05em; }
  .lead { max-width: 660px; margin: 0; color: #526071; font-size: clamp(17px, 1.7vw, 20px); line-height: 1.5; }
  .proof-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; margin: 24px 0 0; }
  .proof-grid div { min-width: 0; border: 1px solid rgb(255 255 255 / 82%); border-radius: 16px; padding: 12px 14px; background: rgb(255 255 255 / 76%); }
  .proof-grid dt { margin-bottom: 5px; color: #697789; font-size: 12px; font-weight: 700; }
  .proof-grid dd { margin: 0; font-size: clamp(15px, 1.25vw, 18px); font-weight: 850; letter-spacing: -.02em; }
  .city-hero-visual { position: relative; min-width: 0; margin: 0; background: #d9f1ff; }
  .city-hero-visual::after { position: absolute; inset: 0; background: linear-gradient(90deg, #eaf7ff 0%, transparent 20%); content: ''; pointer-events: none; }
  .city-hero-visual img { width: 100%; height: 100%; object-fit: cover; object-position: 52% center; display: block; }
  .first-screen-actions { display: grid; grid-template-columns: minmax(0, 2fr) minmax(280px, 1fr); gap: 14px; }
  .address-panel, .contact-panel { border: 1px solid #dcecf7; border-radius: 26px; background: #eef8ff; padding: clamp(24px, 3vw, 34px); }
  .address-panel h2, .contact-panel h2 { margin: 8px 0 10px; font-size: clamp(25px, 2.6vw, 34px); line-height: 1.08; letter-spacing: -.035em; }
  .address-panel > p, .contact-panel > p { margin: 0; color: #526071; line-height: 1.5; }
  .phone-label { margin-top: 28px; color: #697789; font-size: 13px; font-weight: 700; }
  .consultation-phone { display: inline-block; margin-top: 6px; color: #18202a; font-size: clamp(21px, 2vw, 28px); font-weight: 850; letter-spacing: -.03em; text-decoration: none; }
  .consultation-phone:hover { color: #c91f5c; }
  @media (max-width: 820px) {
    .city-hero-card { grid-template-columns: 1fr; }
    .city-hero-copy { padding-right: clamp(30px, 4vw, 54px); }
    .city-hero-visual { min-height: 360px; }
    .city-hero-visual::after { background: linear-gradient(180deg, #eaf7ff 0%, transparent 20%); }
  }
  @media (max-width: 760px) {
    .city-first-screen { padding-top: 12px; }
    .first-screen-actions { grid-template-columns: 1fr; }
    .city-hero-card, .address-panel, .contact-panel { border-radius: 22px; }
  }
  @media (max-width: 560px) {
    .container { width: min(100% - 20px, 1200px); }
    .city-hero-copy { padding: 26px 22px 18px; }
    h1 { font-size: clamp(38px, 12vw, 50px); }
    .proof-grid { grid-template-columns: 1fr; margin-top: 24px; }
    .proof-grid div { display: flex; align-items: baseline; justify-content: space-between; gap: 14px; }
    .proof-grid dt { margin: 0; }
    .proof-grid dd { text-align: right; }
    .city-hero-visual { min-height: 260px; }
    .address-panel, .contact-panel { padding: 24px 20px; }
  }
</style>
