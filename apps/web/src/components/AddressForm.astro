---
import type { CityView, SiteView } from '../data/site';
import type { TariffView } from '../data/tariff-view';

type Presentation = 'embedded' | 'dialog';
type ServiceType = 'INTERNET' | 'INTERNET_TV' | 'TV' | 'OTHER';

interface Props {
  apiUrl: string;
  siteSlug: string;
  pageSlug: string;
  city: CityView;
  site: SiteView;
  presentation?: Presentation;
  dialogId?: string;
  serviceType?: ServiceType;
  tariff?: TariffView;
}

const {
  apiUrl,
  siteSlug,
  pageSlug,
  city,
  site,
  presentation = 'embedded',
  dialogId,
  serviceType = 'INTERNET',
  tariff,
} = Astro.props as Props;
const suffix = tariff?.slug || pageSlug || 'catalog';
const formId = `address-form-${city.slug}-${presentation}-${suffix}`;
const entryDialogId = dialogId || `address-entry-${city.slug}-${suffix}`;
const resultDialogId = `address-result-${city.slug}-${presentation}-${suffix}`;
const resultHeadingId = `${resultDialogId}-heading`;
const consentVersion = 'lead-form-v1-2026-09-22';
const supportPhoneHref = `tel:${site.supportPhone.replace(/[^+\d]/g, '')}`;
const tariffSummary = tariff ? JSON.stringify({
  slug: tariff.slug,
  name: tariff.name,
  price: tariff.price,
  serviceType: tariff.serviceType,
  components: tariff.baseComponents.filter((item) => item.included).map((item) => item.value),
}) : '';
const EntryContainer = presentation === 'dialog' ? 'dialog' : 'section';
---

<div
  class:list={['address-check-root', { embedded: presentation === 'embedded', modal: presentation === 'dialog' }]}
  data-address-check-root
  data-presentation={presentation}
  data-entry-dialog-id={presentation === 'dialog' ? entryDialogId : ''}
>
  <EntryContainer
    id={presentation === 'dialog' ? entryDialogId : 'address-check'}
    class:list={['address-entry', { 'entry-dialog': presentation === 'dialog' }]}
    data-address-entry-dialog={presentation === 'dialog' ? '' : undefined}
    aria-labelledby={presentation === 'dialog' ? `${formId}-title` : undefined}
  >
    <div class:list={{ 'dialog-card': presentation === 'dialog' }}>
      {presentation === 'dialog' && (
        <button type="button" class="dialog-close" data-entry-close aria-label="Закрыть проверку адреса">×</button>
      )}
      {presentation === 'dialog' && <h2 id={`${formId}-title`}>Проверить адрес</h2>}
      <form
        class="address-form"
        id={formId}
        data-address-form
        data-api-url={apiUrl}
        data-site-slug={siteSlug}
        data-city-slug={city.slug}
        data-page-slug={pageSlug}
        data-service-type={tariff?.serviceType || serviceType}
        data-tariff-slug={tariff?.slug || ''}
        data-tariff-summary={tariffSummary}
        autocomplete="off"
      >
        <div class="bot-field" aria-hidden="true">
          <label for={`website-${formId}`}>Ваш сайт</label>
          <input id={`website-${formId}`} name="website" tabindex="-1" autocomplete="off" />
        </div>
        <label for={`address-${formId}`}>Адрес</label>
        <div class="address-field">
          <input
            id={`address-${formId}`}
            type="text"
            name="address"
            required
            maxlength="300"
            autocomplete="off"
            aria-autocomplete="list"
            aria-haspopup="listbox"
            aria-expanded="false"
            aria-controls={`address-suggestions-${formId}`}
            placeholder="Город, улица, дом, квартира"
          />
          <div
            id={`address-suggestions-${formId}`}
            data-address-suggestions
            class="address-suggestions"
            role="listbox"
            aria-label="Подсказки адреса"
            hidden
          ></div>
        </div>
        <p class="address-hint" data-address-hint aria-live="polite">Начните вводить город и адрес, затем выберите подходящий вариант.</p>
        <button class="button" type="submit" data-submit disabled>Проверить адрес</button>
        <p class="form-result" data-form-result role="status"></p>
      </form>
    </div>
  </EntryContainer>

  <dialog id={resultDialogId} class="result-dialog" data-address-result-dialog aria-labelledby={resultHeadingId}>
    <div class="dialog-card result-card">
      <button type="button" class="dialog-close" data-result-close aria-label="Закрыть результат проверки">×</button>
      <h2 id={resultHeadingId} data-result-heading tabindex="-1">Результат проверки</h2>

      <section data-business-outcome="TARGET_AVAILABLE" hidden>
        <div class="lead-content" data-lead-content>
          <span class="result-mark success" aria-hidden="true">✓</span>
          <h3>Дом.ру доступен</h3>
          <p>Подключение доступно по адресу <strong data-result-address></strong>.</p>
          <div class="tariff-summary" data-result-tariff hidden>
            <span>Выбранный тариф</span>
            <strong data-result-tariff-name></strong>
            <span data-result-tariff-price></span>
            <ul data-result-tariff-components></ul>
          </div>
          <form class="lead-form" data-lead-form data-consent-version={consentVersion}>
            <label for={`phone-${formId}`}>Телефон</label>
            <input
              id={`phone-${formId}`}
              data-phone-input
              type="tel"
              name="phone"
              required
              inputmode="tel"
              autocomplete="tel"
              maxlength="18"
              aria-describedby={`phone-error-${formId}`}
              placeholder="+7 (___) ___-__-__"
            />
            <p id={`phone-error-${formId}`} class="field-error" data-phone-error role="alert" hidden>Введите российский номер из 10 цифр</p>
            <button class="button" type="submit" data-lead-submit>
              <span data-lead-submit-label>Оставить заявку</span>
              <span class="submit-spinner" data-lead-spinner aria-hidden="true" hidden></span>
            </button>
            <p class="consent-copy">
              Нажимая кнопку, вы соглашаетесь с <a href="/politika-konfidencialnosti">политикой конфиденциальности</a>
              и даёте <a href="/soglasie-na-obrabotku-personalnyh-dannyh">согласие на обработку персональных данных</a>.
            </p>
            <p data-lead-result role="status" aria-live="polite"></p>
          </form>
        </div>
        <section class="lead-success" data-lead-success hidden>
          <span class="result-mark success" aria-hidden="true">✓</span>
          <h3>Спасибо! Заявка отправлена</h3>
          <p>Оператор свяжется с вами, чтобы подтвердить детали подключения.</p>
          <button class="button" type="button" data-lead-success-close>Закрыть</button>
        </section>
      </section>

      <section data-business-outcome="ALTERNATIVES_AVAILABLE" hidden>
        <span class="result-mark neutral" aria-hidden="true">→</span>
        <h3>Дом.ру по этому адресу не найден</h3>
        <p>По адресу <strong data-result-address></strong> доступны другие провайдеры:</p>
        <ul class="provider-list" data-provider-list></ul>
        <a class="button" data-provider-action target="_blank" rel="noopener noreferrer sponsored">Посмотреть тарифы на Tarifnik.ru</a>
        <button class="secondary-button" type="button" data-change-address>Проверить другой адрес</button>
      </section>

      <section data-business-outcome="NO_PROVIDERS" hidden>
        <span class="result-mark neutral" aria-hidden="true">i</span>
        <h3>Провайдеры не найдены</h3>
        <p>По адресу <strong data-result-address></strong> пока нет доступных предложений.</p>
        <p>Уточнить возможность подключения можно по телефону <a href={supportPhoneHref}>{site.supportPhone}</a>.</p>
        <button class="secondary-button" type="button" data-change-address>Проверить другой адрес</button>
      </section>

      <section data-technical-error hidden>
        <span class="result-mark error" aria-hidden="true">!</span>
        <h3>Не удалось выполнить проверку</h3>
        <p data-technical-message>Попробуйте еще раз.</p>
        <div class="dialog-actions">
          <button class="button" type="button" data-retry-check>Повторить</button>
          <button class="secondary-button" type="button" data-change-address>Изменить адрес</button>
        </div>
      </section>
    </div>
  </dialog>
</div>

<script>
  import { initializeAddressChecks } from '../lib/address-check-client.mjs';
  initializeAddressChecks();
</script>

<style>
  .address-check-root { width: 100%; }
  .address-entry { scroll-margin-top: 24px; }
  .address-form { position: relative; display: grid; max-width: 560px; gap: 12px; }
  .address-form label, .lead-form label { font-weight: 750; }
  input { width: 100%; min-height: 48px; box-sizing: border-box; border: 1px solid #d6dde6; border-radius: 12px; padding: 12px 14px; background: #fff; color: #18202a; font: inherit; }
  input:focus-visible, button:focus-visible, a:focus-visible { outline: 3px solid #8fc4ef; outline-offset: 3px; }
  input[data-confirmed='true'] { border-color: #2e8b63; box-shadow: 0 0 0 3px rgb(46 139 99 / 14%); }
  .address-field { position: relative; display: grid; }
  .address-hint, .form-result, .consent-copy, [data-lead-result] { margin: 0; color: #526071; font-size: 14px; line-height: 1.45; }
  .consent-copy a { color: inherit; text-underline-offset: 2px; }
  .field-error { margin: -4px 0 0; color: #b42318; font-size: 14px; }
  .address-hint[data-state='error'], [data-lead-result][data-state='error'] { color: #b42318; }
  .address-hint[data-state='success'] { color: #176b45; }
  .address-suggestions { position: absolute; z-index: 20; inset: calc(100% + 6px) 0 auto; display: grid; max-height: 300px; gap: 2px; overflow-y: auto; overscroll-behavior: contain; border: 1px solid #e2e5eb; border-radius: 16px; padding: 8px; background: #fff; box-shadow: 0 12px 28px rgb(21 40 66 / 14%); }
  .address-suggestions[hidden], [hidden] { display: none !important; }
  .address-suggestions :global(.address-suggestions-title) { padding: 2px 12px 6px; color: #526071; font-size: 12px; font-weight: 650; }
  .address-suggestions :global(.address-option) { display: grid; width: 100%; min-height: 44px; gap: 2px; border: 0; border-radius: 12px; padding: 8px 12px; background: #fff; color: #18202a; font: inherit; cursor: pointer; text-align: left; }
  .address-suggestions :global(.address-option:hover), .address-suggestions :global(.address-option:focus-visible), .address-suggestions :global(.address-option[aria-selected='true']) { background: #eef4ff; outline: none; }
  .address-suggestions :global(.address-option-primary) { font-size: 15px; font-weight: 700; line-height: 1.35; }
  .address-suggestions :global(.address-option-secondary) { color: #526071; font-size: 13px; line-height: 1.35; }
  .address-suggestions :global(mark) { padding: 0; background: transparent; color: inherit; font-weight: 850; }
  .button, .secondary-button { display: inline-flex; min-height: 48px; width: fit-content; align-items: center; justify-content: center; border: 0; border-radius: 14px; padding: 12px 22px; font: inherit; font-weight: 800; cursor: pointer; text-decoration: none; }
  .button { color: #fff; background: #c91f5c; }
  .button:hover { background: #ad174d; }
  .secondary-button { color: #18202a; background: #eef2f6; }
  button:disabled { cursor: not-allowed; opacity: .55; }
  .bot-field { position: absolute; inline-size: 1px; block-size: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  dialog { width: min(620px, calc(100% - 24px)); max-height: min(88vh, 760px); overflow: auto; border: 0; border-radius: 26px; padding: 0; color: #18202a; background: transparent; box-shadow: 0 28px 90px rgb(21 40 66 / 30%); }
  dialog::backdrop { background: rgb(15 23 42 / 62%); backdrop-filter: blur(3px); }
  .dialog-card { position: relative; display: grid; gap: 16px; padding: clamp(24px, 5vw, 42px); background: #fff; }
  .dialog-card h2, .dialog-card h3, .dialog-card p { margin: 0; }
  .dialog-card h2 { padding-right: 36px; font-size: clamp(28px, 5vw, 38px); line-height: 1.05; letter-spacing: -.035em; }
  .dialog-card h3 { margin: 10px 0 8px; font-size: clamp(24px, 4vw, 32px); }
  .dialog-close { position: absolute; z-index: 2; inset: 14px 14px auto auto; display: grid; width: 42px; height: 42px; place-items: center; border: 0; border-radius: 50%; background: #eef2f6; color: #18202a; font-size: 26px; cursor: pointer; }
  .result-card > section { display: grid; gap: 16px; }
  .result-mark { display: grid; width: 52px; height: 52px; place-items: center; border-radius: 17px; font-size: 24px; font-weight: 900; }
  .result-mark.success { color: #176b45; background: #e8f7ef; }
  .result-mark.neutral { color: #1769aa; background: #eaf4ff; }
  .result-mark.error { color: #b42318; background: #fff0ed; }
  .tariff-summary { display: grid; gap: 5px; border: 1px solid #dce5ee; border-radius: 18px; padding: 18px; background: #f8fafc; }
  .tariff-summary > span:first-child { color: #697789; font-size: 13px; font-weight: 700; }
  .tariff-summary ul, .provider-list { display: grid; gap: 8px; margin: 6px 0 0; padding-left: 20px; }
  .lead-content, .lead-success { display: grid; gap: 16px; }
  .lead-form { display: grid; gap: 12px; border-top: 1px solid #e3e8ef; padding-top: 18px; }
  .submit-spinner { width: 16px; height: 16px; margin-left: 8px; border: 2px solid rgb(255 255 255 / 50%); border-top-color: #fff; border-radius: 50%; animation: submit-spin .8s linear infinite; }
  @keyframes submit-spin { to { transform: rotate(360deg); } }
  .provider-list { color: #334155; }
  .dialog-actions { display: flex; flex-wrap: wrap; gap: 10px; }
  .embedded { margin-top: 20px; }
  .embedded .address-entry { width: 100%; }
  .embedded .address-form { grid-template-columns: minmax(0, 1fr) auto; max-width: none; border: 0; padding: 0; background: transparent; box-shadow: none; }
  .embedded .address-form > label { grid-column: 1 / -1; }
  .embedded .address-field { grid-column: 1; }
  .embedded .address-hint, .embedded .form-result { grid-column: 1 / -1; }
  .embedded [data-submit] { grid-column: 2; grid-row: 2; min-width: 178px; }
  @media (max-width: 620px) {
    .embedded .address-form { grid-template-columns: 1fr; }
    .embedded .address-field, .embedded [data-submit] { grid-column: 1; grid-row: auto; }
    .embedded [data-submit], .result-card .button, .result-card .secondary-button { width: 100%; }
    dialog { width: min(100% - 16px, 620px); border-radius: 22px; }
    .dialog-card { padding: 28px 20px 24px; }
  }
</style>
