---
import { publicAsset } from '../data/public-asset';
import type { CityView, SiteView } from '../data/site';
import type { TariffView } from '../data/tariff-view';

type Presentation = 'embedded' | 'dialog';
type ServiceType = 'INTERNET' | 'INTERNET_TV' | 'TV' | 'OTHER';

interface Props {
  apiUrl: string;
  siteSlug: string;
  pageSlug: string;
  city: CityView;
  site: SiteView;
  presentation?: Presentation;
  dialogId?: string;
  serviceType?: ServiceType;
  tariff?: TariffView;
  variant?: 'standard' | 'hero';
  addressPlaceholder?: string;
  checkButtonText?: string;
}

const {
  apiUrl,
  siteSlug,
  pageSlug,
  city,
  presentation = 'embedded',
  dialogId,
  serviceType = 'INTERNET',
  tariff,
  variant = 'standard',
  addressPlaceholder,
  checkButtonText,
} = Astro.props as Props;
const suffix = tariff?.slug || pageSlug || 'catalog';
const formId = `address-form-${city.slug}-${presentation}-${suffix}`;
const entryDialogId = dialogId || `address-entry-${city.slug}-${suffix}`;
const resultDialogId = `address-result-${city.slug}-${presentation}-${suffix}`;
const resultHeadingId = `${resultDialogId}-heading`;
const consentVersion = 'lead-form-v1-2026-09-22';
const tariffSummary = tariff ? JSON.stringify({
  slug: tariff.slug,
  name: tariff.name,
  price: tariff.price,
  serviceType: tariff.serviceType,
  components: tariff.baseComponents.filter((item) => item.included).map((item) => item.value),
}) : '';
const EntryContainer = presentation === 'dialog' ? 'dialog' : 'section';
---

<div
  class:list={['address-check-root', { embedded: presentation === 'embedded', modal: presentation === 'dialog', 'hero-address': variant === 'hero' }]}
  data-address-check-root
  data-presentation={presentation}
  data-entry-dialog-id={presentation === 'dialog' ? entryDialogId : ''}
>
  <EntryContainer
    id={presentation === 'dialog' ? entryDialogId : 'address-check'}
    class:list={['address-entry', { 'entry-dialog': presentation === 'dialog', 'public-dialog': presentation === 'dialog' }]}
    data-address-entry-dialog={presentation === 'dialog' ? '' : undefined}
    aria-labelledby={presentation === 'dialog' ? `${formId}-title` : undefined}
  >
    <div class:list={{ 'flow-card': presentation === 'dialog' }} data-modal-content>
      {presentation === 'dialog' && <div class="flow-header"><span class="flow-icon"><img src={publicAsset('/images/figma/status-address.svg')} width="24" height="24" alt="" /></span><h2 id={`${formId}-title`}>Проверить адрес</h2><button type="button" class="flow-close" data-entry-close aria-label="Закрыть проверку адреса"><img src={publicAsset('/images/figma/close.svg')} width="24" height="24" alt="" /></button></div>}
      <form
        class="address-form"
        id={formId}
        data-address-form
        data-api-url={apiUrl}
        data-site-slug={siteSlug}
        data-city-slug={city.slug}
        data-page-slug={pageSlug}
        data-service-type={tariff?.serviceType || serviceType}
        data-tariff-slug={tariff?.slug || ''}
        data-tariff-summary={tariffSummary}
        autocomplete="off"
      >
        <div class="bot-field" aria-hidden="true">
          <label for={`website-${formId}`}>Ваш сайт</label>
          <input id={`website-${formId}`} name="website" tabindex="-1" autocomplete="off" />
        </div>
        <label for={`address-${formId}`}>Адрес</label>
        <div class="address-field">
          {variant === 'hero' && <img class="address-icon" src={publicAsset('/images/figma/map-pin.svg')} width="20" height="20" alt="" />}
          <input
            id={`address-${formId}`}
            type="text"
            name="address"
            required
            maxlength="300"
            autocomplete="off"
            aria-autocomplete="list"
            aria-haspopup="listbox"
            aria-expanded="false"
            aria-controls={`address-suggestions-${formId}`}
            placeholder={addressPlaceholder ?? (variant === 'hero' ? 'Введите ваш адрес' : 'Город, улица, дом, квартира')}
          />
          <div
            id={`address-suggestions-${formId}`}
            data-address-suggestions
            class="address-suggestions"
            role="listbox"
            aria-label="Подсказки адреса"
            hidden
          ></div>
        </div>
        <p class="address-hint" data-address-hint aria-live="polite">Начните вводить город и адрес, затем выберите подходящий вариант.</p>
        <button class="button" type="submit" data-submit data-submit-label={checkButtonText ?? (variant === 'hero' ? 'Проверить' : 'Проверить адрес')} disabled>{checkButtonText ?? (variant === 'hero' ? 'Проверить' : 'Проверить адрес')}</button>
        <p class="form-result" data-form-result role="status"></p>
      </form>
    </div>
  </EntryContainer>

  <dialog id={resultDialogId} class="result-dialog public-dialog" data-address-result-dialog aria-labelledby={resultHeadingId}>
    <div class="flow-card result-card" data-modal-content>
      <div class="flow-header"><span class="flow-icon flow-icon-success" data-result-icon data-icon-available={publicAsset('/images/figma/status-available.svg')} data-icon-alternatives={publicAsset('/images/figma/status-alternatives.svg')} data-icon-unavailable={publicAsset('/images/figma/status-unavailable.svg')} data-icon-success={publicAsset('/images/figma/status-success.svg')}><img src={publicAsset('/images/figma/status-available.svg')} width="24" height="24" alt="" /></span><h2 id={resultHeadingId} data-result-heading tabindex="-1">Результат проверки</h2><button type="button" class="flow-close" data-result-close aria-label="Закрыть результат проверки"><img src={publicAsset('/images/figma/close.svg')} width="24" height="24" alt="" /></button></div>

      <section data-business-outcome="TARGET_AVAILABLE" hidden>
        <div class="lead-content" data-lead-content>
          <form class="lead-form" data-lead-form data-consent-version={consentVersion} novalidate>
          <div class="flow-body">
          <p>Подключение доступно по вашему адресу. Оставьте телефон — специалист позвонит и поможет выбрать тариф.</p>
          <div class="result-address-summary"><p data-result-address></p><button class="flow-text-action" type="button" data-change-address>Изменить адрес</button></div>
          <div class="tariff-summary" data-result-tariff hidden>
            <span>Выбранный тариф</span>
            <strong data-result-tariff-name></strong>
            <span data-result-tariff-price></span>
            <ul data-result-tariff-components></ul>
          </div>
          <div class="flow-field">
            <label for={`phone-${formId}`}>Телефон</label>
            <input
              id={`phone-${formId}`}
              data-phone-input
              type="tel"
              name="phone"
              required
              inputmode="tel"
              autocomplete="tel"
              maxlength="18"
              value="+7 "
              aria-describedby={`phone-error-${formId}`}
              placeholder="+7 (___) ___-__-__"
            />
            <p id={`phone-error-${formId}`} class="field-error" data-phone-error role="alert" hidden>Введите мобильный номер в формате +7 (9XX) XXX-XX-XX</p>
          </div>
          </div>
          <div class="flow-footer">
            <div class="flow-consent"><label><input type="checkbox" data-lead-consent aria-label="Даю согласие на обработку персональных данных" required /></label><p>Даю <a href="/soglasie-na-obrabotku-personalnyh-dannyh" data-legal-document="PERSONAL_DATA_CONSENT">согласие на обработку персональных данных</a> и подтверждаю ознакомление с <a href="/politika-konfidencialnosti" data-legal-document="PRIVACY">политикой конфиденциальности</a>.</p></div>
            <p class="flow-small" data-consent-hint>Для отправки заявки подтвердите согласие.</p>
            <button class="flow-button" type="submit" data-lead-submit disabled><span data-lead-submit-label>Оставить заявку</span><span class="flow-spinner" data-lead-spinner aria-hidden="true" hidden></span></button>
            <p data-lead-result role="status" aria-live="polite"></p>
          </div>
          </form>
        </div>
        <section class="lead-success flow-body" data-lead-success hidden>
          <p class="flow-small">Специалист позвонит на указанный номер и уточнит детали подключения.</p>
          <button class="button" type="button" data-lead-success-close>Закрыть</button>
        </section>
      </section>

      <section data-business-outcome="ALTERNATIVES_AVAILABLE" class="flow-body" hidden>
        <div class="result-address-summary"><p data-result-address></p><button class="flow-text-action" type="button" data-change-address>Изменить адрес</button></div><p>По этому адресу доступны другие провайдеры. Вы можете сравнить их тарифы на Tarifnik.ru.</p>
        <ul class="provider-list" data-provider-list></ul>
        <a class="button" data-provider-action target="_blank" rel="noopener noreferrer sponsored">Посмотреть тарифы</a><p class="flow-small">Откроется сайт Tarifnik.ru</p>
        <button class="flow-text-action" type="button" data-change-address>Проверить другой адрес</button>
      </section>

      <section data-business-outcome="NO_PROVIDERS" class="flow-body" hidden>
        <div class="result-address-summary"><p data-result-address></p><button class="flow-text-action" type="button" data-change-address>Изменить адрес</button></div><p>По этому адресу пока нет доступных предложений. Проверьте другой адрес или повторите проверку позже.</p>
        <button class="flow-text-action" type="button" data-change-address>Проверить другой адрес</button>
      </section>

      <section data-technical-error class="flow-body" hidden>
        <p data-technical-message>Попробуйте еще раз.</p>
        <div class="dialog-actions">
          <button class="button" type="button" data-retry-check>Повторить</button>
          <button class="flow-text-action" type="button" data-change-address>Изменить адрес</button>
        </div>
      </section>
    </div>
  </dialog>
</div>

<script>
  import { initializeAddressChecks } from '../lib/address-check-client.mjs';
  initializeAddressChecks();
</script>

<style>
  .address-check-root { width: 100%; }
  .address-entry { scroll-margin-top: 24px; }
  .address-form { position: relative; display: grid; max-width: 560px; gap: 12px; }
  .address-form label, .lead-form label { font-weight: 600; }
  .address-form input, .lead-form input[type=tel] { width: 100%; min-height: 48px; box-sizing: border-box; border: 1px solid #d6dde6; border-radius: 12px; padding: 12px 14px; background: #fff; color: #18202a; font: inherit; }
  textarea { resize: vertical; }
  .optional-label { color: #526071; font-weight: 500; }
  input:focus-visible, textarea:focus-visible, button:focus-visible, a:focus-visible { outline: 3px solid #8fc4ef; outline-offset: 3px; }
  input[data-confirmed='true'] { border-color: #2e8b63; box-shadow: 0 0 0 3px rgb(46 139 99 / 14%); }
  .address-field { position: relative; display: grid; }
  .address-hint, .form-result, .consent-copy, [data-lead-result] { margin: 0; color: #526071; font-size: 14px; line-height: 1.45; }
  .consent-copy a { color: inherit; text-underline-offset: 2px; }
  .field-error { margin: -4px 0 0; color: #b42318; font-size: 14px; }
  .address-hint[data-state='error'], [data-lead-result][data-state='error'] { color: #b42318; }
  .address-hint[data-state='success'] { color: #176b45; }
  .address-suggestions { position: absolute; z-index: 20; inset: calc(100% + 6px) 0 auto; display: grid; max-height: 300px; gap: 2px; overflow-y: auto; overscroll-behavior: contain; border: 1px solid #e2e5eb; border-radius: 16px; padding: 8px; background: #fff; box-shadow: 0 12px 28px rgb(21 40 66 / 14%); }
  .address-suggestions[hidden], [hidden] { display: none !important; }
  .address-suggestions :global(.address-suggestions-title) { padding: 2px 12px 6px; color: #526071; font-size: 12px; font-weight: 650; }
  .address-suggestions :global(.address-option) { display: grid; width: 100%; min-height: 44px; gap: 2px; border: 0; border-radius: 12px; padding: 8px 12px; background: #fff; color: #18202a; font: inherit; cursor: pointer; text-align: left; }
  .address-suggestions :global(.address-option:hover), .address-suggestions :global(.address-option:focus-visible), .address-suggestions :global(.address-option[aria-selected='true']) { background: #eef4ff; outline: none; }
  .address-suggestions :global(.address-option-primary) { font-size: 15px; font-weight: 700; line-height: 1.35; }
  .address-suggestions :global(.address-option-secondary) { color: #526071; font-size: 13px; line-height: 1.35; }
  .address-suggestions :global(mark) { padding: 0; background: transparent; color: inherit; font-weight: 850; }
  .button, .secondary-button { display: inline-flex; min-height: 48px; width: fit-content; align-items: center; justify-content: center; border: 0; border-radius: 14px; padding: 14px 24px; font: inherit; font-size: 14px; line-height: 20px; font-weight: 600; cursor: pointer; text-decoration: none; }
  .button { color: #fff; background: #e0231e; }
  .button:hover { background: #c61f1a; }
  .secondary-button { color: #18202a; background: #eef2f6; }
  button:disabled { cursor: not-allowed; opacity: .45; }
  .bot-field { position: absolute; inline-size: 1px; block-size: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .result-card > section { min-height: 0; }
  .result-card > section[data-business-outcome="TARGET_AVAILABLE"], .lead-content, .lead-form { display: flex; flex-direction: column; min-height: 0; }
  .lead-form { gap: 16px; }
  .result-card > section[data-business-outcome="TARGET_AVAILABLE"], .lead-content, .lead-form { flex: 1; }
  .lead-form > .flow-body { flex: 1; }
  .lead-form > .flow-body > * { flex-shrink: 0; }
  .result-dialog .button, .entry-dialog .button { width: 100%; }
  .lead-form input[type=tel] { min-height: 48px; padding: 12px; border: 1px solid #dcecf7; border-radius: 10px; font: inherit; font-size: 16px; line-height: 24px; }
  .lead-form .field-error, [data-lead-result][data-state=error] { color: #b42318; font-size: 14px; line-height: 20px; }
  .tariff-summary { display: grid; gap: 4px; padding: 12px; border-radius: 10px; background: #eef8ff; }
  .tariff-summary ul { display: grid; gap: 4px; margin: 0; padding-left: 20px; font-size: 14px; line-height: 20px; }
  .result-address-summary p { color: #18202a; }
  .provider-list { display: grid; gap: 8px; margin: 0; padding: 0; list-style: none; }
  .provider-list :global(li) { padding: 12px 16px; border-radius: 10px; background: #eef8ff; font-size: 16px; line-height: 24px; }
  .dialog-actions { display: flex; flex-direction: column; gap: 12px; }
  .entry-dialog .address-form { display: flex; flex-direction: column; min-height: 0; overflow-y: auto; gap: 12px; border: 0; padding: 0; margin: 0; box-shadow: none; background: none; }
  .entry-dialog .address-form input { border: 1px solid #dcecf7; border-radius: 10px; min-height: 48px; padding: 12px; font-size: 16px; line-height: 24px; }
  .entry-dialog .address-suggestions { position: static; border: 0; box-shadow: none; padding: 0; margin-top: 12px; max-height: 240px; }
  .entry-dialog .address-suggestions :global(.address-option) { padding: 12px 16px; min-height: 72px; border-radius: 10px; }
  .entry-dialog .address-suggestions :global(.address-option-primary) { font-size: 16px; line-height: 24px; font-weight: 400; }
  .entry-dialog .address-suggestions :global(.address-option-secondary) { font-size: 14px; line-height: 20px; }
  .entry-dialog .address-form .address-hint { font-size: 14px; line-height: 20px; margin: 0; }
  .entry-dialog .address-form .form-result:empty { display: none; }
  .embedded { margin-top: 20px; }
  .embedded .address-entry { width: 100%; }
  .embedded .address-form { grid-template-columns: minmax(0, 1fr) auto; max-width: none; border: 0; padding: 0; background: transparent; box-shadow: none; }
  .embedded .address-form > label { grid-column: 1 / -1; }
  .embedded .address-field { grid-column: 1; }
  .embedded .address-hint, .embedded .form-result { grid-column: 1 / -1; }
  .embedded [data-submit] { grid-column: 2; grid-row: 2; min-width: 178px; }
  .hero-address.embedded { margin-top: 0; }
  .hero-address .address-form { gap: 16px; }
  .hero-address .address-form > label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .hero-address .address-field { grid-row: 1; }
  .hero-address .address-icon { position: absolute; left: 16px; top: 14px; pointer-events: none; }
  .hero-address .address-field input { height: 48px; border-color: #f0f3f6; border-radius: 14px; padding-left: 46px; font-size: 16px; }
  .hero-address .address-field input::placeholder { color: #5c6b7d; opacity: 1; }
  .hero-address .address-hint:not([data-state]) { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .hero-address .form-result:empty { display: none; }
  .hero-address [data-submit] { grid-row: 1; width: 200px; min-width: 0; padding: 14px 24px; font-size: 14px; font-weight: 600; line-height: 20px; background: #e0231e; }
  .hero-address [data-submit]:hover { background: #c61e1a; }
  @media (max-width: 620px) {
    .embedded .address-form { grid-template-columns: 1fr; }
    .embedded .address-field, .embedded [data-submit] { grid-column: 1; grid-row: auto; }
    .embedded [data-submit], .result-card .button, .result-card .secondary-button { width: 100%; }
    .hero-address [data-submit] { grid-row: auto; }
  }
</style>
