---
import type {OfficialSitePageContent} from '../../../../api/src/official-site-page-model';
import {OFFICIAL_SITE_PAGE_SLUG} from '../../../../api/src/official-site-page-model';
import type {SiteView} from '../../data/site';
import {publicAsset} from '../../data/public-asset';
import {renderOfficialSiteIntro,renderOfficialSiteBody,renderOfficialSiteFaqTail,officialSiteFaqItems,officialSiteFaqPhoneLinks} from '../../lib/official-site-render';
import AddressOnly from '../general-home/AddressOnly.astro';
import HomeFaq from '../general-home/HomeFaq.astro';
import HomeBlockStyles from '../general-home/HomeBlockStyles.astro';
import OfficialSiteStyles from './OfficialSiteStyles.astro';
interface Props {content:OfficialSitePageContent;site:SiteView;apiUrl:string}
const {content,site,apiUrl}=Astro.props;
---
<div class="official-page">
 <Fragment set:html={renderOfficialSiteIntro(content,{asset:publicAsset})}/>
 <AddressOnly {site} {apiUrl} pageSlug={OFFICIAL_SITE_PAGE_SLUG} pageScope="GLOBAL"/>
 <Fragment set:html={renderOfficialSiteBody(content,{asset:publicAsset,includeFaq:false})}/>
 <div id="official-faq" class:list={['official-faq',{'has-extra':content.faq.items.length>6}]}><HomeFaq content={{title:'Часто задаваемые вопросы (FAQ)',items:officialSiteFaqItems(content).slice(0,6)}} phoneLinks={officialSiteFaqPhoneLinks(content)}/>{content.faq.items.length>6&&<div class="official-faq-extra"><Fragment set:html={renderOfficialSiteFaqTail(content,{asset:publicAsset})}/></div>}</div>
</div>
<HomeBlockStyles/><OfficialSiteStyles/>
