---
import type { CityView } from '../data/site';
import { publicAsset } from '../data/public-asset';
import { renderCitiesDirectory } from '../lib/cities-directory-render';

interface Props { cities: CityView[] }
const { cities } = Astro.props as Props;
---

<Fragment set:html={renderCitiesDirectory({ cities, asset: publicAsset })} />

<script>
  import { initializeCitiesDirectories } from '../lib/cities-directory.mjs';
  initializeCitiesDirectories();
  document.addEventListener('astro:page-load', () => initializeCitiesDirectories());
</script>

<style is:global>
  /* Match the public Header container; section spacing must not add a second horizontal gutter. */
  .cities-directory { display: flex; flex-direction: column; gap: 32px; width: min(1360px, calc(100% - 32px)); min-width: 0; margin: 0 auto; padding: 48px 0; color: #18202a; background: #fff; font-family: 'Geist Variable', ui-sans-serif, system-ui, sans-serif; }
  .cities-directory-heading { display: flex; flex-direction: column; align-items: flex-start; gap: 16px; min-width: 0; }
  .cities-directory h1 { width: 100%; max-width: none; margin: 0; font-size: 48px; font-weight: 800; line-height: 50px; letter-spacing: -2.4px; overflow-wrap: anywhere; }
  .cities-directory p { margin: 0; }
  .cities-directory-intro { width: 100%; color: #526071; font-size: 16px; line-height: 24px; }
  .cities-directory-compact-copy { display: none; }
  .cities-directory-search { position: relative; display: flex; align-items: center; gap: 8px; width: 100%; max-width: 640px; height: 48px; padding: 0 12px; border: 1px solid #dcecf7; border-radius: 10px; background: #fff; }
  .cities-directory-compact-placeholder { display: none; }
  .cities-directory-search > img { display: block; flex: 0 0 24px; }
  .cities-directory-search input { flex: 1; width: 0; min-width: 0; height: 24px; margin: 0; padding: 0; border: 0; border-radius: 0; outline: 0; color: #18202a; background: transparent; font: inherit; font-size: 16px; line-height: 24px; appearance: none; }
  .cities-directory-search input::placeholder { color: #526071; opacity: 1; }
  .cities-directory-search input::-webkit-search-cancel-button { display: none; }
  .cities-directory-search input:disabled { opacity: 1; -webkit-text-fill-color: #526071; }
  .cities-directory-search:focus-within { border-color: #1769aa; box-shadow: inset 0 0 0 1px #1769aa; }
  .cities-directory-search input:focus-visible { outline: 0; }
  .cities-directory-clear { display: flex; flex: 0 0 44px; align-items: center; justify-content: center; width: 44px; height: 44px; margin-right: -10px; padding: 0; border: 0; border-radius: 10px; background: transparent; cursor: pointer; }
  .cities-directory-clear img { display: block; }
  .cities-directory-status { color: #526071; font-size: 14px; line-height: 20px; }
  .cities-directory-groups { display: flex; flex-direction: column; gap: 32px; min-width: 0; }
  .cities-directory-region { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
  .cities-directory-region header { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding-bottom: 12px; border-bottom: 1px solid #dcecf7; }
  .cities-directory h2 { min-width: 0; margin: 0; font-size: 20px; line-height: 25px; font-weight: 700; letter-spacing: -.2px; overflow-wrap: anywhere; }
  .cities-directory-region header span { flex: 0 0 auto; color: #526071; font-size: 14px; line-height: 20px; }
  .cities-directory-region ul { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 4px 24px; margin: 0; padding: 0; list-style: none; }
  .cities-directory-region li { display: flex; min-width: 0; }
  .cities-directory-region a { display: flex; align-items: center; width: 100%; min-width: 0; min-height: 48px; padding: 12px; border-radius: 10px; color: #18202a; font-size: 16px; line-height: 24px; font-weight: 400; text-decoration: none; overflow-wrap: anywhere; }
  .cities-directory-region a:hover { color: #1769aa; background: #eef8ff; }
  .cities-directory :is(a, button):focus-visible { outline: 2px solid #1769aa; outline-offset: 2px; }
  .cities-directory-empty { display: flex; flex-direction: column; align-items: flex-start; gap: 16px; padding: 20px; border-radius: 14px; background: #eaf7ff; }
  .cities-directory-empty p { color: #526071; font-size: 16px; line-height: 24px; overflow-wrap: anywhere; }
  .cities-directory-empty button { min-height: 44px; max-width: 100%; padding: 12px 20px; border: 0; border-radius: 14px; color: #1769aa; background: #eef8ff; font: inherit; font-size: 14px; line-height: 20px; font-weight: 600; cursor: pointer; }
  .cities-directory-empty button:hover { background: #dcecf7; }
  .cities-directory [hidden] { display: none !important; }
  @media (max-width: 1100px) {
    .cities-directory { width: min(720px, calc(100% - 32px)); padding: 32px 0; }
    .cities-directory h1 { font-size: 40px; line-height: 43px; letter-spacing: -1.6px; }
    .cities-directory-search { max-width: none; }
    .cities-directory-region ul { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 620px) {
    .cities-directory { gap: 24px; padding: 20px 0; }
    .cities-directory h1 { font-size: 28px; line-height: 33px; letter-spacing: -1.4px; }
    .cities-directory-region ul { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 16px; }
  }
  @media (max-width: 360px) {
    .cities-directory-full-copy { display: none; }
    .cities-directory-compact-copy { display: inline; }
    .cities-directory-region ul { grid-template-columns: minmax(0, 1fr); }
    .cities-directory-search input::placeholder { color: transparent; -webkit-text-fill-color: transparent; }
    .cities-directory-search input:placeholder-shown + .cities-directory-compact-placeholder { position: absolute; left: 44px; right: 12px; display: block; color: #526071; font-size: 16px; line-height: 24px; white-space: nowrap; overflow: hidden; pointer-events: none; }
  }
</style>
