---
import { normalizePublicHref } from '../data/public-url';
import type { CityView, PageView, SiteView } from '../data/site';
import type { TariffView } from '../data/tariff-view';
import AddressForm from './AddressForm.astro';
import TariffCollection from './TariffCollection.astro';

interface Block {
  blockType: string;
  data: Record<string, unknown>;
}

interface TextItem { title: string; text: string }
interface FaqItem { question: string; answer: string }
interface ServiceItem extends TextItem { pageType: string }

interface Props {
  blocks: Block[];
  tariffs: TariffView[];
  citySlug: string;
  city: CityView;
  site: SiteView;
  apiUrl: string;
  siteSlug: string;
  pageSlug: string;
  pages?: PageView[];
}

const { blocks, tariffs, citySlug, city, site, apiUrl, siteSlug, pageSlug } = Astro.props as Props;
const catalogDialogId = `address-entry-${city.slug}-catalog`;
---

{blocks.map((block: Block) => {
  const title = typeof block.data.title === 'string' ? block.data.title : '';
  if (block.blockType === 'hero') {
    const eyebrow = typeof block.data.eyebrow === 'string' ? block.data.eyebrow : '';
    const text = typeof block.data.text === 'string' ? block.data.text : '';
    const ctaHref = typeof block.data.ctaHref === 'string' ? block.data.ctaHref : '';
    const ctaText = typeof block.data.ctaText === 'string' ? block.data.ctaText : 'Подробнее';
    return <section class="hero" data-block-type="hero"><div class="container hero-inner"><div class="hero-copy">{eyebrow && <span class="eyebrow">{eyebrow}</span>}<h1>{title}</h1>{text && <p class="lead">{text}</p>}{ctaHref && <a class="button" href={normalizePublicHref(ctaHref)}>{ctaText}</a>}</div><div class="hero-visual" aria-hidden="true"><span class="signal signal-one"></span><span class="signal signal-two"></span><span class="signal signal-three"></span><span class="hero-speed">Wi-Fi</span></div></div></section>;
  }
  if (block.blockType === 'rich_text') {
    const text = typeof block.data.text === 'string' ? block.data.text : '';
    return <section class="section container narrow" data-block-type="rich_text"><h2>{title}</h2><p class="lead">{text}</p></section>;
  }
  if (block.blockType === 'tariff_grid') {
    return <TariffCollection data={block.data} {tariffs} {citySlug} cityName={city.name} dialogId={catalogDialogId} />;
  }
  if (block.blockType === 'service_grid') {
    const items = Array.isArray(block.data.items) ? block.data.items as ServiceItem[] : [];
    const services = items.map((item) => ({
      ...item,
      serviceType: item.pageType === 'INTERNET' || item.pageType === 'INTERNET_TV' || item.pageType === 'TV' ? item.pageType : null,
    }));
    if (services.length === 0) return null;
    return <section class="section container" data-block-type="service_grid"><div class="section-heading"><span class="section-kicker">Выберите услугу</span><h2>{title}</h2></div><div class="service-grid">{services.map((item) => <article class="card service-card"><span class="feature-mark" aria-hidden="true">→</span><h3>{item.title}</h3><p>{item.text}</p>{item.serviceType && <button class="card-link link-button" type="button" data-address-dialog-trigger={catalogDialogId} data-service-type={item.serviceType} aria-label={`Проверить подключение услуги ${item.title}`}>Проверить подключение</button>}</article>)}</div></section>;
  }
  if (block.blockType === 'feature_grid') {
    const items = Array.isArray(block.data.items) ? block.data.items as TextItem[] : [];
    return <section class="section feature-section" data-block-type="feature_grid"><div class="container"><div class="section-heading"><span class="section-kicker">Главное</span><h2>{title}</h2></div><div class:list={['feature-grid', `feature-grid-count-${Math.min(items.length, 4)}`]}>{items.map((item, index) => <article class="card feature-card"><span class="feature-mark" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><h3>{item.title}</h3><p>{item.text}</p></article>)}</div></div></section>;
  }
  if (block.blockType === 'steps') {
    const items = Array.isArray(block.data.items) ? block.data.items as TextItem[] : [];
    return <section class="section container" data-block-type="steps"><div class="section-heading"><span class="section-kicker">Простой процесс</span><h2>{title}</h2></div><ol class:list={['steps-grid', `steps-grid-count-${Math.min(items.length, 4)}`]}>{items.map((item, index) => <li><span class="step-number" aria-hidden="true">{index + 1}</span><div><h3>{item.title}</h3><p>{item.text}</p></div></li>)}</ol></section>;
  }
  if (block.blockType === 'faq') {
    const items = Array.isArray(block.data.items) ? block.data.items as FaqItem[] : [];
    return <section class="section faq-section" data-block-type="faq"><div class="container faq-layout"><div class="section-heading"><span class="section-kicker">Помощь</span><h2>{title}</h2><p>Коротко отвечаем на вопросы о выборе и подключении.</p></div><div class="faq-list">{items.map((item) => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}</div></div></section>;
  }
  return null;
})}

<AddressForm {apiUrl} {siteSlug} {pageSlug} {city} {site} presentation="dialog" dialogId={catalogDialogId} />

<style>
  .container { width: min(1120px, calc(100% - 32px)); margin: 0 auto; }
  .hero { overflow: hidden; padding: 72px 0; background: #eef6ff; }
  .hero-inner { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(280px, .65fr); align-items: center; gap: 48px; }
  .hero-copy { position: relative; z-index: 1; }
  .eyebrow, .section-kicker { color: #e93c78; font-size: 13px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  h1 { max-width: 780px; margin: 16px 0; font-size: clamp(42px, 6vw, 72px); line-height: .98; letter-spacing: -.05em; }
  .lead { max-width: 680px; color: #526071; font-size: 20px; line-height: 1.5; }
  .hero .button { margin-top: 18px; }
  .hero-visual { position: relative; min-height: 320px; border-radius: 50%; background: #e93c78; box-shadow: 0 30px 80px rgb(233 60 120 / 25%); }
  .hero-speed { position: absolute; inset: 50% auto auto 50%; transform: translate(-50%, -50%); color: #fff; font-size: 48px; font-weight: 850; letter-spacing: -.06em; }
  .signal { position: absolute; inset: 50% auto auto 50%; width: 70%; aspect-ratio: 1; translate: -50% -50%; border: 2px solid rgb(255 255 255 / 58%); border-radius: 50%; }
  .signal-two { width: 90%; } .signal-three { width: 112%; }
  .section { padding: 72px 0; }
  .narrow { max-width: 820px; }
  .section-heading { max-width: 720px; margin-bottom: 30px; }
  h2 { margin: 10px 0 0; font-size: clamp(32px, 4vw, 48px); line-height: 1.08; letter-spacing: -.04em; }
  .tariff-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
  .service-grid, .feature-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 18px; }
  .service-card { grid-column: span 5; }
  .service-card:nth-child(2n) { grid-column: span 7; }
  .service-card:nth-child(3n) { grid-column: span 12; }
  .feature-card { grid-column: span 7; }
  .feature-card:nth-child(2n) { grid-column: span 5; }
  .feature-card:nth-child(4n + 3) { grid-column: span 5; }
  .feature-card:nth-child(4n) { grid-column: span 7; }
  .feature-grid-count-1 .feature-card { grid-column: span 12; }
  .feature-grid-count-3 .feature-card:first-child { grid-column: span 12; }
  .card { background: #fff; border: 1px solid #e3e8ef; border-radius: 24px; padding: 28px; box-shadow: 0 14px 40px rgb(21 40 66 / 7%); }
  .tariff-card { display: flex; min-height: 360px; flex-direction: column; justify-content: space-between; }
  .tariff-service { color: #697789; font-size: 14px; font-weight: 700; }
  .card h3 { margin: 12px 0 8px; font-size: 23px; line-height: 1.18; }
  .card p, .steps-grid p, .faq-list p, .section-heading p { color: #526071; line-height: 1.55; }
  .tariff-speed { font-size: 17px; }
  .tariff-price { margin-top: 28px; font-size: 30px; font-weight: 850; letter-spacing: -.03em; }
  .tariff-connection { min-height: 24px; margin: 8px 0 20px; font-size: 14px; }
  .button { display: inline-flex; min-height: 48px; align-items: center; justify-content: center; border-radius: 14px; padding: 12px 22px; color: #fff; background: #c91f5c; font-weight: 800; text-decoration: none; }
  .button:hover { background: #ad174d; }
  .button-secondary { width: 100%; }
  .tariff-detail-link { margin: 0 0 18px; }
  .feature-section, .faq-section { background: #edf4fb; }
  .feature-section + .feature-section { border-top: 1px solid #dce5ee; background: #fff; }
  .feature-card, .service-card { position: relative; min-height: 230px; }
  .feature-mark { display: inline-flex; min-width: 44px; height: 44px; align-items: center; justify-content: center; border-radius: 14px; color: #e93c78; background: #fde8f0; font-weight: 850; }
  .card-link { display: inline-block; margin-top: 12px; color: #c91f5c; font-weight: 800; text-decoration: none; }
  .link-button { border: 0; padding: 0; background: transparent; font: inherit; cursor: pointer; }
  .card-link:hover { text-decoration: underline; text-underline-offset: 4px; }
  .section-more { display: flex; justify-content: flex-end; margin-top: 22px; }
  .section-more .card-link { margin: 0; }
  .steps-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; padding: 0; list-style: none; }
  .steps-grid-count-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .steps-grid li { display: flex; gap: 16px; padding-top: 20px; border-top: 2px solid #dbe3ec; }
  .step-number { display: grid; flex: 0 0 42px; height: 42px; place-items: center; border-radius: 50%; color: #fff; background: #18202a; font-weight: 800; }
  .steps-grid h3 { margin: 7px 0 6px; font-size: 20px; }
  .steps-grid p { margin: 0; }
  .faq-layout { display: grid; grid-template-columns: minmax(240px, .7fr) minmax(0, 1.3fr); gap: 60px; }
  .faq-list { display: grid; gap: 12px; }
  .faq-list details { border: 1px solid #dce5ee; border-radius: 18px; background: #fff; padding: 0 22px; }
  .faq-list summary { cursor: pointer; padding: 22px 32px 22px 0; font-size: 18px; font-weight: 750; }
  .faq-list p { margin: 0; padding: 0 0 22px; }
  .empty-copy { padding: 28px; border: 1px dashed #cdd8e4; border-radius: 18px; color: #526071; }
  @media (max-width: 900px) {
    .hero-inner, .faq-layout { grid-template-columns: 1fr; }
    .hero-visual { min-height: 240px; }
    .tariff-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .steps-grid-count-4 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .service-card, .service-card:nth-child(n), .feature-card, .feature-card:nth-child(n) { grid-column: span 6; }
  }
  @media (max-width: 640px) {
    .hero { padding: 52px 0; }
    .hero-inner { gap: 32px; }
    .hero-visual { min-height: 210px; }
    .hero-speed { font-size: 40px; }
    .section { padding: 52px 0; }
    .tariff-grid, .steps-grid { grid-template-columns: 1fr; }
    .service-grid, .feature-grid { grid-template-columns: 1fr; }
    .service-card, .service-card:nth-child(n), .feature-card, .feature-card:nth-child(n) { grid-column: auto; }
    .card { padding: 22px; border-radius: 20px; }
    .tariff-card { min-height: 330px; }
    .faq-layout { gap: 26px; }
  }
</style>
