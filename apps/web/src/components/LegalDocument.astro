---
import type { LegalSection } from '../data/legal-pages';
import { publicAsset } from '../data/public-asset';
import { renderLegalDocument } from '../lib/legal-document-render';

interface Props { title: string; introduction?: string; sections: LegalSection[] }
const { title, introduction = '', sections } = Astro.props as Props;
---
<Fragment set:html={renderLegalDocument({ title, introduction, sections, asset: publicAsset })} />

<style is:global>
  .legal-document { width: min(1360px, calc(100% - 32px)); margin: 0 auto; padding: 32px; color: #18202a; background: #fff; font-family: 'Geist Variable', ui-sans-serif, system-ui, sans-serif; }
  .legal-document-container { display: flex; flex-direction: column; gap: 32px; width: 100%; max-width: 1072px; min-width: 0; margin: 0 auto; }
  .legal-document h1 { max-width: none; margin: 0; color: inherit; font-size: 48px; line-height: 50px; font-weight: 800; letter-spacing: -2.4px; overflow-wrap: anywhere; }
  .legal-document-layout { display: grid; grid-template-columns: minmax(0, 720px); align-items: start; gap: 64px; width: 100%; min-width: 0; }
  .legal-document-with-toc { grid-template-columns: minmax(0, 720px) 288px; }
  .legal-document-copy { display: flex; flex-direction: column; gap: 32px; min-width: 0; }
  .legal-document-copy section { display: flex; flex-direction: column; gap: 16px; min-width: 0; scroll-margin-top: 24px; }
  .legal-document h2 { margin: 0; color: inherit; font-size: 20px; line-height: 25px; font-weight: 700; letter-spacing: -.2px; overflow-wrap: anywhere; }
  .legal-paragraphs { display: flex; flex-direction: column; gap: 12px; }
  .legal-document p { margin: 0; color: inherit; font-size: 16px; line-height: 24px; font-weight: 400; white-space: pre-line; overflow-wrap: anywhere; }
  .legal-toc-sidebar { display: flex; flex-direction: column; gap: 12px; padding: 16px; min-width: 0; }
  .legal-toc-caption { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .legal-toc-caption strong { color: #18202a; font-size: 20px; line-height: 25px; font-weight: 700; letter-spacing: -.2px; }
  .legal-toc-caption > span { color: #526071; font-size: 14px; line-height: 20px; }
  .legal-toc-mobile { display: none; }
  .legal-back-top { display: inline-flex; align-items: center; align-self: flex-start; min-height: 44px; color: #1769aa; font-size: 14px; line-height: 20px; text-underline-offset: 3px; }
  .legal-back-top:focus-visible, .legal-toc-mobile summary:focus-visible { outline: 2px solid #1769aa; outline-offset: 3px; border-radius: 4px; }
  .legal-document #legal-document-title { scroll-margin-top: 24px; }
  @media (max-width: 1100px) {
    .legal-document { width: min(720px, calc(100% - 32px)); padding: 24px; }
    .legal-document h1 { font-size: 40px; line-height: 43px; font-weight: 700; letter-spacing: -1.6px; }
    .legal-document-layout { display: flex; flex-direction: column; gap: 32px; }
    .legal-document-copy { width: 100%; }
    .legal-toc-sidebar { display: none; }
    .legal-toc-mobile { display: block; width: 100%; min-width: 0; padding: 16px; border: 1px solid #dcecf7; border-radius: 14px; }
    .legal-toc-mobile summary { display: flex; align-items: center; gap: 12px; min-height: 44px; cursor: pointer; list-style: none; }
    .legal-toc-mobile summary::-webkit-details-marker { display: none; }
    .legal-toc-mobile summary .legal-toc-caption { flex: 1; }
    .legal-toc-mobile summary img { display: block; flex: 0 0 24px; width: 24px; height: 24px; }
    .legal-toc-mobile summary .legal-caret-up { display: none; }
    .legal-toc-mobile[open] .legal-caret-down { display: none; }
    .legal-toc-mobile[open] .legal-caret-up { display: block; }
    .legal-toc-mobile nav { margin-top: 12px; }
  }
  @media (max-width: 620px) {
    .legal-document { padding: 16px; }
    .legal-document h1 { font-size: 28px; line-height: 33px; letter-spacing: -1.5px; }
  }
  .legal-toc-links { display: flex; flex-direction: column; gap: 4px; margin: 0; padding: 0; list-style: none; }
  .legal-toc-links li { min-width: 0; }
  .legal-toc-links a { display: flex; align-items: center; min-height: 44px; padding: 10px 0; color: #526071; font-size: 14px; line-height: 20px; text-decoration: none; overflow-wrap: anywhere; }
  .legal-toc-links a:hover { color: #1769aa; text-decoration: underline; text-underline-offset: 3px; }
  .legal-toc-links a:focus-visible { outline: 2px solid #1769aa; outline-offset: 2px; border-radius: 4px; }
</style>
