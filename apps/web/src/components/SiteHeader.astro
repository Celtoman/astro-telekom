---
import { publicAsset } from '../data/public-asset';
import { loadSiteData } from '../data/site';
import type { CityView, SiteView } from '../data/site';
import { publicHtmlPath } from '../data/public-url';
interface Props { city?: CityView; site: SiteView }
const { city, site } = Astro.props as Props;
const { cities } = await loadSiteData();
const activeCity = city || cities.find((item) => item.slug === 'moskva');
const currentCityHome = city && Astro.url.pathname === publicHtmlPath(city.slug);
const localCheck = Astro.url.pathname === '/' || currentCityHome;
const cityPath = activeCity ? publicHtmlPath(activeCity.slug) : null;
const addressHref = localCheck && activeCity ? '#address-check' : cityPath ? `${cityPath}#address-check` : null;
const tariffHref = currentCityHome ? '#tariffs' : cityPath ? `${cityPath}#tariffs` : null;
const callbackHref = addressHref?.startsWith('#') ? addressHref : addressHref?.replace('#address-check', '?callback=1#address-check');
const supportHref = `tel:${site.supportPhone.replace(/[^+\d]/g, '')}`;
const connectionHref = `tel:${site.connectionPhone.replace(/[^+\d]/g, '')}`;
const navigation = [
  { label: 'Тарифы', href: tariffHref, anchor: 'tariffs' },
  { label: 'Города', href: '/goroda-obsluzhivaniya', anchor: '' },
  { label: 'Карта покрытия', href: '/karta-pokrytiya-provaydera', anchor: '' },
];
---
<header class="site-header" data-site-header>
  <div class="utility-line"><div class="header-container utility-inner">
    <button class="utility-link city-trigger" type="button" data-city-choice-trigger aria-haspopup="dialog" aria-controls="site-city-picker"><img src={publicAsset('/images/figma/map-pin.svg')} width="16" height="16" alt="" /><span>{activeCity?.name || 'Москва'}</span><img class="chevron" src={publicAsset('/images/figma/chevron-down.svg')} width="14" height="14" alt="" /><span class="sr-only"> — выбрать город</span></button>
    <div class="utility-actions">
      {addressHref ? <a class="utility-link" href={addressHref} data-address-focus><img src={publicAsset('/images/figma/search.svg')} width="16" height="16" alt="" />Проверить адрес</a> : <button type="button" class="utility-link" data-city-choice-trigger data-city-choice-anchor="address-check" aria-haspopup="dialog"><img src={publicAsset('/images/figma/search.svg')} width="16" height="16" alt="" />Проверить адрес</button>}
      <a class="utility-link support-link" href={supportHref}><img src={publicAsset('/images/figma/headphones.svg')} width="16" height="16" alt="" />Техподдержка</a>
    </div>
  </div></div>
  <div class="header-container main-line">
    <a class="brand" href="/" aria-label="Дом.ру — главная"><img src={publicAsset('/images/figma/domru-logo.png')} width="2071" height="682" alt="Дом.ру" /></a>
    <nav class="header-nav" aria-label="Основная навигация">
      {navigation.map((item) => item.href ? <a href={item.href}>{item.label}</a> : <button type="button" data-city-choice-trigger data-city-choice-anchor={item.anchor} aria-haspopup="dialog">{item.label}</button>)}
    </nav>
    <div class="header-actions">
      <a class="header-phone subscriber-phone" href={connectionHref} data-support-phone={site.supportPhone} data-support-phone-href={supportHref}>
        <img src={publicAsset('/images/figma/phone.svg')} width="22" height="22" alt="" />
        <span class="phone-copy"><span data-phone-value>{site.connectionPhone}</span><span class="phone-caption" data-phone-caption>Подключение</span></span>
      </a>
      {callbackHref ? <a class="callback-button" href={callbackHref} data-address-focus data-callback-intent>Заказать звонок</a> : <button type="button" class="callback-button" data-city-choice-trigger data-city-choice-anchor="address-check" data-callback-intent aria-haspopup="dialog">Заказать звонок</button>}
      <button type="button" class="menu-trigger" data-menu-trigger aria-haspopup="dialog" aria-controls="site-menu" aria-label="Открыть меню"><img src={publicAsset('/images/figma/menu.svg')} width="24" height="24" alt="" /></button>
    </div>
  </div>
</header>
<dialog id="site-city-picker" class="header-dialog" data-city-picker aria-labelledby="city-picker-title">
  <button type="button" class="dialog-close" data-header-dialog-close aria-label="Закрыть выбор города">×</button>
  <h2 id="city-picker-title">Выберите город</h2>
  <p data-city-choice-message>Тарифы и проверка подключения доступны на странице выбранного города.</p>
  <label for="site-city-search">Название города или региона</label>
  <input id="site-city-search" type="search" placeholder="Начните вводить название" data-city-search autocomplete="off" />
  <ul class="city-options">{cities.map((item) => <li data-city-option data-city-search-text={`${item.name} ${item.region.name}`}><a href={publicHtmlPath(item.slug)} data-city-choice-link>{item.name}<span>{item.region.name}</span></a></li>)}</ul>
  <p class="empty-cities" data-city-empty hidden>Город не найден. Попробуйте другое название.</p>
  {cities.length === 0 && <p>Опубликованных городов пока нет.</p>}
  <a class="directory-link" href="/goroda-obsluzhivaniya">Все города обслуживания</a>
</dialog>
<dialog id="site-menu" class="header-dialog menu-dialog" data-header-menu aria-labelledby="site-menu-title">
  <button type="button" class="dialog-close" data-header-dialog-close aria-label="Закрыть меню">×</button>
  <h2 id="site-menu-title">Меню</h2>
  <nav class="menu-nav" aria-label="Мобильная навигация">
    {navigation.map((item) => item.href ? <a href={item.href}>{item.label}</a> : <button type="button" data-city-choice-trigger data-city-choice-anchor={item.anchor} aria-haspopup="dialog">{item.label}</button>)}
    {addressHref ? <a href={addressHref} data-address-focus>Проверить адрес</a> : <button type="button" data-city-choice-trigger data-city-choice-anchor="address-check" aria-haspopup="dialog">Проверить адрес</button>}
    <a href={supportHref}>Техподдержка: {site.supportPhone}</a>
    {callbackHref ? <a class="callback-button" href={callbackHref} data-address-focus data-callback-intent>Заказать звонок</a> : <button type="button" class="callback-button" data-city-choice-trigger data-city-choice-anchor="address-check" data-callback-intent aria-haspopup="dialog">Заказать звонок</button>}
  </nav>
</dialog>
<script>
  import { initializeSiteHeader } from '../lib/site-header-client.mjs';
  initializeSiteHeader();
</script>
<style>
  .site-header { position: relative; z-index: 30; background: #fff; }
  .header-container { width: min(1360px, calc(100% - 32px)); margin: 0 auto; }
  button, a { -webkit-tap-highlight-color: transparent; }
  button { font: inherit; cursor: pointer; }
  .utility-line { height: 40px; border-bottom: 1px solid #f0f3f6; }
  .utility-inner { display: flex; justify-content: space-between; align-items: center; min-height: 39px; gap: 16px; }
  .utility-link { display: inline-flex; align-items: center; gap: 8px; border: 0; padding: 0; background: transparent; color: #526071; font-size: 13px; line-height: 18px; text-decoration: none; }
  .city-trigger { min-height: 36px; }
  .utility-actions { display: flex; gap: 24px; }
  .main-line { display: flex; align-items: center; min-height: 88px; gap: 56px; }
  .brand { display: flex; flex-shrink: 0; }
  .brand img { display: block; width: 157.9px; height: auto; }
  .header-nav { display: flex; align-items: center; gap: 22px; }
  .header-nav a, .header-nav button { border: 0; padding: 10px 0; background: transparent; color: #18202a; font-size: 12px; line-height: 16px; font-weight: 600; white-space: nowrap; text-decoration: none; }
  .header-actions { display: flex; align-items: center; gap: 28px; margin-left: auto; }
  .header-phone { display: flex; align-items: center; gap: 8px; text-decoration: none; white-space: nowrap; }
  .phone-copy { display: flex; flex-direction: column; gap: 2px; }
  [data-phone-value] { font-size: 17px; line-height: 20px; font-weight: 700; }
  .phone-caption { color: #526071; font-size: 12px; line-height: 16px; }
  .callback-button { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; border: 0; border-radius: 14px; padding: 14px 24px; background: #e0231e; color: #fff; font-size: 14px; line-height: 20px; font-weight: 600; text-decoration: none; white-space: nowrap; }
  .callback-button:hover { background: #c61e1a; }
  .menu-trigger { display: none; align-items: center; justify-content: center; width: 44px; height: 44px; flex-shrink: 0; padding: 0; border: 0; border-radius: 50%; background: #f0f3f6; }
  .header-dialog { position: relative; width: min(620px, calc(100% - 32px)); max-height: 85dvh; padding: 32px; border: 0; border-radius: 26px; background: #fff; color: #18202a; }
  .header-dialog::backdrop { background: rgb(15 23 42 / 62%); }
  .header-dialog h2 { margin: 0 44px 16px 0; font-size: 28px; line-height: 32px; }
  .header-dialog p { color: #526071; font-size: 14px; line-height: 20px; }
  .header-dialog label { display: block; margin: 16px 0 8px; font-size: 14px; font-weight: 600; }
  .header-dialog input { width: 100%; min-height: 48px; padding: 12px 16px; border: 1px solid #dcecf7; border-radius: 14px; font: inherit; }
  .dialog-close { position: absolute; right: 16px; top: 16px; width: 44px; height: 44px; border: 0; border-radius: 50%; background: #f0f3f6; font-size: 26px; }
  .city-options { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; padding: 0; margin: 20px 0; list-style: none; }
  .city-options a { display: flex; flex-direction: column; justify-content: center; min-height: 60px; gap: 4px; border-radius: 12px; padding: 8px 12px; text-decoration: none; overflow-wrap: anywhere; }
  .city-options a:hover { background: #eaf7ff; }
  .city-options span { color: #526071; font-size: 12px; }
  .directory-link { color: #1769aa; font-size: 14px; }
  .menu-nav { display: flex; flex-direction: column; gap: 8px; }
  .menu-nav a, .menu-nav button { min-height: 44px; display: flex; align-items: center; text-align: left; border: 0; border-radius: 12px; padding: 12px; text-decoration: none; font: inherit; background: #f6f7f9; }
  .menu-nav .callback-button { background: #e0231e; color: #fff; justify-content: center; }
  [hidden] { display: none !important; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  @media (max-width: 1100px) {
    .header-container { width: min(720px, calc(100% - 32px)); }
    .main-line { min-height: 80px; gap: 24px; }
    .brand img { width: 133.6px; }
    .header-actions { gap: 12px; }
    .header-phone { display: none; }
    .menu-trigger { display: flex; }
    .header-nav { gap: 18px; }
  }
  @media (max-width: 760px) { .header-nav { display: none; } }
  @media (max-width: 620px) {
    .utility-line { height: 36px; }
    .utility-inner { min-height: 35px; }
    .utility-actions .support-link { display: none; }
    .utility-link { font-size: 12px; }
    .city-trigger .chevron { display: none; }
    .main-line { min-height: 72px; gap: 12px; }
    .brand img { width: 109.32px; }
    .header-actions { gap: 12px; }
    .header-actions > .callback-button { display: none; }
    .header-phone { display: flex; gap: 6px; }
    .header-phone > img { width: 18px; height: 18px; }
    [data-phone-value] { font-size: 14px; line-height: 17px; }
    .phone-caption { font-size: 10px; line-height: 12px; }
    .header-dialog { padding: 24px 20px; }
    .city-options { grid-template-columns: 1fr; }
  }
  @media (max-width: 360px) { .header-phone > img { display: none; } [data-phone-value] { font-size: 12px; } .header-actions { gap: 6px; } }
</style>
