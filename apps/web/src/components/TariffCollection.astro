---
import TariffCollectionStyles from './TariffCollectionStyles.astro';
import { renderTariffCollection } from '../../../api/src/tariff-collection-model';
import type { TariffView } from '../data/tariff-view';
import { prepareCollectionScript } from '../lib/tariff-collection-prepaint.mjs';
interface Props { data: Record<string, unknown>; tariffs: TariffView[]; citySlug: string; cityName?: string; dialogId: string }
const { data, tariffs, citySlug, cityName, dialogId } = Astro.props;
---
<Fragment set:html={renderTariffCollection(data, tariffs, { interactive: true, citySlug, cityName, dialogId })} />
<script is:inline set:html={prepareCollectionScript}></script>
<script>
  import { initializeTariffCollections } from '../scripts/tariff-collection-client.mjs';
  initializeTariffCollections(document);
  document.addEventListener('astro:page-load', () => initializeTariffCollections(document));
</script>
<TariffCollectionStyles />
