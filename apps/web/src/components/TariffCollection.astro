---
import { renderTariffCollection } from '../../../api/src/tariff-collection-model';
import type { TariffView } from '../data/tariff-view';
interface Props { data: Record<string, unknown>; tariffs: TariffView[]; citySlug: string; dialogId: string }
const { data, tariffs, citySlug, dialogId } = Astro.props;
---
<Fragment set:html={renderTariffCollection(data, tariffs, { interactive: true, citySlug, dialogId })} />
<script>
  import { initializeTariffCollections } from '../scripts/tariff-collection-client.mjs';
  initializeTariffCollections(document);
  document.addEventListener('astro:page-load', () => initializeTariffCollections(document));
</script>
<style is:global>
  .tariff-collection { width: min(1360px, calc(100% - 64px)); margin: 32px auto 64px; border-radius: 28px; background: #eef8ff; color: #18202a; }
  .tariff-collection * { box-sizing: border-box; }
  .tariff-collection [hidden] { display: none !important; }
  .collection-container { padding: 32px; }
  .tariff-collection h2 { margin: 0; font-size: 32px; line-height: 38px; letter-spacing: -1.1px; font-weight: 700; }
  .collection-intro { max-width: 850px; margin: 12px 0 28px; color: #526071; font-size: 16px; line-height: 24px; }
  .collection-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin-top: 28px; }
  .collection-card { position: relative; display: flex; flex-direction: column; min-width: 0; min-height: 550px; padding: 58px 20px 24px; border: 1px solid #dcecf7; border-radius: 18px; background: #fff; box-shadow: 0 8px 24px #1528420d; }
  .collection-badge { position: absolute; top: 20px; left: 20px; max-width: calc(100% - 40px); border-radius: 6px; padding: 3px 8px; background: #eaf4ff; color: #0872c9; font-size: 11px; line-height: 15px; }
  .collection-heading h3 { margin: 0; font-size: 22px; line-height: 27px; letter-spacing: -.4px; font-weight: 700; overflow-wrap: anywhere; }
  .collection-heading p { margin: 8px 0 0; color: #526071; font-size: 13px; line-height: 18px; }
  .collection-metrics { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; margin-top: 22px; }
  .collection-metrics span, .collection-metrics small { display: block; color: #697789; font-size: 10px; line-height: 14px; }
  .collection-metrics strong { display: block; margin-top: 3px; font-size: 19px; line-height: 25px; }
  .collection-metrics div + div strong { font-size: 17px; line-height: 22px; }
  .collection-subscriptions { margin-top: 18px; }
  .collection-subscriptions p { margin: 0 0 8px; color: #697789; font-size: 11px; line-height: 15px; }
  .collection-subscriptions > div { display: flex; flex-wrap: wrap; gap: 6px; }
  .collection-subscription { padding: 3px 7px; border-radius: 6px; background: #eef3fa; color: #18202a; font-size: 10px; line-height: 15px; font-weight: 600; }
  .collection-subscription[data-cinema="ivi"] { background: #ea1647; color: #fff; }
  .collection-subscription[data-cinema="start"] { background: #000; color: #fff; }
  .collection-subscription[data-cinema="kion"] { background: #fff0ec; color: #b63315; }
  .collection-features { display: grid; gap: 8px; margin: 18px 0 22px; padding: 0; list-style: none; font-size: 12px; line-height: 17px; color: #526071; }
  .collection-features li { display: flex; gap: 8px; }
  .collection-features li::before { content: '✓'; color: #15803d; }
  .collection-price { margin-top: auto; padding: 20px 0 18px; border-top: 1px solid #e4edf5; }
  .collection-price > div { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; }
  .collection-price strong { font-size: 26px; line-height: 32px; letter-spacing: -.6px; }
  .collection-price p { margin: 6px 0 0; color: #697789; font-size: 11px; line-height: 15px; }
  .collection-promo { padding: 3px 7px; border-radius: 6px; background: #e7f5eb; color: #217442; font-size: 11px; line-height: 15px; }
  .collection-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .collection-connect, .collection-details, [data-collection-more] { display: flex; justify-content: center; align-items: center; min-height: 48px; padding: 10px 12px; border: 1px solid #dce6ee; border-radius: 14px; color: #18202a; background: #fff; font: inherit; font-size: 13px; font-weight: 600; text-decoration: none; cursor: pointer; text-align: center; overflow-wrap: anywhere; }
  .collection-connect { background: #eb3976; border-color: #eb3976; color: #fff; }
  .collection-actions :focus-visible, [data-collection-more]:focus-visible { outline: 3px solid #0872c9; outline-offset: 3px; }
  .collection-connect:hover { background: #ce2460; }
  .collection-details:hover, [data-collection-more]:hover { background: #edf5fc; }
  .collection-card-gaming { background: #18202a; color: #fff; border-color: #334155; }
  .collection-card-gaming .collection-heading p, .collection-card-gaming .collection-features, .collection-card-gaming .collection-price p, .collection-card-gaming .collection-metrics span, .collection-card-gaming .collection-metrics small, .collection-card-gaming .collection-subscriptions p { color: #b6c2d0; }
  .collection-card-gaming .collection-price { border-color: #334155; }
  .collection-more { display: flex; justify-content: center; margin-top: 24px; }
  [data-collection-more] { gap: 6px; min-width: 220px; }
  .collection-empty { margin: 28px 0 0; color: #526071; }
  .collection-mobile-guide { display: none; }
  .collection-sr-only { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @media (max-width: 1100px) { .tariff-collection { width: calc(100% - 48px); } .collection-container { padding: 24px; } .collection-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 620px) {
    .tariff-collection { width: calc(100% - 32px); margin: 24px auto 40px; border-radius: 24px; }
    .collection-container { padding: 24px 16px; }
    .tariff-collection h2 { font-size: 24px; line-height: 29px; letter-spacing: -.8px; }
    .collection-intro { font-size: 15px; line-height: 22px; margin-bottom: 20px; }
    .collection-mobile-guide { display: flex; justify-content: space-between; gap: 8px; font-size: 11px; line-height: 16px; color: #697789; margin-top: 20px; }
    .collection-grid { display: flex; overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x proximity; gap: 12px; margin-top: 12px; padding-bottom: 12px; }
    .collection-card { flex: 0 0 100%; scroll-snap-align: start; }
    [data-collection-more] { width: 100%; }
  }
</style>
