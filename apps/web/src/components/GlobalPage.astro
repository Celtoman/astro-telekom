---
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadSiteData, pageMeta, seoMeta } from '../data/site';
import { legalSections } from '../data/legal-pages';
import CitiesDirectory from './CitiesDirectory.astro';
import AddressForm from './AddressForm.astro';

interface Props {
  type: 'COVERAGE' | 'CITIES' | 'PRIVACY' | 'PERSONAL_DATA_CONSENT' | 'COOKIE_POLICY';
}

const { type } = Astro.props as Props;
const catalog = await loadSiteData();
const { site, cities, globalPages } = catalog;
const page = globalPages.find((candidate) => candidate.type === type);
if (!page) throw new Error(`Не опубликована обязательная общая страница Release 1: ${type}`);

const defaults = {
  COVERAGE: {
    title: 'Карта покрытия',
    description: 'Выберите город и проверьте возможность подключения Дом.ру по адресу.',
  },
  CITIES: {
    title: 'Города обслуживания',
    description: 'Опубликованные города, в которых можно проверить подключение Дом.ру.',
  },
  PRIVACY: {
    title: 'Политика конфиденциальности',
    description: 'Политика конфиденциальности сайта партнера Дом.ру.',
  },
  PERSONAL_DATA_CONSENT: {
    title: 'Согласие на обработку персональных данных',
    description: 'Согласие на обработку персональных данных на сайте партнера Дом.ру.',
  },
  COOKIE_POLICY: {
    title: 'Политика обработки файлов cookie',
    description: 'Правила использования файлов cookie на сайте партнера Дом.ру.',
  },
}[type];
const meta = seoMeta(catalog, `/${page.slug}`, pageMeta(page.title || defaults.title, defaults.description));
const contentText = typeof page.content?.text === 'string' ? page.content.text : '';
const richTextBlocks = (page.blocks || []).filter((block) => block.blockType === 'rich_text');
const isCoverage = type === 'COVERAGE';
const domain = Astro.site?.hostname || 'tv-internet-dom.ru';
const versionedLegalSections = legalSections(type, domain);
const apiUrl = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000/api/v1';
const publicSiteSlug = import.meta.env.PUBLIC_SITE_SLUG || 'domru-site';
const coverageDialogId = 'address-entry-coverage';
const defaultCoverageCity = cities[0];
---

<BaseLayout title={meta.title} description={meta.description} ogTitle={meta.ogTitle} ogDescription={meta.ogDescription} ogImage={meta.ogImage} indexable={meta.indexState !== 'NOINDEX'} {site}>
  {type === 'CITIES' ? <CitiesDirectory {cities} intro={contentText} /> : <section class="hero">
    <div class="container">
      <span class="eyebrow">Дом.ру</span>
      <h1>{page.title || defaults.title}</h1>
      {isCoverage && contentText && <p class="lead">{contentText}</p>}
    </div>
  </section>}
  {isCoverage ? <section class="section container">
    <h2>Проверка подключения по городам</h2>
    {cities.length > 0 ? <div class="grid">{cities.map((city) => <article class="card">
      <h3>{city.name}</h3>
      <p>Откройте страницу города и укажите адрес для проверки технической возможности.</p>
      <button
        class="card-link link-button"
        type="button"
        data-address-dialog-trigger={coverageDialogId}
        data-city-slug={city.slug}
        aria-label={`Проверить адрес в городе ${city.name}`}
      >Проверить адрес →</button>
    </article>)}</div> : <p class="lead">Опубликованных городов пока нет.</p>}
  </section> : type !== 'CITIES' && <section class="section container legal-copy">
    {contentText && versionedLegalSections.length === 0 && <p>{contentText}</p>}
    {versionedLegalSections.map((section) => <section><h2>{section.title}</h2>{section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}</section>)}
    {richTextBlocks.map((block) => {
      const title = typeof block.data.title === 'string' ? block.data.title : '';
      const text = typeof block.data.text === 'string' ? block.data.text : '';
      return <section>{title && <h2>{title}</h2>}{text && <p>{text}</p>}</section>;
    })}
    {!contentText && versionedLegalSections.length === 0 && richTextBlocks.length === 0 && <p class="lead">Содержание страницы пока не опубликовано.</p>}
  </section>}
  {isCoverage && defaultCoverageCity && (
    <AddressForm
      {apiUrl}
      siteSlug={publicSiteSlug}
      pageSlug=""
      city={defaultCoverageCity}
      {site}
      presentation="dialog"
      dialogId={coverageDialogId}
    />
  )}
</BaseLayout>

<style is:global>
  .link-button { border: 0; padding: 0; background: transparent; font: inherit; cursor: pointer; }
  .legal-copy { max-width: 880px; }
  .legal-copy section + section { margin-top: 32px; }
  .legal-copy p { color: #526071; font-size: 18px; line-height: 1.7; white-space: pre-line; }
</style>
