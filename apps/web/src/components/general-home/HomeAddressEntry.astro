---
import type { GeneralHomeDataByType } from '../../../../api/src/general-home-model';
import { renderAddressEntry } from '../../lib/general-home-render';
import { publicAsset } from '../../data/public-asset';
import HomeBlockStyles from './HomeBlockStyles.astro';
interface Props { content: GeneralHomeDataByType['home.address_check']; phone: string; phoneHref: string; callbackWithinMinutes?: number }
const { content, phone, phoneHref } = Astro.props;
const addressForm = await Astro.slots.render('address');
---
<Fragment set:html={renderAddressEntry(content, { asset: publicAsset, phone, phoneHref, callbackWithinMinutes: Astro.props.callbackWithinMinutes }, addressForm)} />
<HomeBlockStyles />
<style is:global>
  /* Paint the SSR block only after its final child has arrived. */
  .home-address:not(:has(> [data-address-render-complete])) { visibility: hidden; }
  .home-address { display: grid; grid-template-columns: minmax(0, 928fr) minmax(0, 408fr); align-items: stretch; gap: 24px; }
  .home-address-primary { position: relative; display: flex; flex-direction: column; justify-content: space-between; gap: 24px; min-height: 368px; min-width: 0; padding: 32px 32px 24px; border-radius: 24px; background: #eaf7ff; }
  .home-address-intro { display: flex; align-items: flex-start; gap: 32px; }
  .home-address-copy { display: flex; flex-direction: column; gap: 12px; width: 50%; min-width: 0; }
  .home-address .home-address-eyebrow { color: #526071; font-size: 13px; font-weight: 700; line-height: 18px; letter-spacing: .8px; }
  .home-address-art { position: absolute; right: 32px; top: -8px; width: 320px; height: 256.091px; margin: 0; }
  .home-address-art > img { display: block; width: 100%; height: auto; }
  .home-address-art figcaption { position: absolute; top: 184px; left: -104px; width: 172px; padding: 12px; border-radius: 14px; background: #fff; color: #526071; font-size: 14px; line-height: 20px; white-space: pre-line; overflow-wrap: anywhere; }
  .home-address-form-area { position: relative; width: 100%; }
  .home-address .home-address-form-area .home-entry { margin: 0; }
  .home-address .home-entry .address-form { display: grid; grid-template-columns: minmax(0, 1fr) 200px; max-width: none; gap: 8px 16px; padding: 0; margin: 0; border: 0; background: none; box-shadow: none; }
  .home-address .home-entry .address-form > label { grid-column: 1 / -1; font-size: 14px; font-weight: 600; line-height: 20px; }
  .home-address .home-entry .address-field { position: relative; grid-column: 1; grid-row: 2; }
  .home-address .home-entry .address-icon { position: absolute; left: 16px; top: 14px; width: 20px; height: 20px; pointer-events: none; }
  .home-address .home-entry .address-form input[name="address"], .home-address .home-entry .address-form input[type="text"] { min-width: 0; width: 100%; height: 48px; padding: 11px 16px 11px 46px; border: 1px solid #f0f3f6; border-radius: 14px; background: #fff; color: #18202a; font: inherit; font-size: 16px; line-height: 24px; }
  .home-address .home-entry input::placeholder { color: #5c6b7d; opacity: 1; }
  .home-address .home-entry .address-form > .button { grid-column: 2; grid-row: 2; width: 200px; min-width: 0; min-height: 48px; padding: 14px 24px; border: 0; border-radius: 14px; background: #e0231e; color: #fff; font: inherit; font-size: 14px; font-weight: 600; line-height: 20px; }
  .home-address .home-entry .address-hint:not([data-state]) { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .home-address .home-entry .address-hint, .home-address .home-entry .form-result { grid-column: 1 / -1; }
  .home-address .home-entry .form-result:empty { display: none; }
  .home-address .home-address-reassurance { display: flex; align-items: flex-start; gap: 12px; min-height: 24px; margin-top: 16px; font-size: 14px; line-height: 20px; }
  .home-address-reassurance picture, .home-address-reassurance img { display: block; flex: 0 0 24px; width: 24px; height: 24px; }
  .home-address-specialist { display: flex; flex-direction: column; justify-content: space-between; gap: 8px; min-width: 0; min-height: 368px; padding: 32px 32px 24px; border-radius: 24px; background: #ffeae9; }
  .home-address-specialist-copy { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
  .home-address #home-address-help-title { font-size: 24px; line-height: 29px; letter-spacing: -.5px; white-space: pre-line; overflow-wrap: anywhere; }
  .home-address-contact { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
  .home-address-phone { display: flex; align-items: center; gap: 12px; padding: 8px; border-radius: 14px; background: #fff; color: #18202a; text-decoration: none; }
  .home-address-phone-icon, .home-address-phone-icon img { display: block; flex: 0 0 40px; width: 40px; height: 40px; }
  .home-address-phone > span { display: flex; flex-direction: column; min-width: 0; }
  .home-address-phone > span > span { color: #526071; font-size: 16px; line-height: 24px; }
  .home-address-phone strong { font-size: 24px; line-height: 29px; letter-spacing: -.5px; overflow-wrap: anywhere; }
  .home-address-phone small { color: #526071; font-size: 12px; line-height: 16px; }
  .home-address .home-action.home-secondary-action { color: #1769aa; background: #eef8ff; }
  .home-address .home-action.home-secondary-action:hover { background: #dcecf7; }
  .home-address .home-address-response { display: flex; align-items: flex-start; gap: 12px; min-height: 28px; padding-top: 4px; font-size: 14px; line-height: 20px; }
  .home-address-response .home-static-icon { flex: 0 0 20px; width: 20px; height: 20px; }
  .home-address :is(a, button):not(.public-dialog *):focus-visible { outline: 2px solid #1769aa; outline-offset: 2px; }
  @media (max-width: 1100px) {
    .home-address { grid-template-columns: minmax(0, 1fr); }
    .home-address-primary { min-height: 0; padding: 24px; }
    .home-address-intro { gap: 24px; }
    .home-address-copy { flex: 1; width: auto; }
    .home-address-art { position: relative; flex: 0 0 200px; right: auto; top: auto; width: 200px; height: 160.057px; }
    .home-address-art figcaption { left: -12px; top: 146px; }
    .home-address-specialist { display: grid; grid-template-columns: minmax(0, 1fr) 320px; align-items: start; gap: 24px; min-height: 0; padding: 24px; }
  }
  @media (max-width: 620px) {
    .home-address { gap: 16px; }
    .home-address-primary { padding: 20px; }
    .home-address-art { display: none; }
    .home-address #home-address-title, .home-address #home-address-help-title { font-size: 20px; line-height: 25px; letter-spacing: -.2px; }
    .home-address .home-entry .address-form { grid-template-columns: minmax(0, 1fr); row-gap: 12px; }
    .home-address .home-entry .address-form > label { margin-bottom: -4px; }
    .home-address .home-entry .address-form > .button { grid-column: 1; grid-row: 3; width: 100%; }
    .home-address .home-address-reassurance { gap: 8px; min-height: 20px; margin-top: 12px; }
    .home-address-reassurance picture, .home-address-reassurance img { flex-basis: 20px; width: 20px; height: 20px; }
    .home-address-specialist { grid-template-columns: minmax(0, 1fr); gap: 24px; padding: 20px; }
    .home-address-phone { gap: 8px; }
    .home-address-phone-icon, .home-address-phone-icon img { flex-basis: 24px; width: 24px; height: 24px; }
    .home-address-phone strong { font-size: 20px; line-height: 25px; letter-spacing: -.2px; }
    .home-address .home-address-response { gap: 8px; }
  }
</style>
