---
import type { GeneralHomeDataByType } from '../../../../api/src/general-home-model';
import { renderCityDirectory, type HomeDirectoryCity } from '../../lib/general-home-render';
import { publicAsset } from '../../data/public-asset';
import HomeBlockStyles from './HomeBlockStyles.astro';
interface Props { content: GeneralHomeDataByType['home.city_directory']; cities: HomeDirectoryCity[] }
---
<Fragment set:html={renderCityDirectory(Astro.props.content, Astro.props.cities, { asset: publicAsset })} />
<HomeBlockStyles />
<script>
  import { initializeHomeDirectories } from '../../lib/general-home-directory.mjs';
  initializeHomeDirectories();
  document.addEventListener('astro:page-load', () => initializeHomeDirectories());
</script>
<style is:global>
  .home-directory { display: flex; flex-direction: column; gap: 24px; padding: 48px; border-radius: 26px; background: #fff; }
  .home-directory-intro { display: flex; flex-direction: column; gap: 16px; width: 100%; }
  .home-directory .home-section-intro { gap: 8px; }
  .home-directory-search { display: flex; align-items: center; gap: 8px; width: min(440px, 100%); min-height: 48px; padding: 0 12px; border: 1px solid #dcecf7; border-radius: 10px; background: #fff; }
  .home-directory-search img { flex: 0 0 24px; }
  .home-directory-search input { flex: 1; width: 0; min-width: 0; height: 46px; padding: 0; border: 0; border-radius: 0; color: #18202a; background: transparent; font: inherit; font-size: 16px; line-height: 24px; }
  .home-directory-search input::placeholder { color: #526071; opacity: 1; }
  .home-directory-search:focus-within { outline: 2px solid #1769aa; outline-offset: 2px; }
  .home-directory-search input:focus { outline: 0; }
  .home-directory-alphabet { display: flex; flex-wrap: wrap; gap: 8px; width: 100%; }
  .home-directory-alphabet button { flex: 0 0 44px; min-width: 44px; height: 44px; padding: 0; border: 0; border-radius: 14px; background: #eef8ff; color: #1769aa; font: inherit; font-size: 14px; font-weight: 600; line-height: 20px; cursor: pointer; }
  .home-directory-alphabet button:first-child { flex-basis: 60px; }
  .home-directory-alphabet button[aria-pressed="true"] { color: #fff; background: #e0231e; }
  .home-directory .home-directory-status { font-size: 14px; line-height: 20px; }
  .home-city-list { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px 16px; width: 100%; margin: 0; padding: 0; list-style: none; }
  .home-city-list li { min-width: 0; }
  .home-city-list a { display: flex; align-items: center; min-height: 48px; padding: 12px; border-radius: 10px; color: #18202a; font-size: 16px; line-height: 24px; text-decoration: none; overflow-wrap: anywhere; }
  .home-city-list a:hover { color: #1769aa; background: #eef8ff; }
  .home-directory-actions { display: flex; justify-content: center; width: 100%; }
  .home-directory .home-secondary-action { color: #1769aa; background: #eef8ff; }
  .home-directory .home-secondary-action:hover { background: #dcecf7; }
  .home-directory :is(a, button):focus-visible { outline: 2px solid #1769aa; outline-offset: 2px; }
  .home-sr-only { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .home-directory [hidden] { display: none !important; }
  .home-directory-count-1, .home-directory-count-2 { display: none; }
  .home-directory[data-directory-preview] .home-city-list li:nth-child(n+25) { display: none; }
  @media (max-width: 1100px) {
    .home-directory { padding: 32px; }
    .home-directory-search { width: 100%; }
    .home-city-list { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .home-directory-count-0 { display: none; }
    .home-directory-count-1 { display: inline; }
    .home-directory[data-directory-preview] .home-city-list li:nth-child(n+19) { display: none; }
  }
  @media (max-width: 620px) {
    .home-directory { gap: 20px; padding: 20px; }
    .home-directory-search { width: 100%; }
    .home-directory-alphabet { flex-wrap: nowrap; gap: 12px; height: 44px; overflow-x: auto; overflow-y: hidden; scrollbar-width: none; }
    .home-directory-alphabet::-webkit-scrollbar { display: none; }
    .home-city-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .home-directory-actions .home-action { width: 100%; }
    .home-directory-actions > .home-directory-count-2 { width: 100%; }
    .home-directory-count-1 { display: none; }
    .home-directory-count-2 { display: inline; }
    .home-directory[data-directory-preview] .home-city-list li:nth-child(n+13) { display: none; }
  }
</style>
