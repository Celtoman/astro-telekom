---
import type { GeneralHomeDataByType } from '../../../../api/src/general-home-model';
import { renderHomeFaq } from '../../lib/general-home-render';
import { publicAsset } from '../../data/public-asset';
import HomeBlockStyles from './HomeBlockStyles.astro';
interface Props { content: GeneralHomeDataByType['home.faq']; firstOpen?: boolean; phoneLinks?: readonly string[]; answerRenderer?: (value:string)=>string }
---
<Fragment set:html={renderHomeFaq(Astro.props.content, { asset: publicAsset, firstFaqOpen: Astro.props.firstOpen, faqPhoneLinks: Astro.props.phoneLinks, faqAnswerRenderer: Astro.props.answerRenderer })} />
<HomeBlockStyles />
<style is:global>
  .home-faq { display: flex; flex-direction: column; gap: 24px; padding: 32px; border-radius: 26px; background: #eef8ff; }
  .home-faq h2 { padding-left: 16px; }
  .home-faq-stack { display: flex; flex-direction: column; gap: 12px; width: 100%; }
  .home-faq-item { min-width: 0; border: 1px solid #dcecf7; border-radius: 14px; background: #fff; }
  .home-faq-question { display: flex; align-items: flex-start; gap: 12px; width: 100%; min-height: 56px; padding: 16px 20px; border-radius: 14px; color: #18202a; cursor: pointer; list-style: none; }
  .home-faq-question::-webkit-details-marker { display: none; }
  .home-faq-question > span { flex: 1; min-width: 0; font-size: 16px; font-weight: 600; line-height: 24px; overflow-wrap: anywhere; }
  .home-faq-question img { display: block; flex: 0 0 20px; width: 20px; height: 20px; margin-top: 2px; }
  .home-faq-question .home-faq-minus, .home-faq-item[open] .home-faq-plus { display: none; }
  .home-faq-item[open] .home-faq-minus { display: block; }
  .home-faq-answer { padding: 0 20px 20px; }
  .home-faq-question:focus-visible { outline: 3px solid #1769aa; outline-offset: 2px; }
  @media (min-width: 621px) and (max-width: 1100px) {
    .home-faq { padding: 24px; }
    .home-faq h2 { padding-left: 8px; }
  }
  @media (max-width: 620px) {
    .home-faq { padding: 16px; }
    .home-faq h2 { padding-left: 4px; }
    .home-faq-question { gap: 8px; padding: 16px; }
    .home-faq-answer { padding: 0 16px 16px; }
  }
</style>
