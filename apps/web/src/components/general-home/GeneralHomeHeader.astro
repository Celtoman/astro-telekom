---
import type { SiteView, CityView } from '../../data/site';
import { renderHomeHeader } from '../../lib/general-home-shell';
import { publicAsset } from '../../data/public-asset';
import { publishedMoscow } from '../../lib/city-context.mjs';
import CityPicker from '../CityPicker.astro';
import HomeShellStyles from './HomeShellStyles.astro';
import { prepareHeaderScript } from '../../lib/public-shell-state.mjs';
interface Props { globalFaq?: boolean; site: SiteView; cities: CityView[]; city?: CityView; addressDialogId?: string | null; localSections?: string[]; addressPageSlug?: string; supportPageSlug?:string; citySwitchPath?: string }
const { site, cities, addressDialogId, localSections } = Astro.props as Props;
const city = Astro.props.city ?? publishedMoscow(cities) ?? undefined;
---
<Fragment set:html={renderHomeHeader(site, { city, globalFaq: Astro.props.globalFaq, routeCity: Astro.props.city?.slug, localSections, addressDialogId, addressPageSlug: Astro.props.addressPageSlug, supportPageSlug:Astro.props.supportPageSlug, citySwitchPath: Astro.props.citySwitchPath, asset: publicAsset })} />
<script is:inline set:html={prepareHeaderScript}></script>
<CityPicker {cities} current={city} />
<HomeShellStyles />
<script>
  import { initializeSiteHeader } from '../../lib/site-header-client.mjs';
  initializeSiteHeader();
</script>
