---
import '../styles/global.css';
import { PublicationApp } from '../components/PublicationApp';
const apiUrl = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000/api/v1';
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Публикация сайта · Дом.ру Платформа</title>
  </head>
  <body><PublicationApp apiUrl={apiUrl} client:load /></body>
</html>
