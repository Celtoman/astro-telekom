---
import '../../styles/global.css';
import { AdminWorkspace } from '../../components/AdminWorkspace';
import AdminRuntime from '../../components/AdminRuntime.astro';

const apiUrl = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000/api/v1';
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Импорт тарифов · Дом.ру Платформа</title>
  <AdminRuntime /></head>
  <body>
    <AdminWorkspace apiUrl={apiUrl} initialPath="/tariffs/import" client:load />
  </body>
</html>
