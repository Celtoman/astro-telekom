---
import '@tabler/icons-webfont/dist/tabler-icons.min.css';
const apiUrl = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000/api/v1';
const providerId = import.meta.env.PUBLIC_PROVIDER_ID || '';
const siteId = import.meta.env.PUBLIC_SITE_ID || '';
---
<!doctype html>
<html lang="ru">
  <head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="color-scheme" content="light dark" /><title>Дом.ру · Платформа</title></head>
  <body>
    <div class="app" id="app">
      <aside class="sidebar">
        <div class="brand-row"><a class="brand" href="#overview"><span class="mark">д</span><span class="brand-name"><b>Дом.ру</b><small>Платформа</small></span></a><button class="icon" id="collapse" aria-label="Свернуть меню"><i class="ti ti-layout-sidebar-left-collapse"></i></button></div>
        <nav>
          <button class="nav active" data-view="overview"><i class="ti ti-layout-dashboard"></i><span>Обзор</span></button>
          <p>Контент</p><button class="nav" data-view="cities"><i class="ti ti-building-community"></i><span>Города</span></button><button class="nav" data-view="pages"><i class="ti ti-files"></i><span>Страницы и шаблоны</span></button><button class="nav" data-view="blocks"><i class="ti ti-stack-2"></i><span>Блоки</span></button><button class="nav" data-view="seo"><i class="ti ti-chart-dots-3"></i><span>SEO</span></button><button class="nav" data-view="redirects"><i class="ti ti-arrow-forward-up-double"></i><span>Редиректы</span></button><button class="nav" data-view="variables"><i class="ti ti-brackets-contain"></i><span>Переменные</span></button>
          <p>Предложения</p><button class="nav" data-view="tariffs"><i class="ti ti-package"></i><span>Каталог тарифов</span></button><button class="nav" data-view="imports"><i class="ti ti-file-upload"></i><span>Импорты</span><b>2</b></button><button class="nav" data-view="history"><i class="ti ti-history"></i><span>История изменений</span></button>
          <p>Контроль</p><button class="nav" data-view="leads"><i class="ti ti-inbox"></i><span>Заявки</span><b class="danger">12</b></button><button class="nav" data-view="analytics"><i class="ti ti-chart-bar"></i><span>Аналитика</span></button>
          <p>Система</p><button class="nav" data-view="integrations"><i class="ti ti-plug-connected"></i><span>Интеграции</span></button><button class="nav" data-view="activity"><i class="ti ti-list-details"></i><span>Журнал действий</span></button><button class="nav" data-view="settings"><i class="ti ti-settings"></i><span>Настройки</span></button>
        </nav>
        <div class="service"><i></i><span>Все сервисы доступны</span></div>
      </aside>
      <main class="main">
        <header class="topbar"><button class="icon mobile" aria-label="Меню"><i class="ti ti-menu-2"></i></button><button class="search" id="search"><i class="ti ti-search"></i><span>Поиск города, тарифа или команды</span><kbd>⌘ J</kbd></button><div class="top-actions"><button class="icon bell" aria-label="Уведомления"><i class="ti ti-bell"></i><b>3</b></button><button class="theme" id="theme"><i class="ti ti-sun"></i><span>Светлая</span></button><button class="profile"><span class="avatar">АБ</span><span><strong>Александр</strong><small>Администратор</small></span><i class="ti ti-chevron-down"></i></button></div></header>
        <div class="content">
          <section class="view active" id="overview"><div class="head"><div><p class="eyebrow">Дом.ру · все города</p><h1>Обзор</h1><p>Состояние каталога, заявок и публикаций за последние 30 дней.</p></div><div class="actions"><button class="button secondary" data-open="analytics"><i class="ti ti-chart-line"></i>Отчет</button><button class="button primary" data-open="imports"><i class="ti ti-file-upload"></i>Импортировать тарифы</button></div></div>
            <div class="metrics"><button class="metric" data-open="leads"><i class="metric-icon blue ti ti-inbox"></i><span><small>Новые заявки</small><strong>128</strong><em class="good">+18,6%</em></span><i class="ti ti-arrow-up-right"></i></button><button class="metric" data-open="cities"><i class="metric-icon violet ti ti-building-community"></i><span><small>Опубликованные города</small><strong>498</strong><em>из 512</em></span><i class="ti ti-arrow-up-right"></i></button><button class="metric" data-open="tariffs"><i class="metric-icon orange ti ti-package"></i><span><small>Активные тарифы</small><strong>5 084</strong><em class="good">+214 за период</em></span><i class="ti ti-arrow-up-right"></i></button><button class="metric" data-open="analytics"><i class="metric-icon green ti ti-percentage"></i><span><small>Конверсия формы</small><strong>3,42%</strong><em class="good">+0,28 п.п.</em></span><i class="ti ti-arrow-up-right"></i></button></div>
            <div class="two"><article class="panel chart-panel"><div class="panel-head"><div><h2>Заявки и звонки</h2><p>30 дней · предыдущий период</p></div><button class="select">30 дней <i class="ti ti-chevron-down"></i></button></div><div class="legend"><span><i class="blue-line"></i>Форма <b>1 248</b></span><span><i class="grey-line"></i>Телефон <b>2 916</b></span></div><div class="chart"><div class="grid-lines"><i></i><i></i><i></i><i></i><i></i></div><div class="bars"><i style="height:35%"></i><i style="height:46%"></i><i style="height:40%"></i><i style="height:64%"></i><i style="height:53%"></i><i style="height:73%"></i><i style="height:62%"></i><i style="height:88%"></i><i style="height:79%"></i><i style="height:96%"></i><i style="height:68%"></i><i style="height:84%"></i><i style="height:77%"></i><i style="height:100%"></i></div><div class="chart-labels"><span>08 авг</span><span>14 авг</span><span>20 авг</span><span>26 авг</span><span>01 сен</span><span>07 сен</span></div></div></article>
              <article class="panel"><div class="panel-head"><div><h2>Требует внимания</h2><p>7 задач ожидают решения</p></div><button class="icon"><i class="ti ti-arrow-up-right"></i></button></div><div class="attention"><button data-open="leads"><i class="attention-icon red ti ti-send-off"></i><span><strong>3 заявки не переданы</strong><small>Ошибка Tarifnik более 30 минут</small></span><i class="ti ti-chevron-right"></i></button><button data-open="imports"><i class="attention-icon orange ti ti-alert-triangle"></i><span><strong>2 импорта с предупреждениями</strong><small>Нужна проверка перед применением</small></span><i class="ti ti-chevron-right"></i></button><button data-open="tariffs"><i class="attention-icon violet ti ti-currency-ruble-off"></i><span><strong>18 тарифов без цены</strong><small>Публикация приостановлена</small></span><i class="ti ti-chevron-right"></i></button><button data-open="cities"><i class="attention-icon blue ti ti-file-text"></i><span><strong>9 городов без SEO-полей</strong><small>Нужна ручная проверка</small></span><i class="ti ti-chevron-right"></i></button></div></article></div>
            <div class="two lower"><article class="panel"><div class="panel-head"><div><h2>Последние изменения тарифов</h2><p>Импорт «Дом.ру · 07.09.2026»</p></div><button class="text-btn" data-open="history">Вся история</button></div><div class="activity"><div><i class="dot green"></i><p><strong>Гига 500</strong><small>Казань · цена изменена с 950 ₽ на 890 ₽</small></p><time>12:42</time></div><div><i class="dot blue"></i><p><strong>Мега 300 + Movix</strong><small>Набережные Челны · создан тариф</small></p><time>12:39</time></div><div><i class="dot orange"></i><p><strong>Интернет 100</strong><small>Барнаул · снят с публикации</small></p><time>12:31</time></div></div></article><article class="panel"><div class="panel-head"><div><h2>Конверсия страниц</h2><p>От визитов за 30 дней</p></div><button class="text-btn" data-open="analytics">Открыть аналитику</button></div><div class="conversion"><div><span>Карточки тарифов</span><b><i style="width:78%"></i></b><strong>4,8%</strong></div><div><span>Интернет + ТВ</span><b><i style="width:62%"></i></b><strong>3,8%</strong></div><div><span>Домашний интернет</span><b><i style="width:44%"></i></b><strong>2,7%</strong></div><div><span>Проверка адреса</span><b><i style="width:31%"></i></b><strong>1,9%</strong></div></div></article></div>
          </section>

          <section class="view" id="cities"><div class="head"><div><p class="eyebrow">Контент</p><h1>Города</h1><p>512 городов · 498 опубликовано · изменено сегодня, 12:42</p></div><div class="actions"><input id="city-file" type="file" accept=".xlsx,.xls" hidden /><button class="button secondary" id="choose-city-file"><i class="ti ti-file-spreadsheet"></i>Импорт XLS</button><button class="button primary"><i class="ti ti-plus"></i>Создать город</button></div></div><div class="panel table-panel"><div class="toolbar"><label class="search-input"><i class="ti ti-search"></i><input placeholder="Найти город или slug" /></label><button class="filter"><i class="ti ti-adjustments-horizontal"></i>Фильтры <b>2</b></button><button class="reset">Сбросить фильтры</button><span>Показано 20 из 512</span></div><div class="scroll"><table><thead><tr><th>Город</th><th>Регион</th><th>Публикация</th><th>Тарифы</th><th>SEO</th><th>Последнее изменение</th><th></th></tr></thead><tbody><tr data-drawer="city"><td><strong>Казань</strong><small>kazan</small></td><td>Республика Татарстан</td><td><em class="status success"><i class="ti ti-circle-check"></i>Опубликован</em></td><td>34</td><td><em class="status success">Заполнено</em></td><td>Сегодня, 11:54</td><td><button class="row"><i class="ti ti-edit"></i></button></td></tr><tr data-drawer="city"><td><strong>Набережные Челны</strong><small>naberezhnye-chelny</small></td><td>Республика Татарстан</td><td><em class="status success">Опубликован</em></td><td>27</td><td><em class="status warning"><i class="ti ti-alert-triangle"></i>2 поля</em></td><td>Сегодня, 10:22</td><td><button class="row"><i class="ti ti-edit"></i></button></td></tr><tr data-drawer="city"><td><strong>Барнаул</strong><small>barnaul</small></td><td>Алтайский край</td><td><em class="status draft"><i class="ti ti-pencil"></i>Черновик</em></td><td>18</td><td><em class="status success">Заполнено</em></td><td>Вчера, 17:38</td><td><button class="row"><i class="ti ti-edit"></i></button></td></tr></tbody></table></div><div class="pagination"><span>Страница 1 из 26</span><button>1</button><button>2</button><button>3</button><button><i class="ti ti-chevron-right"></i></button></div></div></section>

          <section class="view" id="tariffs"><div class="head"><div><p class="eyebrow">Предложения</p><h1>Каталог тарифов</h1><p>5 084 тарифа · последняя загрузка сегодня в 12:42</p></div><div class="actions"><button class="button secondary" id="select-mode"><i class="ti ti-checklist"></i>Выбрать</button><button class="button primary" data-open="imports"><i class="ti ti-file-upload"></i>Импортировать</button></div></div><div class="panel table-panel" id="tariff-panel"><div class="toolbar"><label class="search-input"><i class="ti ti-search"></i><input placeholder="Название, slug или город" /></label><button class="filter"><i class="ti ti-adjustments-horizontal"></i>Фильтры <b>4</b></button><button class="reset">Сбросить фильтры</button><span>Показано 50 из 5 084</span></div><div class="scroll"><table><thead><tr><th class="checks"><input type="checkbox" /></th><th>Тариф</th><th>Город</th><th>Услуга</th><th>Скорость</th><th>Цена</th><th>Акция</th><th>Статус</th><th></th></tr></thead><tbody><tr data-drawer="tariff"><td class="checks"><input type="checkbox" /></td><td><strong>Гига 500</strong><small>giga-500-pon</small></td><td>Казань</td><td>Интернет</td><td>500 Мбит/с</td><td><strong>890 ₽</strong><small>950 ₽</small></td><td>3 мес.</td><td><em class="status success"><i class="ti ti-circle-check"></i>Показан</em></td><td><button class="row"><i class="ti ti-edit"></i></button></td></tr><tr data-drawer="tariff"><td class="checks"><input type="checkbox" /></td><td><strong>Мега 300 + Movix</strong><small>mega-300-pon</small></td><td>Казань</td><td>Интернет + ТВ</td><td>300 Мбит/с</td><td><strong>950 ₽</strong></td><td>6 мес.</td><td><em class="status success">Показан</em></td><td><button class="row"><i class="ti ti-edit"></i></button></td></tr><tr data-drawer="tariff"><td class="checks"><input type="checkbox" /></td><td><strong>Гига 100</strong><small>giga-100-fttb</small></td><td>Набережные Челны</td><td>Интернет</td><td>100 Мбит/с</td><td><strong>650 ₽</strong></td><td>Нет</td><td><em class="status warning"><i class="ti ti-alert-triangle"></i>Без SEO</em></td><td><button class="row"><i class="ti ti-edit"></i></button></td></tr></tbody></table></div><div class="bulk" id="bulk"><span><b id="selected">0</b> тарифов выбрано</span><button>Опубликовать</button><button>Изменить SEO</button><button class="danger-text">Удалить</button></div><div class="pagination"><span>Страница 1 из 102</span><button>1</button><button>2</button><button>3</button><button><i class="ti ti-chevron-right"></i></button></div></div></section>

          <section class="view" id="imports"><div class="head"><div><p class="eyebrow">Предложения</p><h1>Импорт тарифов</h1><p>Загрузка, проверка, отчет изменений и применение пакета.</p></div><input id="tariff-file" type="file" accept=".xlsx,.xls" hidden /><button class="button primary" id="choose-import-file"><i class="ti ti-file-upload"></i>Выбрать XLS/XLSX</button></div><div class="import-grid"><article class="panel import-card"><ol class="steps"><li class="done"><b>1</b><span><strong>Файл загружен</strong><small id="import-file-name">Файл еще не выбран</small></span><i class="ti ti-circle-check"></i></li><li class="current"><b>2</b><span><strong>Валидация данных</strong><small id="import-validation-state">Обязательные поля, цены, статусы и бизнес-ключи</small></span><i class="ti ti-loader-2"></i></li><li><b>3</b><span><strong>Отчет изменений</strong><small>Новые, обновленные и пропущенные строки</small></span></li><li><b>4</b><span><strong>Подтверждение импорта</strong><small>Изменения появятся после применения</small></span></li></ol><div class="validation"><div><i class="ti ti-circle-check"></i><b id="import-valid-count">—<small>готовы к импорту</small></b></div><div><i class="ti ti-alert-triangle"></i><b id="import-warning-count">—<small>предупреждений</small></b></div><div><i class="ti ti-circle-x"></i><b id="import-error-count">—<small>ошибок</small></b></div></div><div class="import-actions"><button class="button secondary" id="download-import-report" disabled><i class="ti ti-download"></i>Скачать отчет</button><button class="button primary" id="apply-import" disabled>Применить подтвержденные строки <i class="ti ti-arrow-right"></i></button></div></article><aside class="panel import-history"><div class="panel-head"><div><h2>Последние импорты</h2><p>История хранится в API</p></div></div><div id="import-history-list"><p class="history-empty">Выберите файл для запуска проверки.</p></div></aside></div></section>

          <section class="view" id="leads"><div class="head"><div><p class="eyebrow">Контроль</p><h1>Заявки</h1><p>128 новых обращений за 30 дней · 3 требуют ручной отправки</p></div><button class="button primary" data-open="analytics"><i class="ti ti-chart-line"></i>Аналитика заявок</button></div><div class="panel table-panel"><div class="toolbar"><label class="search-input"><i class="ti ti-search"></i><input placeholder="Телефон, адрес или ID заявки" /></label><button class="filter"><i class="ti ti-adjustments-horizontal"></i>Фильтры <b>3</b></button><button class="reset">Сбросить фильтры</button><span>Показано 20 из 1 248</span></div><div class="scroll"><table><thead><tr><th>Время</th><th>Контакт</th><th>Город и адрес</th><th>Страница</th><th>Тариф</th><th>Проверки</th><th>Передача</th><th>Статус</th><th></th></tr></thead><tbody><tr data-drawer="lead"><td><strong>12:42</strong><small>Сегодня</small></td><td><strong>+7 927 410-••-18</strong><small>Новая заявка</small></td><td>Казань<small>ул. Чистопольская, 60</small></td><td>/kazan/internet/</td><td>Гига 500</td><td><em class="status success">Адрес найден</em></td><td><em class="status success">Передана</em></td><td><em class="status success">Новая</em></td><td><button class="row"><i class="ti ti-chevron-right"></i></button></td></tr><tr data-drawer="lead"><td><strong>12:19</strong><small>Сегодня</small></td><td><strong>+7 917 512-••-09</strong><small>Яндекс · cpc</small></td><td>Набережные Челны<small>пр-т Мира, 50</small></td><td>/naberezhnye-chelny/</td><td>Мега 300</td><td><em class="status success">Адрес найден</em></td><td><em class="status danger">Ошибка</em></td><td><em class="status warning">Повтор</em></td><td><button class="row"><i class="ti ti-chevron-right"></i></button></td></tr></tbody></table></div></div></section>

          <section class="view" id="pages"><div class="head"><div><p class="eyebrow">Контент · Казань</p><h1>Главная города</h1><p>Черновик изменен 12 минут назад · шаблон «Городская главная v4»</p></div><div class="actions"><button class="button secondary"><i class="ti ti-device-desktop"></i>Предпросмотр</button><button class="button primary"><i class="ti ti-world-upload"></i>Опубликовать</button></div></div><div class="editor"><aside class="tree"><div class="editor-head"><b>Структура</b><button class="icon"><i class="ti ti-plus"></i></button></div><button class="block active"><i class="ti ti-grip-vertical"></i><i class="ti ti-layout-navbar"></i><span>Первый экран<small>Наследуется от города</small></span><i class="ti ti-dots"></i></button><button class="block"><i class="ti ti-grip-vertical"></i><i class="ti ti-packages"></i><span>Подборка тарифов<small>Локальное переопределение</small></span><i class="ti ti-dots"></i></button><button class="block"><i class="ti ti-grip-vertical"></i><i class="ti ti-map-pin"></i><span>Проверка адреса<small>Шаблон сайта</small></span><i class="ti ti-dots"></i></button></aside><div class="preview"><div class="preview-head"><span>Предпросмотр</span><span><button class="device active"><i class="ti ti-device-desktop"></i></button><button class="device"><i class="ti ti-device-tablet"></i></button><button class="device"><i class="ti ti-device-mobile"></i></button></span></div><div class="fake-site"><div class="fake-nav"><b>дом.ру</b><span>Интернет · ТВ · Тарифы</span><button>Проверить адрес</button></div><div class="fake-hero"><small>Домашний интернет в Казани</small><h2>Интернет, который<br />не подводит</h2><p>Скорость до 1 Гбит/с и телевидение в одном тарифе</p><button>Выбрать тариф</button></div><div class="fake-cards"><i></i><i></i><i></i></div></div></div><aside class="properties"><div class="editor-head"><span><small>Свойства блока</small><b>Первый экран</b></span><button class="icon"><i class="ti ti-x"></i></button></div><label>Источник<button class="inherit"><i class="ti ti-git-branch"></i>Город · Казань</button></label><label>Заголовок<textarea rows="3">Интернет, который не подводит</textarea></label><label>Описание<textarea rows="3">Скорость до 1 Гбит/с и телевидение в одном тарифе</textarea></label><label>Текст кнопки<input value="Выбрать тариф" /></label><div class="property-foot"><button class="button secondary">Сбросить</button><button class="button primary">Сохранить</button></div></aside></div></section>

          <section class="view generic" id="blocks"><div class="empty"><i class="ti ti-stack-2"></i><h2>Библиотека блоков</h2><p>Проверенные блоки для городских страниц и шаблонов.</p><button class="button primary" data-open="pages">Открыть редактор</button></div></section><section class="view generic" id="seo"><div class="empty"><i class="ti ti-chart-dots-3"></i><h2>SEO</h2><p>Шаблоны метаданных и ручные переопределения для 512 городов.</p></div></section><section class="view generic" id="redirects"><div class="empty"><i class="ti ti-arrow-forward-up-double"></i><h2>Редиректы</h2><p>301-правила, найденные 404 и последние обращения.</p></div></section><section class="view generic" id="variables"><div class="empty"><i class="ti ti-brackets-contain"></i><h2>Переменные</h2><p>Телефоны, реквизиты и управляемые значения сайта.</p></div></section><section class="view generic" id="history"><div class="empty"><i class="ti ti-history"></i><h2>История изменений</h2><p>Полный аудит ручных правок, импортов и публикаций.</p></div></section><section class="view generic" id="analytics"><div class="empty"><i class="ti ti-chart-bar"></i><h2>Аналитика</h2><p>Визиты, формы и звонки с фильтрами по городам, страницам и UTM.</p></div></section><section class="view generic" id="integrations"><div class="empty"><i class="ti ti-plug-connected"></i><h2>Интеграции</h2><p>Tarifnik, API Дом.ру и профили сопоставления payload.</p></div></section><section class="view generic" id="activity"><div class="empty"><i class="ti ti-list-details"></i><h2>Журнал действий</h2><p>Изменения данных, входы и интеграционные запросы.</p></div></section><section class="view generic" id="settings"><div class="empty"><i class="ti ti-settings"></i><h2>Настройки</h2><p>Параметры платформы и единственная учетная запись администратора.</p></div></section>
        </div>
