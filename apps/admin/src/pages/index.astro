    <script define:vars={{ apiUrl }}>
      const legacyForms = { '#cityForm': '/admin/cities', '#regionForm': '/admin/regions', '#pageForm': '/admin/pages', '#tariffForm': '/admin/tariffs' };
      Object.entries(legacyForms).forEach(([selector, path]) => {
        const form = document.querySelector(selector);
        if (!form) return;
        form.onsubmit = async (event) => {
          event.preventDefault();
          const target = event.currentTarget || form;
          const values = Object.fromEntries(new FormData(target).entries());
          const isRegion = selector === '#regionForm';
          if (!isRegion) {
            const seo = {};
            if (values.seoTitle) seo.title = String(values.seoTitle).trim();
            if (values.seoDescription) seo.description = String(values.seoDescription).trim();
            values.seo = seo;
            delete values.seoTitle;
            delete values.seoDescription;
          }
          const id = target.dataset?.recordId;
          const response = await fetch(`${apiUrl}${path}${id ? `/${id}` : ''}`, { method: id ? 'PATCH' : 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(values) });
          if (!response.ok) throw new Error('Не удалось сохранить данные');
          if (typeof target.reset === 'function') target.reset();
          if (target.dataset) delete target.dataset.recordId;
          const status = document.querySelector('#status');
          if (status) status.className = 'status success';
        };
      });
    </script>
    <script define:vars={{ apiUrl }}>
      const app=document.querySelector('#app'), views=[...document.querySelectorAll('.view')], nav=[...document.querySelectorAll('.nav')]; const go=(id)=>{views.forEach(v=>v.classList.toggle('active',v.id===id));nav.forEach(n=>n.classList.toggle('active',n.dataset.view===id));scrollTo({top:0,behavior:'smooth'});}; nav.forEach(n=>n.onclick=()=>go(n.dataset.view)); document.querySelectorAll('[data-open]').forEach(b=>b.onclick=()=>go(b.dataset.open)); document.querySelector('#collapse').onclick=()=>app.classList.toggle('collapsed'); const theme=document.querySelector('#theme');theme.onclick=()=>{const dark=app.classList.toggle('dark');theme.querySelector('span').textContent=dark?'Темная':'Светлая';theme.querySelector('i').className=dark?'ti ti-moon':'ti ti-sun';}; const drawer=document.querySelector('#drawer'),backdrop=document.querySelector('#backdrop'),close=()=>{drawer.classList.remove('open');backdrop.classList.remove('visible');}; document.querySelectorAll('[data-drawer]').forEach(row=>row.onclick=(e)=>{if(e.target.closest('.row'))return;const type=row.dataset.drawer;document.querySelector('#drawer-type').textContent=type==='lead'?'Заявка #LD-10482':type==='city'?'Город · Республика Татарстан':'Тариф · Интернет';document.querySelector('#drawer-title').textContent=type==='lead'?'+7 927 410-••-18':type==='city'?'Казань':'Гига 500';drawer.classList.add('open');backdrop.classList.add('visible');});document.querySelector('#close-drawer').onclick=close;backdrop.onclick=close; const dialog=document.querySelector('#command');document.querySelector('#search').onclick=()=>dialog.showModal();document.addEventListener('keydown',e=>{if((e.metaKey||e.ctrlKey)&&e.key.toLowerCase()==='j'){e.preventDefault();dialog.showModal();}});dialog.querySelectorAll('[data-open]').forEach(b=>b.onclick=()=>{dialog.close();go(b.dataset.open);}); const panel=document.querySelector('#tariff-panel'),bulk=document.querySelector('#bulk'),boxes=[...panel.querySelectorAll('tbody input')];document.querySelector('#select-mode').onclick=()=>panel.classList.toggle('selecting');boxes.forEach(b=>b.onchange=()=>{const n=boxes.filter(x=>x.checked).length;document.querySelector('#selected').textContent=n;bulk.classList.toggle('show',n>0);}); void apiUrl;
    </script>
    <script define:vars={{ apiUrl }}>
      (() => {
        const tokenKey = 'provider_admin_token';
        const escapeHtml = (value) => String(value ?? '').replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[char]));
        const headers = () => { const token = sessionStorage.getItem(tokenKey); if (!token) return {}; return token.startsWith('Bearer ') ? { Authorization: token } : { 'x-admin-token': token }; };
        let asked = false;
        async function api(path) { let response = await fetch(`${apiUrl}${path}`, { headers: headers() }); if (response.status === 401 && !asked) { asked = true; const token = window.prompt('Введите API-токен или JWT для подключения админки'); if (token) { sessionStorage.setItem(tokenKey, token.trim()); response = await fetch(`${apiUrl}${path}`, { headers: headers() }); } } if (!response.ok) throw new Error(String(response.status)); return response.json(); }
        const publish = (value) => value === 'PUBLISHED' ? '<em class="status success"><i class="ti ti-circle-check"></i>Опубликован</em>' : value === 'ARCHIVED' ? '<em class="status neutral"><i class="ti ti-archive"></i>В архиве</em>' : '<em class="status draft"><i class="ti ti-pencil"></i>Черновик</em>';
        const money = (value) => value === null || value === undefined || value === '' ? '—' : `${Number(value).toLocaleString('ru-RU')} ₽`;
        const date = (value) => value ? new Date(value).toLocaleDateString('ru-RU', { day: '2-digit', month: 'short' }) : '—';
        const services = { INTERNET: 'Интернет', INTERNET_TV: 'Интернет + ТВ', TV: 'Телевидение', OTHER: 'Другое' };
        const renderCities = (items) => { const body = document.querySelector('#cities tbody'); if (!body || !items.length) return; body.innerHTML = items.slice(0, 50).map((city) => `<tr data-drawer="city"><td><strong>${escapeHtml(city.name)}</strong><small>${escapeHtml(city.slug)}</small></td><td>${escapeHtml(city.region?.name || '—')}</td><td>${publish(city.status)}</td><td>${city.tariffsCount ?? '—'}</td><td><em class="status ${city.seo ? 'success' : 'warning'}">${city.seo ? 'Заполнено' : 'Нет данных'}</em></td><td>${date(city.updatedAt)}</td><td><button class="row"><i class="ti ti-edit"></i></button></td></tr>`).join(''); };
        const renderTariffs = (items) => { const body = document.querySelector('#tariffs tbody'); if (!body || !items.length) return; body.innerHTML = items.slice(0, 50).map((tariff) => `<tr data-drawer="tariff"><td class="checks"><input type="checkbox" /></td><td><strong>${escapeHtml(tariff.name)}</strong><small>${escapeHtml(tariff.slug)}</small></td><td>${escapeHtml(tariff.city?.name || '—')}</td><td>${services[tariff.serviceType] || escapeHtml(tariff.serviceType)}</td><td>${tariff.speed ? `${tariff.speed} Мбит/с` : '—'}</td><td><strong>${money(tariff.promoPrice ?? tariff.standardPrice)}</strong>${tariff.promoPrice ? `<small>${money(tariff.standardPrice)}</small>` : ''}</td><td>${escapeHtml(tariff.promoText || 'Нет')}</td><td>${publish(tariff.status)}</td><td><button class="row"><i class="ti ti-edit"></i></button></td></tr>`).join(''); };
        const renderLeads = (items) => { const body = document.querySelector('#leads tbody'); if (!body || !items.length) return; body.innerHTML = items.slice(0, 50).map((lead) => `<tr data-drawer="lead"><td><strong>${new Date(lead.createdAt).toLocaleTimeString('ru-RU', { hour: '2-digit', minute: '2-digit' })}</strong><small>${date(lead.createdAt)}</small></td><td><strong>${escapeHtml(lead.phone)}</strong><small>${escapeHtml(lead.source || 'Прямой визит')}</small></td><td>${escapeHtml(lead.city?.name || '—')}<small>${escapeHtml(lead.address || 'Адрес не указан')}</small></td><td>${escapeHtml(lead.page?.slug || '—')}</td><td>${escapeHtml(lead.tariff?.name || '—')}</td><td><em class="status ${lead.apiResult ? 'success' : 'warning'}">${lead.apiResult ? 'Проверено' : 'Нет данных'}</em></td><td><em class="status ${lead.status === 'NEW' ? 'success' : 'neutral'}">${lead.status === 'NEW' ? 'Новая' : 'Не передана'}</em></td><td><em class="status ${lead.status === 'REJECTED' ? 'danger' : 'warning'}">${escapeHtml(lead.status)}</em></td><td><button class="row"><i class="ti ti-chevron-right"></i></button></td></tr>`).join(''); };
        const markConnected = () => { const node = document.querySelector('.service span'); if (node) node.textContent = 'API подключен · данные актуальны'; };
        const load = async () => { try { const [cities, tariffs, leads] = await Promise.all([api('/admin/cities'), api('/admin/tariffs'), api('/crm/leads')]); renderCities(cities); renderTariffs(tariffs); renderLeads(leads); markConnected(); } catch { /* демо-данные сохраняются до подключения API */ } };
        document.querySelector('.profile')?.addEventListener('click', () => { const token = window.prompt('API-токен или JWT', sessionStorage.getItem(tokenKey) || ''); if (token === null) return; if (token.trim()) sessionStorage.setItem(tokenKey, token.trim()); else sessionStorage.removeItem(tokenKey); load(); });
        document.addEventListener('click', (event) => { const row = event.target.closest('tr[data-drawer]'); if (!row || event.target.closest('button')) return; const type = row.dataset.drawer; const title = row.querySelector('td:nth-child(1) strong')?.textContent || 'Объект'; const drawer = document.querySelector('#drawer'); if (!drawer) return; document.querySelector('#drawer-type').textContent = type === 'lead' ? 'Заявка' : type === 'city' ? 'Город' : 'Тариф'; document.querySelector('#drawer-title').textContent = title; drawer.classList.add('open'); document.querySelector('#backdrop')?.classList.add('visible'); });
        load();
      })();
    </script>
    <script define:vars={{ apiUrl, providerId }}>
      (() => {
        const fileInput = document.querySelector('#tariff-file');
        const choose = document.querySelector('#choose-import-file');
        const apply = document.querySelector('#apply-import');
        const download = document.querySelector('#download-import-report');
        const tokenKey = 'provider_admin_token';
        let runId = '';
        let report = null;
        const headers = () => { const token = sessionStorage.getItem(tokenKey); if (!token) return {}; return token.startsWith('Bearer ') ? { Authorization: token } : { 'x-admin-token': token }; };
        const requestToken = async (url, options = {}) => { let response = await fetch(url, { ...options, headers: { ...headers(), ...(options.headers || {}) } }); if (response.status === 401) { const token = window.prompt('Введите API-токен или JWT для импорта'); if (token) { sessionStorage.setItem(tokenKey, token.trim()); response = await fetch(url, { ...options, headers: { ...headers(), ...(options.headers || {}) } }); } } if (!response.ok) throw new Error(`API ${response.status}`); return response.json(); };
        const escapeHtml = (value) => String(value ?? '').replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[char]));
        const loadHistory = async () => { if (!sessionStorage.getItem(tokenKey)) return; try { const items = await requestToken(`${apiUrl}/admin/tariffs/imports`); const list = document.querySelector('#import-history-list'); if (!list || !items.length) return; list.innerHTML = items.map((item) => `<button><i class="ti ti-file-spreadsheet"></i><span><strong>${escapeHtml(item.fileName)} · ${escapeHtml(item.status)}</strong><small>${item.validRows}/${item.totalRows} строк · ${new Date(item.createdAt).toLocaleString('ru-RU')}</small></span><i class="ti ti-chevron-right"></i></button>`).join(''); } catch { /* история появится после успешной авторизации */ } };
        const setCount = (id, value) => { const node = document.querySelector(id); if (node) node.firstChild.textContent = String(value); };
        const fileAsDataUrl = (file) => new Promise((resolve, reject) => { const reader = new FileReader(); reader.onload = () => resolve(String(reader.result)); reader.onerror = () => reject(reader.error); reader.readAsDataURL(file); });
        choose?.addEventListener('click', () => fileInput?.click());
        fileInput?.addEventListener('change', async () => {
          const file = fileInput.files?.[0];
          if (!file) return;
          if (file.size > 25 * 1024 * 1024) { window.alert('Файл больше 25 МБ. Разделите его на несколько импортов.'); return; }
          const state = document.querySelector('#import-validation-state');
          const name = document.querySelector('#import-file-name');
          if (name) name.textContent = `${file.name} · ${(file.size / 1024 / 1024).toFixed(1)} МБ`;
          if (state) state.textContent = 'Файл отправляется на проверку…';
          try {
            const selectedProvider = providerId || window.prompt('Укажите ID провайдера для импорта');
            if (!selectedProvider) throw new Error('Не указан providerId');
            const dataUrl = await fileAsDataUrl(file);
            const result = await requestToken(`${apiUrl}/admin/tariffs/import/validate`, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ providerId: selectedProvider, fileName: file.name, fileBase64: dataUrl }) });
            report = result.report;
            runId = result.run.id;
            setCount('#import-valid-count', report.validRows);
            setCount('#import-warning-count', report.warningRows);
            setCount('#import-error-count', report.errorRows);
            if (state) state.textContent = report.errorRows ? 'Есть ошибки: исправьте файл и загрузите его снова' : `Проверено строк: ${report.totalRows}. Можно открыть отчет и подтвердить импорт.`;
            if (apply) apply.disabled = report.errorRows > 0;
            if (download) download.disabled = false;
            await loadHistory();
          } catch (error) {
            if (state) state.textContent = error instanceof Error ? error.message : 'Не удалось проверить файл';
            if (apply) apply.disabled = true;
          }
        });
        download?.addEventListener('click', () => { if (!report) return; const blob = new Blob([JSON.stringify(report, null, 2)], { type: 'application/json' }); const link = document.createElement('a'); link.href = URL.createObjectURL(blob); link.download = `${report.fileName}.report.json`; link.click(); URL.revokeObjectURL(link.href); });
        apply?.addEventListener('click', async () => { if (!runId || !report || report.errorRows > 0) return; const warningText = report.warningRows > 0 ? ` Есть предупреждения: ${report.warningRows}; продолжение подтвердит их.` : ''; if (!window.confirm(`Применить полный снимок из ${report.validRows} тарифов? Отсутствующие в файле тарифы будут удалены.${warningText}`)) return; try { const result = await requestToken(`${apiUrl}/admin/tariffs/import/apply`, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ runId, confirmWarnings: report.warningRows > 0 }) }); const state = document.querySelector('#import-validation-state'); if (state) state.textContent = `Импорт применен: создано ${result.created}, обновлено ${result.updated}, удалено ${result.deleted}.`; apply.disabled = true; } catch (error) { window.alert(error instanceof Error ? error.message : 'Не удалось применить импорт'); } });
      })();
    </script>
    <script define:vars={{ apiUrl, siteId }}>
      (() => {
        const fileInput = document.querySelector('#city-file');
        const choose = document.querySelector('#choose-city-file');
        const dialog = document.querySelector('#city-import-dialog');
        const close = document.querySelector('#close-city-import');
        const apply = document.querySelector('#apply-city-import');
        const download = document.querySelector('#download-city-import-report');
        const tokenKey = 'provider_admin_token';
        let runId = '';
        let report = null;
        const headers = () => { const token = sessionStorage.getItem(tokenKey); if (!token) return {}; return token.startsWith('Bearer ') ? { Authorization: token } : { 'x-admin-token': token }; };
        const request = async (url, options = {}) => { let response = await fetch(url, { ...options, headers: { ...headers(), ...(options.headers || {}) } }); if (response.status === 401) { const token = window.prompt('Введите API-токен или JWT для импорта'); if (token) { sessionStorage.setItem(tokenKey, token.trim()); response = await fetch(url, { ...options, headers: { ...headers(), ...(options.headers || {}) } }); } } if (!response.ok) { let message = `API ${response.status}`; try { message = (await response.json()).message || message; } catch { /* HTTP status is enough */ } throw new Error(message); } return response.json(); };
        const setCount = (id, value) => { const node = document.querySelector(id); if (node) node.firstChild.textContent = String(value); };
        const dataUrl = (file) => new Promise((resolve, reject) => { const reader = new FileReader(); reader.onload = () => resolve(String(reader.result)); reader.onerror = () => reject(reader.error); reader.readAsDataURL(file); });
        choose?.addEventListener('click', () => fileInput?.click());
        close?.addEventListener('click', () => dialog?.close());
        fileInput?.addEventListener('change', async () => {
          const file = fileInput.files?.[0];
          if (!file) return;
          if (file.size > 25 * 1024 * 1024) { window.alert('Файл больше 25 МБ. Разделите его на несколько импортов.'); return; }
          const name = document.querySelector('#city-import-file-name');
          const state = document.querySelector('#city-import-state');
          if (name) name.textContent = `${file.name} · ${(file.size / 1024 / 1024).toFixed(1)} МБ`;
          if (state) state.textContent = 'Проверяем обязательные поля, slug и повторы строк…';
          if (apply) apply.disabled = true;
          if (download) download.disabled = true;
          dialog?.showModal();
          try {
            const selectedSite = siteId || window.prompt('Укажите ID сайта для импорта городов');
            if (!selectedSite) throw new Error('Не указан siteId');
            const result = await request(`${apiUrl}/admin/cities/import/validate`, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ siteId: selectedSite, fileName: file.name, fileBase64: await dataUrl(file) }) });
            runId = result.run.id;
            report = result.report;
            setCount('#city-import-valid-count', report.validRows);
            setCount('#city-import-warning-count', report.warningRows);
            setCount('#city-import-error-count', report.errorRows);
            if (state) state.textContent = report.errorRows ? 'Есть ошибки. Скачайте отчет, исправьте файл и загрузите его снова.' : `Проверено ${report.totalRows} строк. После подтверждения новые города получат типовые страницы в черновиках.`;
            if (apply) apply.disabled = report.errorRows > 0;
            if (download) download.disabled = false;
          } catch (error) {
            if (state) state.textContent = error instanceof Error ? error.message : 'Не удалось проверить файл';
          }
        });
        download?.addEventListener('click', () => { if (!report) return; const blob = new Blob([JSON.stringify(report, null, 2)], { type: 'application/json' }); const link = document.createElement('a'); link.href = URL.createObjectURL(blob); link.download = `${report.fileName || 'city-import'}.report.json`; link.click(); URL.revokeObjectURL(link.href); });
        apply?.addEventListener('click', async () => { if (!runId || !report || report.errorRows > 0) return; if (!window.confirm(`Применить ${report.validRows} строк? Новые города останутся черновиками.`)) return; const state = document.querySelector('#city-import-state'); try { const result = await request(`${apiUrl}/admin/cities/import/apply`, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ runId }) }); if (state) state.textContent = `Импорт применен: создано ${result.created}, обновлено ${result.updated}, пропущено ${result.skipped}. Создано черновых страниц: ${result.pagesCreated}.`; apply.disabled = true; } catch (error) { if (state) state.textContent = error instanceof Error ? error.message : 'Не удалось применить импорт'; } });
      })();
    </script>
  </body>
