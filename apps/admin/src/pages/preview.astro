---
import '../styles/global.css';
import { PreviewApp } from '../components/PreviewApp';
import { createHash } from 'node:crypto';
import publicPreviewStyles from 'virtual:preview-public-styles';
import { previewStyleText } from '../lib/preview-document.mjs';

const apiUrl = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000/api/v1';
// srcdoc inherits this page's CSP. Authorize its exact build-owned stylesheet;
// do not enable arbitrary inline styles or scripts in the parent document.
Astro.csp?.insertStyleHash(`sha256-${createHash('sha256').update(previewStyleText(publicPreviewStyles)).digest('base64')}`);
Astro.csp?.insertDirective("img-src https:");
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Предпросмотр · Дом.ру Платформа</title>
  </head>
  <body>
    <PreviewApp apiUrl={apiUrl} client:load />
  </body>
</html>
