---
import '@tabler/icons-webfont/dist/tabler-icons.min.css';
const apiUrl = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000/api/v1';
---
<!doctype html>
<html lang="ru">
  <head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="color-scheme" content="light dark" /><title>Дом.ру · Заявки</title></head>
  <body>
    <div class="app" id="app">
      <aside class="sidebar"><div class="brand-row"><a class="brand" href="#"><span class="mark">д</span><span class="brand-name"><b>Дом.ру</b><small>Журнал заявок</small></span></a><button class="icon" id="collapse" aria-label="Свернуть меню"><i class="ti ti-layout-sidebar-left-collapse"></i></button></div><nav><button class="nav active"><i class="ti ti-inbox"></i><span>Все заявки</span><b>1 248</b></button><button class="nav"><i class="ti ti-sparkles"></i><span>Новые</span><b class="blue">128</b></button><p>Контроль</p><button class="nav"><i class="ti ti-send-off"></i><span>Ошибки передачи</span><b class="danger">3</b></button><button class="nav"><i class="ti ti-help-circle"></i><span>Ручная проверка</span><b>18</b></button><button class="nav"><i class="ti ti-copy"></i><span>Дубликаты</span></button><p>Система</p><button class="nav"><i class="ti ti-chart-bar"></i><span>Аналитика</span></button><button class="nav"><i class="ti ti-plug-connected"></i><span>Tarifnik</span></button><button class="nav"><i class="ti ti-list-details"></i><span>Журнал действий</span></button></nav><div class="service"><i></i><span>API Tarifnik доступен</span></div></aside>
      <main class="main"><header class="topbar"><button class="icon mobile" aria-label="Меню"><i class="ti ti-menu-2"></i></button><button class="search"><i class="ti ti-search"></i><span>Поиск по телефону, адресу или ID</span><kbd>⌘ J</kbd></button><div class="top-actions"><button class="icon notice" aria-label="Уведомления"><i class="ti ti-bell"></i><b>3</b></button><button class="theme" id="theme"><i class="ti ti-sun"></i><span>Светлая</span></button><button class="profile"><span class="avatar">АБ</span><span><strong>Александр</strong><small>Администратор</small></span><i class="ti ti-chevron-down"></i></button></div></header>
        <div class="content"><div class="head"><div><p class="eyebrow">Контроль · журнал заявок</p><h1>Заявки</h1><p>Сохраняем полный путь обращения от формы до внешней CRM.</p></div><div class="actions"><button class="button secondary"><i class="ti ti-download"></i>Экспорт</button><button class="button primary"><i class="ti ti-chart-line"></i>Аналитика</button></div></div>
          <div class="summary"><div><span class="sum-icon blue"><i class="ti ti-inbox"></i></span><span><small>Всего за 30 дней</small><strong>1 248</strong></span></div><div><span class="sum-icon green"><i class="ti ti-send"></i></span><span><small>Успешно передано</small><strong>1 104</strong></span><em>88,5%</em></div><div><span class="sum-icon orange"><i class="ti ti-clock"></i></span><span><small>Ожидают проверки</small><strong>18</strong></span><em>ручная обработка</em></div><div><span class="sum-icon red"><i class="ti ti-send-off"></i></span><span><small>Ошибки передачи</small><strong>3</strong></span><em>требуют внимания</em></div></div>
          <div class="panel table-panel"><div class="toolbar"><label class="search-input"><i class="ti ti-search"></i><input placeholder="Телефон, адрес или ID заявки" /></label><button class="filter"><i class="ti ti-adjustments-horizontal"></i>Фильтры <b>3</b></button><button class="reset">Сбросить фильтры</button><span>Показано 20 из 1 248</span></div><div class="table-scroll"><table><thead><tr><th>Время</th><th>Контакт</th><th>Город и адрес</th><th>Страница</th><th>Тариф</th><th>Проверки API</th><th>Передача</th><th>Статус</th><th></th></tr></thead><tbody><tr data-lead="new"><td><strong>12:42</strong><small>Сегодня</small></td><td><strong>+7 927 410-••-18</strong><small>Прямой визит</small></td><td><strong>Казань</strong><small>ул. Чистопольская, 60</small></td><td>/kazan/internet/</td><td>Гига 500</td><td><em class="status success"><i class="ti ti-circle-check"></i>Адрес найден</em><small class="substatus">Новый абонент</small></td><td><em class="status success"><i class="ti ti-send"></i>Передана</em></td><td><em class="status success">Новая</em></td><td><button class="row"><i class="ti ti-chevron-right"></i></button></td></tr><tr data-lead="error"><td><strong>12:19</strong><small>Сегодня</small></td><td><strong>+7 917 512-••-09</strong><small>Яндекс · cpc</small></td><td><strong>Набережные Челны</strong><small>пр-т Мира, 50</small></td><td>/naberezhnye-chelny/</td><td>Мега 300</td><td><em class="status success"><i class="ti ti-circle-check"></i>Адрес найден</em><small class="substatus">Новый абонент</small></td><td><em class="status danger"><i class="ti ti-send-off"></i>3 ошибки</em></td><td><em class="status warning"><i class="ti ti-alert-triangle"></i>Повтор</em></td><td><button class="row"><i class="ti ti-chevron-right"></i></button></td></tr><tr data-lead="manual"><td><strong>11:57</strong><small>Сегодня</small></td><td><strong>+7 903 441-••-21</strong><small>Прямой визит</small></td><td><strong>Барнаул</strong><small>ул. Взлетная, 27</small></td><td>/barnaul/tarify/</td><td>Гига 100</td><td><em class="status warning"><i class="ti ti-help"></i>Уточнение</em><small class="substatus">Адрес неоднозначен</small></td><td><em class="status neutral">Не передана</em></td><td><em class="status warning">Ручная проверка</em></td><td><button class="row"><i class="ti ti-chevron-right"></i></button></td></tr><tr data-lead="subscriber"><td><strong>11:31</strong><small>Сегодня</small></td><td><strong>+7 905 218-••-72</strong><small>Партнерский сайт</small></td><td><strong>Казань</strong><small>ул. Декабристов, 131</small></td><td>/kazan/internet-tv/</td><td>Мега 300</td><td><em class="status warning"><i class="ti ti-user-check"></i>Абонент</em><small class="substatus">Действующий договор</small></td><td><em class="status neutral">Не передана</em></td><td><em class="status neutral">Абонент</em></td><td><button class="row"><i class="ti ti-chevron-right"></i></button></td></tr></tbody></table></div><div class="pagination"><span>Страница 1 из 63</span><button>1</button><button>2</button><button>3</button><button><i class="ti ti-chevron-right"></i></button></div></div></div></main>
    </div>
    <aside class="drawer" id="drawer"><div class="drawer-head"><div><small>Заявка #LD-10482</small><h2 id="title">+7 927 410-••-18</h2></div><button class="icon" id="close"><i class="ti ti-x"></i></button></div><div class="drawer-meta"><em class="status success"><i class="ti ti-circle-check"></i>Новая</em><span>Сегодня, 12:42 · 04:18 на сайте</span></div><div class="drawer-tabs"><button class="active">Сводка</button><button>Проверки API</button><button>Передача</button><button>Активность</button></div><div class="drawer-content"><section><h3>Контекст обращения</h3><dl><div><dt>Референс</dt><dd>yandex.ru</dd></div><div><dt>Страница</dt><dd>/kazan/internet/</dd></div><div><dt>Тариф</dt><dd>Гига 500 · 890 ₽</dd></div><div><dt>Город</dt><dd>Казань</dd></div></dl></section><section><h3>Контакт и адрес</h3><dl><div><dt>Телефон</dt><dd>+7 927 410-••-18</dd></div><div><dt>Адрес</dt><dd>ул. Чистопольская, 60</dd></div></dl></section><section><h3>Результат проверок</h3><div class="check"><i class="ti ti-circle-check"></i><span><strong>Адрес найден</strong><small>Дом.ру доступен по указанному адресу</small></span></div><div class="check"><i class="ti ti-user-plus"></i><span><strong>Новый абонент</strong><small>Действующий договор не найден</small></span></div></section><section><h3>Передача в кол-центр</h3><div class="delivery"><span><i class="ti ti-send"></i><strong>Успешно передана</strong></span><small>Tarifnik · 12:43:02 · попытка 1 из 3</small></div></section></div><div class="drawer-foot"><button class="button secondary">Открыть историю</button><button class="button primary" id="change-status">Изменить статус</button></div></aside><div class="backdrop" id="backdrop"></div>
    <script define:vars={{ apiUrl }}>
      (() => {
        const tokenKey = 'provider_admin_token';
        const escapeHtml = (value) => String(value ?? '').replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[char]));
        const headers = () => { const token = sessionStorage.getItem(tokenKey); if (!token) return {}; return token.startsWith('Bearer ') ? { Authorization: token } : { 'x-admin-token': token }; };
        let asked = false;
        async function api(path, options = {}) { let response = await fetch(`${apiUrl}${path}`, { ...options, headers: { ...headers(), ...(options.headers || {}) } }); if (response.status === 401 && !asked) { asked = true; const token = window.prompt('Введите API-токен или JWT для журнала заявок'); if (token) { sessionStorage.setItem(tokenKey, token.trim()); response = await fetch(`${apiUrl}${path}`, { ...options, headers: { ...headers(), ...(options.headers || {}) } }); } } if (!response.ok) throw new Error(String(response.status)); return response.json(); }
        const escapeStatus = { NEW: ['Новая', 'success'], IN_PROGRESS: ['В работе', 'blue'], CALL_LATER: ['Перезвонить', 'warning'], CONNECTED: ['Подключено', 'success'], REJECTED: ['Отказ', 'danger'] };
        const date = (value) => value ? new Date(value).toLocaleDateString('ru-RU', { day: '2-digit', month: 'short' }) : '—';
        const render = (items) => { const body = document.querySelector('tbody'); if (!body || !items.length) return; body.innerHTML = items.slice(0, 50).map((lead) => { const [label, tone] = escapeStatus[lead.status] || [lead.status || 'Неизвестно', 'neutral']; const apiOk = Boolean(lead.apiResult); return `<tr data-lead="api" data-id="${escapeHtml(lead.id)}" data-phone="${escapeHtml(lead.phone)}"><td><strong>${new Date(lead.createdAt).toLocaleTimeString('ru-RU', { hour: '2-digit', minute: '2-digit' })}</strong><small>${date(lead.createdAt)}</small></td><td><strong>${escapeHtml(lead.phone)}</strong><small>${escapeHtml(lead.source || 'Прямой визит')}</small></td><td><strong>${escapeHtml(lead.city?.name || '—')}</strong><small>${escapeHtml(lead.address || 'Адрес не указан')}</small></td><td>${escapeHtml(lead.page?.slug || '—')}</td><td>${escapeHtml(lead.tariff?.name || '—')}</td><td><em class="status ${apiOk ? 'success' : 'warning'}"><i class="ti ${apiOk ? 'ti-circle-check' : 'ti-help'}"></i>${apiOk ? 'Проверено' : 'Нет данных'}</em></td><td><em class="status ${lead.status === 'NEW' ? 'success' : 'neutral'}">${lead.status === 'NEW' ? 'Передана' : 'В журнале'}</em></td><td><em class="status ${tone}">${escapeHtml(label)}</em></td><td><button class="row"><i class="ti ti-chevron-right"></i></button></td></tr>`; }).join(''); };
        const load = async () => { try { const items = await api('/crm/leads'); render(items); const service = document.querySelector('.service span'); if (service) service.textContent = 'API Tarifnik · журнал синхронизирован'; } catch { /* демонстрационные строки остаются до подключения API */ } };
        document.querySelector('.profile')?.addEventListener('click', () => { const token = window.prompt('API-токен или JWT', sessionStorage.getItem(tokenKey) || ''); if (token === null) return; if (token.trim()) sessionStorage.setItem(tokenKey, token.trim()); else sessionStorage.removeItem(tokenKey); load(); });
        let selectedLeadId = '';
        const processing = { PENDING: ['Ожидает передачи', 'warning'], DELIVERED: ['Передана в Tarifnik', 'success'], DUPLICATE_SUPPRESSED: ['Дубликат: не передана', 'neutral'], ACTIVE_SUBSCRIBER_NOT_SENT: ['Действующий абонент: не передана', 'neutral'], MANUAL_CHECK: ['Ручная проверка', 'warning'], ADDRESS_CLARIFICATION: ['Требует уточнения адреса', 'warning'], MANUAL_CHECK_API: ['Ручная проверка API', 'warning'], DELIVERY_ERROR_EMAIL_SENT: ['Ошибка API: email отправлен', 'danger'], DELIVERY_ERROR_EMAIL_FAILED: ['Ошибка API: email не отправлен', 'danger'] };
        const item = (label, value) => `<div><dt>${label}</dt><dd>${escapeHtml(value || '—')}</dd></div>`;
        const renderDrawer = (lead) => {
          const [statusLabel, statusTone] = escapeStatus[lead.status] || [lead.status || 'Неизвестно', 'neutral'];
          const [processingLabel] = processing[lead.processingStatus] || [lead.processingStatus || 'Нет данных', 'neutral'];
          const checkStatus = lead.addressCheck?.status || lead.apiResult?.status || 'Нет данных';
          const contract = lead.contractResult || {};
          const attempts = Array.isArray(lead.deliveryAttempts) ? lead.deliveryAttempts : [];
          const lastAttempt = attempts.at(-1);
          document.querySelector('#title').textContent = lead.phone || 'Заявка';
          document.querySelector('.drawer-head small').textContent = `Заявка #${lead.id}`;
          document.querySelector('.drawer-meta').innerHTML = `<em class="status ${statusTone}">${escapeHtml(statusLabel)}</em><span>${new Date(lead.createdAt).toLocaleString('ru-RU')} · ${lead.timeOnSiteSeconds ? `${Math.floor(lead.timeOnSiteSeconds / 60)}:${String(lead.timeOnSiteSeconds % 60).padStart(2, '0')} на сайте` : 'время не зафиксировано'}</span>`;
          const activity = (lead.activityEvents || []).slice(-8).map((event) => `<li><strong>${escapeHtml(event.type)}</strong><small>${new Date(event.createdAt).toLocaleString('ru-RU')}</small></li>`).join('') || '<li><small>События до формы не переданы</small></li>';
          document.querySelector('.drawer-content').innerHTML = `<section><h3>Контекст обращения</h3><dl>${item('Референс', lead.referrer || lead.source)}${item('Страница', lead.pageUrl || lead.page?.slug)}${item('Форма', lead.formName)}${item('Тариф', lead.tariff?.name)}${item('Город', lead.city?.name)}</dl></section><section><h3>Контакт и адрес</h3><dl>${item('Телефон', lead.phone)}${item('Email', lead.email)}${item('Адрес', lead.address)}${item('Тип объекта', lead.objectType)}</dl></section><section><h3>Проверки API</h3><dl>${item('Проверка адреса', checkStatus)}${item('Договор Дом.ру', contract.status || 'Нет данных')}${item('Результат договора', contract.active === true ? 'Действующий абонент' : contract.active === false ? 'Новый абонент' : contract.message)}</dl></section><section><h3>Передача в кол-центр</h3><div class="delivery"><span><i class="ti ti-send"></i><strong>${escapeHtml(processingLabel)}</strong></span><small>${lastAttempt ? `${escapeHtml(lastAttempt.channel)} · попытка ${lastAttempt.attemptNumber} · ${escapeHtml(lastAttempt.status)} · ${new Date(lastAttempt.createdAt).toLocaleString('ru-RU')}` : 'Попытки передачи еще не выполнялись'}</small></div>${lead.duplicateOf ? `<p class="drawer-note">Связана с заявкой ${escapeHtml(lead.duplicateOf.id)}: ${escapeHtml(lead.duplicateReason || 'дубликат')}</p>` : ''}</section><section><h3>Активность до отправки</h3><ul class="activity-list">${activity}</ul></section>`;
          document.querySelector('#drawer').classList.add('open');
          document.querySelector('#backdrop').classList.add('visible');
        };
        document.addEventListener('click', async (event) => { const row = event.target.closest('tr[data-lead]'); if (!row || event.target.closest('button')) return; selectedLeadId = row.dataset.id || ''; if (!selectedLeadId) return; try { renderDrawer(await api(`/crm/leads/${encodeURIComponent(selectedLeadId)}`)); } catch { window.alert('Не удалось загрузить карточку заявки. Проверьте подключение API.'); } });
        document.querySelector('#change-status')?.addEventListener('click', async () => { if (!selectedLeadId) return; const next = window.prompt('Новый статус: NEW, IN_PROGRESS, CALL_LATER, CONNECTED или REJECTED'); if (!next || !escapeStatus[next.trim()]) return; try { await api(`/crm/leads/${encodeURIComponent(selectedLeadId)}/status`, { method: 'PATCH', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ status: next.trim() }) }); await load(); } catch { window.alert('Не удалось изменить статус. Проверьте подключение API.'); } });
        load();
      })();
    </script>
  </body>
</html>
<style>
:root{--bg:#f7f8fa;--surface:#fff;--text:#1d2026;--muted:#777d89;--line:#e7e9ed;--line2:#d8dde5;--accent:#2878f0;--soft:#edf4ff;font-family:ui-sans-serif,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:var(--text);background:var(--bg)}*{box-sizing:border-box}body{margin:0;background:var(--bg)}button,input{font:inherit}button{cursor:pointer}.app{min-height:100vh;display:grid;grid-template-columns:260px minmax(0,1fr)}.sidebar{position:sticky;top:0;height:100vh;padding:18px 12px 13px;border-right:1px solid var(--line);background:var(--surface);display:flex;flex-direction:column}.brand-row{display:flex;align-items:center;justify-content:space-between;padding:0 5px 20px}.brand{display:flex;align-items:center;gap:10px;text-decoration:none;color:var(--text)}.mark{width:29px;height:29px;border-radius:9px;display:grid;place-items:center;background:var(--accent);color:#fff;font:bold 19px Georgia}.brand-name b,.brand-name small{display:block}.brand-name b{font-size:15px}.brand-name small{color:var(--muted);font-size:10px}.icon,.row{width:31px;height:31px;border:0;border-radius:8px;background:transparent;color:#8b919d;display:grid;place-items:center}.icon:hover,.row:hover{background:#f1f4f8;color:var(--text)}nav{display:grid;gap:2px}.nav{height:36px;width:100%;padding:0 10px;border:0;border-radius:8px;background:transparent;color:#6b717d;display:flex;align-items:center;gap:11px;text-align:left;font-size:13px;white-space:nowrap}.nav i{width:18px;text-align:center;font-size:18px}.nav b{margin-left:auto;min-width:18px;height:18px;border-radius:9px;display:grid;place-items:center;background:#eff1f4;color:#737985;font-size:10px}.nav b.blue{background:var(--soft);color:var(--accent)}.nav b.danger{background:#fff0f0;color:#d84d4d}.nav p{margin:18px 10px 6px;color:#a1a6b1;font-size:10px;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.nav.active,.nav:hover{background:var(--soft);color:var(--accent)}.service{margin-top:auto;padding:18px 7px 0;color:#858b96;fon