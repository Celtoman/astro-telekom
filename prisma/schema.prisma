generator client {
  provider = "prisma-client-js"
  output   = "../apps/api/generated"
}

datasource db {
  provider = "postgresql"
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PageType {
  HOME
  INTERNET
  INTERNET_TV
  TV
  TARIFF
  ADDRESS_CHECK
  FAQ
  COVERAGE
  CITIES
  PRIVACY
  PERSONAL_DATA_CONSENT
  COOKIE_POLICY
}

enum SeoTemplateKind {
  HOME
  COVERAGE
  CITIES
  PRIVACY
  PERSONAL_DATA_CONSENT
  COOKIE_POLICY
  CITY_HOME
  CITY_TARIFF_DETAIL
}

enum SeoIndexState {
  INDEX
  NOINDEX
}

enum ServiceType {
  INTERNET
  INTERNET_TV
  TV
  OTHER
}

enum LeadStatus {
  NEW
  IN_PROGRESS
  CALL_LATER
  CONNECTED
  REJECTED
}

enum AddressCheckStatus {
  AVAILABLE
  UNAVAILABLE
  AMBIGUOUS
  MANUAL_CHECK
  ERROR
}

enum LeadProcessingStatus {
  DECISION_PENDING
  DECISION_RUNNING
  PHONE_CHECK_RETRY
  PHONE_CHECK_FAILED
  PHONE_INVALID_NOT_SENT
  PENDING
  DELIVERED
  DUPLICATE_SUPPRESSED
  NON_SALES_NOT_SENT
  ACTIVE_SUBSCRIBER_NOT_SENT
  PROVIDER_NOT_AVAILABLE_NOT_SENT
  NO_PROVIDERS_NOT_SENT
  MANUAL_CHECK
  ADDRESS_CLARIFICATION
  MANUAL_CHECK_API
  DELIVERY_QUEUE_ERROR
  DELIVERY_ERROR_EMAIL_SENT
  DELIVERY_ERROR_EMAIL_FAILED
  DELIVERY_API_OUTCOME_UNKNOWN
  DELIVERY_EMAIL_OUTCOME_UNKNOWN
}

enum LeadPhoneCheckStatus {
  PENDING
  RUNNING
  RETRYING
  PASSED
  REJECTED
  FAILED
  SKIPPED
}

enum DeliveryChannel {
  QUEUE
  API
  EMAIL
}

enum DeliveryAttemptStatus {
  SUCCEEDED
  FAILED
  SKIPPED
  OUTCOME_UNKNOWN
}

enum TariffImportStatus {
  VALIDATED
  APPLIED
  UNDONE
  FAILED
}

enum CityImportStatus {
  VALIDATED
  APPLIED
  UNDONE
  FAILED
}

enum CityOfficeState {
  HAS_OFFICE
  NO_OFFICE
}

enum TariffAvailability {
  ACTIVE
  ARCHIVED
}

enum TariffArchiveReason {
  ABSENT_FROM_IMPORT
  MANUAL
}

enum SiteRebuildStatus {
  PENDING
  QUEUED
  RUNNING
  RETRYING
  SUCCEEDED
  FAILED
}

enum ContentEntityType {
  PROVIDER
  SITE
  REGION
  CITY
  PAGE
  TARIFF
  REDIRECT
}

enum ContentRevisionAction {
  CREATE
  UPDATE
  IMPORT
  UNDO
  ARCHIVE
  RESTORE
}

enum SitePublicationStatus {
  SCHEDULED
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum PublicationValidationOutcome {
  BLOCKED
  PASSED_WITH_WARNINGS
  PASSED
}

enum LeadNotificationStatus {
  PENDING
  QUEUED
  RUNNING
  RETRYING
  SUCCEEDED
  FAILED
}

model Provider {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  legalData   Json?
  settings    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sites       Site[]
  tariffs     Tariff[]
  tariffImports TariffImportRun[]
}

model Site {
  id          String   @id @default(cuid())
  providerId  String
  name        String
  slug        String   @unique
  domain      String?
  connectionPhone String?
  supportPhone String?
  settings    Json?
  status      PublishStatus @default(DRAFT)
  workingRevision   Int @default(0)
  publishedRevision Int @default(0)
  provider    Provider @relation(fields: [providerId], references: [id])
  regions     Region[]
  cities      City[]
  pages       Page[]
  leads       Lead[]
  checks      AddressCheck[]
  redirects   Redirect[]
  cityImports  CityImportRun[]
  rebuilds     SiteRebuild[]
  contentRevisions ContentRevision[]
  publications SitePublication[]
  publicationValidations SitePublicationValidation[]
  auditEvents AuditEvent[]
  sitemapExclusions SitemapExclusion[]
  seoTemplates SeoTemplate[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SeoTemplate {
  id                  String          @id @default(cuid())
  siteId              String
  kind                SeoTemplateKind
  titleTemplate       String
  descriptionTemplate String
  indexState          SeoIndexState   @default(INDEX)
  ogTitleTemplate     String?
  ogDescriptionTemplate String?
  ogImageUrl          String?
  site                Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  @@unique([siteId, kind])
}

model SitemapExclusion {
  id          String   @id @default(cuid())
  siteId      String
  path        String
  reason      String
  createdById String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([siteId, path])
  @@index([createdById, createdAt])
}

model SiteRebuild {
  id                   String            @id @default(cuid())
  siteId               String?
  dedupeKey            String            @unique
  status               SiteRebuildStatus @default(PENDING)
  triggerEntity        String
  triggerEntityId      String
  affectedPaths        Json
  requestedRevision    Int               @default(1)
  processingRevision   Int               @default(0)
  publishedRevision    Int               @default(0)
  attempts             Int               @default(0)
  maxAttempts           Int               @default(3)
  lastError             String?
  providerStatus       String?
  providerDeploymentId String?
  providerResponse     Json?
  requestedPublicationId  String?
  processingPublicationId String?
  publishedPublicationId  String?
  queuedAt              DateTime?          @db.Timestamptz(3)
  startedAt             DateTime?          @db.Timestamptz(3)
  completedAt           DateTime?          @db.Timestamptz(3)
  createdAt             DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime           @updatedAt @db.Timestamptz(3)
  site                  Site?              @relation(fields: [siteId], references: [id], onDelete: SetNull)
  requestedPublication  SitePublication?   @relation("RequestedPublication", fields: [requestedPublicationId], references: [id], onDelete: SetNull)
  processingPublication SitePublication?   @relation("ProcessingPublication", fields: [processingPublicationId], references: [id], onDelete: SetNull)
  publishedPublication  SitePublication?   @relation("PublishedPublication", fields: [publishedPublicationId], references: [id], onDelete: SetNull)

  @@index([status, updatedAt])
  @@index([siteId, updatedAt])
  @@index([requestedPublicationId])
  @@index([processingPublicationId])
}

model ContentRevision {
  id             String                @id @default(cuid())
  siteId         String
  entityType     ContentEntityType
  entityId       String
  entityRevision Int
  siteRevision   Int
  action         ContentRevisionAction
  previousSnapshot Json?
  snapshot       Json
  changedFields  Json
  source         String
  actorId        String?
  createdAt      DateTime              @default(now()) @db.Timestamptz(3)
  site           Site                  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  actor          User?                 @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@unique([entityType, entityId, entityRevision])
  @@unique([siteId, siteRevision, entityType, entityId])
  @@index([siteId, siteRevision])
  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}

model SitePublication {
  id                   String                @id @default(cuid())
  siteId               String
  siteRevision         Int
  status               SitePublicationStatus @default(PENDING)
  catalog              Json
  triggerEntity        String
  triggerEntityId      String
  requestedById        String?
  validationId         String?               @unique
  lastError            String?
  providerDeploymentId String?
  providerResponse     Json?
  scheduledFor         DateTime?             @db.Timestamptz(3)
  cancelledAt          DateTime?             @db.Timestamptz(3)
  createdAt            DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @db.Timestamptz(3)
  publishedAt          DateTime?             @db.Timestamptz(3)
  site                 Site                  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  requestedBy          User?                 @relation(fields: [requestedById], references: [id], onDelete: SetNull)
  validation           SitePublicationValidation? @relation(fields: [validationId], references: [id], onDelete: SetNull)
  requestedRebuilds    SiteRebuild[]         @relation("RequestedPublication")
  processingRebuilds   SiteRebuild[]         @relation("ProcessingPublication")
  publishedRebuilds    SiteRebuild[]         @relation("PublishedPublication")

  @@unique([siteId, siteRevision])
  @@index([siteId, status, createdAt])
  @@index([status, scheduledFor])
  @@index([requestedById, createdAt])
}

model SitePublicationValidation {
  id              String                       @id @default(cuid())
  siteId          String
  siteRevision    Int
  sourceSnapshot  Json
  report          Json
  appVersion      String
  outcome         PublicationValidationOutcome
  checkedUrlCount Int
  requestedById   String?
  validatedAt     DateTime                     @default(now()) @db.Timestamptz(3)
  site            Site                         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  requestedBy     User?                        @relation(fields: [requestedById], references: [id], onDelete: SetNull)
  publication     SitePublication?

  @@index([siteId, validatedAt])
  @@index([siteId, siteRevision, validatedAt])
}

model AuditEvent {
  id           String            @id @default(cuid())
  siteId       String
  siteRevision Int
  entityType   ContentEntityType
  entityId     String
  action       ContentRevisionAction
  changedFields Json
  changes      Json
  source       String
  actorId      String?
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)
  site         Site              @relation(fields: [siteId], references: [id], onDelete: Cascade)
  actor        User?             @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([siteId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}

model Region {
  id          String   @id @default(cuid())
  siteId      String
  name        String
  slug        String
  site        Site     @relation(fields: [siteId], references: [id])
  cities      City[]
  @@unique([siteId, slug])
}

model City {
  id          String   @id @default(cuid())
  siteId      String
  regionId    String
  name        String
  slug        String
  namePrepositional String?
  nameGenitive String?
  legacyUrl   String?
  officeState CityOfficeState @default(NO_OFFICE)
  officeAddress String?
  officeHours String?
  subscriberProfileKey String?
  status      PublishStatus @default(DRAFT)
  site        Site     @relation(fields: [siteId], references: [id])
  region      Region   @relation(fields: [regionId], references: [id])
  pages       Page[]
  tariffs     Tariff[]
  leads       Lead[]
  checks      AddressCheck[]
  redirects   Redirect[]
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  @@unique([siteId, slug])
  @@index([siteId, status, updatedAt, id])
  @@index([regionId, status, name, id])
}

model Page {
  id          String   @id @default(cuid())
  siteId      String
  cityId      String?
  type        PageType
  title       String
  slug        String
  status      PublishStatus @default(DRAFT)
  seo         Json?
  content     Json?
  site        Site     @relation(fields: [siteId], references: [id])
  city        City?    @relation(fields: [cityId], references: [id])
  blocks      PageBlock[]
  leads       Lead[]
  checks      AddressCheck[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([cityId, slug])
}

model PageBlock {
  id          String   @id @default(cuid())
  pageId      String
  blockType   String
  position    Int
  visible     Boolean  @default(true)
  data        Json
  source      String?
  archivedAt  DateTime? @db.Timestamptz(3)
  page        Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  @@index([pageId, position])
  @@index([archivedAt])
}

model Tariff {
  id              String   @id @default(cuid())
  providerId      String
  cityId          String
  name            String
  slug            String
  serviceType     ServiceType
  standardPrice   Decimal? @db.Decimal(10, 2)
  promoPrice      Decimal? @db.Decimal(10, 2)
  speed           Int?
  promoText       String?
  connectionFee   Decimal? @db.Decimal(10, 2)
  availability    TariffAvailability @default(ACTIVE)
  externalId      String?
  identityKey     String
  dataSource      String?
  attributes      Json?
  seo             Json?
  status          PublishStatus @default(DRAFT)
  archiveReason   TariffArchiveReason?
  archivedAt      DateTime? @db.Timestamptz(3)
  archivedByImportRunId String?
  provider        Provider @relation(fields: [providerId], references: [id])
  city            City     @relation(fields: [cityId], references: [id])
  archivedByImportRun TariffImportRun? @relation("ArchivedTariffs", fields: [archivedByImportRunId], references: [id], onDelete: SetNull)
  leads           Lead[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@unique([cityId, slug])
  @@unique([cityId, identityKey])
  @@index([cityId, serviceType, status])
  @@index([providerId, externalId])
  @@index([availability, archivedAt])
  @@index([archivedByImportRunId])
  @@index([updatedAt, id])
}

model TariffImportRun {
  id          String             @id @default(cuid())
  providerId  String
  fileName    String
  status      TariffImportStatus @default(VALIDATED)
  totalRows   Int
  validRows   Int
  errorRows   Int
  warningRows Int
  report      Json
  changeSet   Json?
  createdAt   DateTime           @default(now())
  appliedAt   DateTime?
  appliedById String?
  undoneAt    DateTime?
  undoneById  String?
  undoSiteRevisions Json?
  provider    Provider           @relation(fields: [providerId], references: [id])
  appliedBy   User?              @relation("TariffImportAppliedBy", fields: [appliedById], references: [id], onDelete: SetNull)
  undoneBy    User?              @relation("TariffImportUndoneBy", fields: [undoneById], references: [id], onDelete: SetNull)
  archivedTariffs Tariff[]       @relation("ArchivedTariffs")
  @@index([providerId, createdAt])
  @@index([appliedById, appliedAt])
  @@index([undoneById, undoneAt])
}

model CityImportRun {
  id          String           @id @default(cuid())
  siteId      String
  fileName    String
  status      CityImportStatus @default(VALIDATED)
  totalRows   Int
  validRows   Int
  errorRows   Int
  warningRows Int
  report      Json
  changeSet   Json?
  createdAt   DateTime         @default(now())
  appliedAt   DateTime?
  appliedById String?
  undoneAt    DateTime?
  undoneById  String?
  undoSiteRevisions Json?
  site        Site             @relation(fields: [siteId], references: [id], onDelete: Cascade)
  appliedBy   User?            @relation("CityImportAppliedBy", fields: [appliedById], references: [id], onDelete: SetNull)
  undoneBy    User?            @relation("CityImportUndoneBy", fields: [undoneById], references: [id], onDelete: SetNull)
  @@index([siteId, createdAt])
  @@index([appliedById, appliedAt])
  @@index([undoneById, undoneAt])
}

model AddressCheck {
  id          String   @id @default(cuid())
  siteId      String
  cityId      String
  pageId      String?
  address     String
  objectType  String?
  status      AddressCheckStatus
  providerRef String?
  response    Json?
  createdAt   DateTime @default(now())
  site        Site     @relation(fields: [siteId], references: [id])
  city        City     @relation(fields: [cityId], references: [id])
  page        Page?    @relation(fields: [pageId], references: [id])
  leads       Lead[]
  @@index([cityId, createdAt])
  @@index([createdAt])
}

model Lead {
  id              String   @id @default(cuid())
  siteId          String
  cityId          String
  pageId          String?
  tariffId        String?
  configurationSnapshot Json?
  reasonCode      String?
  reasonLabel     String?
  reasonRoute     String?
  reasonRegistryVersion Int?
  comment         String?
  commentAnalysisVersion Int?
  commentAnalysisOutcome String?
  commentAnalysisCategory String?
  commentAnalysisEvidence Json?
  commentAnalysisExplanation String?
  phoneCheckStatus LeadPhoneCheckStatus?
  phoneCheckQc Int?
  phoneCheckNormalized String?
  phoneCheckCheckedAt DateTime?
  phoneCheckAttempt Int?
  phoneCheckSource String?
  phoneCheckErrorCode String?
  phoneCheckNextAttemptAt DateTime?
  decisionLeaseUntil DateTime?
  decisionAttemptNumber Int?
  addressCheckId  String?
  name            String?
  phone             String
  submissionKey     String?  @unique
  consentVersion    String?
  consentAcceptedAt DateTime?
  email           String?
  address         String?
  objectType      String?
  serviceType     ServiceType?
  source          String?
  utm             Json?
  referrer        String?
  pageUrl         String?
  formName        String?
  timeOnSiteSeconds Int?
  deviceType      String?
  viewedPages     Json?
  processingStatus LeadProcessingStatus @default(PENDING)
  duplicateOfId   String?
  duplicateReason String?
  deliveryKey     String? @unique
  externalLeadId  String?
  externalStatus  String?
  contractResult  Json?
  status          LeadStatus @default(NEW)
  apiResult       Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  site            Site     @relation(fields: [siteId], references: [id])
  city            City     @relation(fields: [cityId], references: [id])
  page            Page?    @relation(fields: [pageId], references: [id])
  tariff          Tariff?  @relation(fields: [tariffId], references: [id])
  addressCheck    AddressCheck? @relation(fields: [addressCheckId], references: [id])
  history         LeadStatusHistory[]
  decisionEvents  LeadDecisionEvent[]
  deliveryAttempts LeadDeliveryAttempt[]
  notification    LeadNotification?
  activityEvents  LeadActivityEvent[]
  accessTokens    LeadAccessToken[]
  duplicateOf     Lead? @relation("LeadDuplicates", fields: [duplicateOfId], references: [id])
  duplicates      Lead[] @relation("LeadDuplicates")
  @@index([status, createdAt])
  @@index([processingStatus, createdAt])
  @@index([siteId, phone, createdAt])
  @@index([siteId, reasonCode, createdAt])
  @@index([phone, phoneCheckCheckedAt])
  @@index([processingStatus, phoneCheckNextAttemptAt])
  @@index([siteId, duplicateOfId])
  @@index([createdAt, id])
}

model LeadDecisionEvent {
  id            String   @id @default(cuid())
  leadId        String
  type          String
  outcome       String
  attemptNumber Int?
  actorId       String?
  evidence      Json?
  createdAt     DateTime @default(now())
  lead          Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

model LeadNotification {
  id                String                 @id @default(cuid())
  leadId            String                 @unique
  status            LeadNotificationStatus @default(PENDING)
  revision          Int                    @default(1)
  attempts          Int                    @default(0)
  maxAttempts       Int                    @default(3)
  transport         String?
  errorCode         String?
  httpStatus        Int?
  providerMessageId String?
  queuedAt          DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  lead              Lead                   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([status, updatedAt])
}

model LeadAccessToken {
  id          String   @id @default(cuid())
  leadId      String
  tokenHash   String   @unique
  expiresAt   DateTime
  usedAt      DateTime?
  revokedAt   DateTime?
  createdAt   DateTime @default(now())
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  @@index([leadId, createdAt])
  @@index([expiresAt])
}

model LeadDeliveryAttempt {
  id              String   @id @default(cuid())
  leadId          String
  attemptNumber   Int
  channel         DeliveryChannel
  status          DeliveryAttemptStatus
  idempotencyKey  String
  requestPayload  Json?
  response        Json?
  error           String?
  nextAttemptAt   DateTime?
  createdAt       DateTime @default(now())
  lead            Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  @@unique([leadId, attemptNumber, channel])
  @@index([leadId, createdAt])
}

model LeadActivityEvent {
  id        String   @id @default(cuid())
  leadId    String
  type      String
  data      Json?
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  @@index([leadId, createdAt])
}

model Redirect {
  id          String   @id @default(cuid())
  siteId      String
  cityId      String?
  sourcePath  String
  targetPath  String
  managedTariffId String?
  status      PublishStatus @default(PUBLISHED)
  hitCount    Int      @default(0)
  lastHitAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  city        City?    @relation(fields: [cityId], references: [id], onDelete: SetNull)
  @@unique([siteId, sourcePath])
  @@index([siteId, status])
  @@index([managedTariffId])
}

model LeadStatusHistory {
  id          String   @id @default(cuid())
  leadId      String
  fromStatus  LeadStatus?
  toStatus    LeadStatus
  comment     String?
  actorId     String?
  createdAt   DateTime @default(now())
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  @@index([leadId, createdAt])
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  passwordHash String
  name        String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sessions    Session[]
  contentRevisions ContentRevision[]
  publications SitePublication[]
  publicationValidations SitePublicationValidation[]
  auditEvents AuditEvent[]
  sitemapExclusionsCreated SitemapExclusion[]
  tariffImportsApplied TariffImportRun[] @relation("TariffImportAppliedBy")
  tariffImportsUndone  TariffImportRun[] @relation("TariffImportUndoneBy")
  cityImportsApplied   CityImportRun[]   @relation("CityImportAppliedBy")
  cityImportsUndone    CityImportRun[]   @relation("CityImportUndoneBy")
}

model Session {
  id          String   @id @default(cuid())
  userId      String
  tokenHash   String   @unique
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}
