generator client {
  provider = "prisma-client-js"
  output   = "../packages/database/generated"
}

datasource db {
  provider = "postgresql"
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PageType {
  HOME
  INTERNET
  INTERNET_TV
  TV
  TARIFF
  ADDRESS_CHECK
  FAQ
}

enum ServiceType {
  INTERNET
  INTERNET_TV
  TV
  OTHER
}

enum LeadStatus {
  NEW
  IN_PROGRESS
  CALL_LATER
  CONNECTED
  REJECTED
}

enum AddressCheckStatus {
  AVAILABLE
  UNAVAILABLE
  AMBIGUOUS
  MANUAL_CHECK
  ERROR
}

enum LeadProcessingStatus {
  PENDING
  DELIVERED
  DUPLICATE_SUPPRESSED
  ACTIVE_SUBSCRIBER_NOT_SENT
  MANUAL_CHECK
  ADDRESS_CLARIFICATION
  MANUAL_CHECK_API
  DELIVERY_ERROR_EMAIL_SENT
}

enum DeliveryChannel {
  API
  EMAIL
}

enum DeliveryAttemptStatus {
  SUCCEEDED
  FAILED
  SKIPPED
}

enum UserRole {
  ADMIN
  EDITOR
  TARIFF_MANAGER
  OPERATOR
}

enum TariffImportStatus {
  VALIDATED
  APPLIED
  FAILED
}

model Provider {
  id            String            @id @default(cuid())
  name          String
  slug          String            @unique
  legalData     Json?
  settings      Json?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  sites         Site[]
  tariffs       Tariff[]
  tariffImports TariffImportRun[]
}

model Site {
  id         String         @id @default(cuid())
  providerId String
  name       String
  slug       String         @unique
  domain     String?
  settings   Json?
  status     PublishStatus  @default(DRAFT)
  provider   Provider       @relation(fields: [providerId], references: [id])
  regions    Region[]
  cities     City[]
  pages      Page[]
  leads      Lead[]
  checks     AddressCheck[]
  redirects  Redirect[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

model Region {
  id      String  @id @default(cuid())
  siteId  String
  name    String
  slug    String
  phone   String?
  content Json?
  site    Site    @relation(fields: [siteId], references: [id])
  cities  City[]

  @@unique([siteId, slug])
}

model City {
  id                String         @id @default(cuid())
  siteId            String
  regionId          String
  name              String
  slug              String
  nameInstrumental  String?
  namePrepositional String?
  nameGenitive      String?
  legacyUrl         String?
  officeAddress     String?
  officeHours       String?
  status            PublishStatus  @default(DRAFT)
  phone             String?
  seo               Json?
  content           Json?
  site              Site           @relation(fields: [siteId], references: [id])
  region            Region         @relation(fields: [regionId], references: [id])
  pages             Page[]
  tariffs           Tariff[]
  leads             Lead[]
  checks            AddressCheck[]
  redirects         Redirect[]

  @@unique([siteId, slug])
}

model Page {
  id        String         @id @default(cuid())
  siteId    String
  cityId    String
  type      PageType
  title     String
  slug      String
  status    PublishStatus  @default(DRAFT)
  seo       Json?
  content   Json?
  site      Site           @relation(fields: [siteId], references: [id])
  city      City           @relation(fields: [cityId], references: [id])
  blocks    PageBlock[]
  leads     Lead[]
  checks    AddressCheck[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([cityId, slug])
}

model PageBlock {
  id        String  @id @default(cuid())
  pageId    String
  blockType String
  position  Int
  visible   Boolean @default(true)
  data      Json
  source    String?
  page      Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, position])
}

model Tariff {
  id            String        @id @default(cuid())
  providerId    String
  cityId        String
  name          String
  slug          String
  serviceType   ServiceType
  standardPrice Decimal?      @db.Decimal(10, 2)
  promoPrice    Decimal?      @db.Decimal(10, 2)
  speed         Int?
  promoText     String?
  connectionFee Decimal?      @db.Decimal(10, 2)
  availability  Boolean       @default(true)
  externalId    String?
  identityKey   String?
  dataSource    String?
  attributes    Json?
  seo           Json?
  status        PublishStatus @default(DRAFT)
  provider      Provider      @relation(fields: [providerId], references: [id])
  city          City          @relation(fields: [cityId], references: [id])
  leads         Lead[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([cityId, slug])
  @@unique([cityId, identityKey])
  @@index([cityId, serviceType, status])
  @@index([providerId, externalId])
}

model TariffImportRun {
  id          String             @id @default(cuid())
  providerId  String
  fileName    String
  status      TariffImportStatus @default(VALIDATED)
  totalRows   Int
  validRows   Int
  errorRows   Int
  warningRows Int
  report      Json
  createdAt   DateTime           @default(now())
  appliedAt   DateTime?
  provider    Provider           @relation(fields: [providerId], references: [id])

  @@index([providerId, createdAt])
}

model AddressCheck {
  id          String             @id @default(cuid())
  siteId      String
  cityId      String
  pageId      String?
  address     String
  objectType  String?
  status      AddressCheckStatus
  providerRef String?
  response    Json?
  createdAt   DateTime           @default(now())
  site        Site               @relation(fields: [siteId], references: [id])
  city        City               @relation(fields: [cityId], references: [id])
  page        Page?              @relation(fields: [pageId], references: [id])
  leads       Lead[]

  @@index([cityId, createdAt])
}

model Lead {
  id                String                @id @default(cuid())
  siteId            String
  cityId            String
  pageId            String?
  tariffId          String?
  addressCheckId    String?
  name              String?
  phone             String
  email             String?
  address           String?
  objectType        String?
  serviceType       ServiceType?
  source            String?
  utm               Json?
  referrer          String?
  pageUrl           String?
  formName          String?
  timeOnSiteSeconds Int?
  deviceType        String?
  viewedPages       Json?
  processingStatus  LeadProcessingStatus  @default(PENDING)
  duplicateOfId     String?
  duplicateReason   String?
  deliveryKey       String?               @unique
  externalLeadId    String?
  externalStatus    String?
  contractResult    Json?
  status            LeadStatus            @default(NEW)
  apiResult         Json?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  site              Site                  @relation(fields: [siteId], references: [id])
  city              City                  @relation(fields: [cityId], references: [id])
  page              Page?                 @relation(fields: [pageId], references: [id])
  tariff            Tariff?               @relation(fields: [tariffId], references: [id])
  addressCheck      AddressCheck?         @relation(fields: [addressCheckId], references: [id])
  history           LeadStatusHistory[]
  deliveryAttempts  LeadDeliveryAttempt[]
  activityEvents    LeadActivityEvent[]
  duplicateOf       Lead?                 @relation("LeadDuplicates", fields: [duplicateOfId], references: [id])
  duplicates        Lead[]                @relation("LeadDuplicates")

  @@index([status, createdAt])
  @@index([processingStatus, createdAt])
  @@index([siteId, phone, createdAt])
  @@index([siteId, duplicateOfId])
}

model LeadDeliveryAttempt {
  id             String                @id @default(cuid())
  leadId         String
  attemptNumber  Int
  channel        DeliveryChannel
  status         DeliveryAttemptStatus
  idempotencyKey String
  requestPayload Json?
  response       Json?
  error          String?
  nextAttemptAt  DateTime?
  createdAt      DateTime              @default(now())
  lead           Lead                  @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([leadId, attemptNumber, channel])
  @@index([leadId, createdAt])
}

model LeadActivityEvent {
  id        String   @id @default(cuid())
  leadId    String
  type      String
  data      Json?
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

model Redirect {
  id         String        @id @default(cuid())
  siteId     String
  cityId     String?
  sourcePath String
  targetPath String
  status     PublishStatus @default(PUBLISHED)
  hitCount   Int           @default(0)
  lastHitAt  DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  site       Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  city       City?         @relation(fields: [cityId], references: [id], onDelete: SetNull)

  @@unique([siteId, sourcePath])
  @@index([siteId, status])
}

model LeadStatusHistory {
  id         String      @id @default(cuid())
  leadId     String
  fromStatus LeadStatus?
  toStatus   LeadStatus
  comment    String?
  actorId    String?
  createdAt  DateTime    @default(now())
  lead       Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  role         UserRole
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}
